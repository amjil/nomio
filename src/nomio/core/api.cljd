(ns nomio.core.api
  "App-facing API → Phoenix /api/v1."
  (:require ["dart:convert" :as convert]
            ["dart:async" :as async]
            [clojure.string :as str]
            [nomio.content.document :as doc]
            [nomio.core.http :as http]
            [nomio.state.store :as store]))

(def base-url http/base-url)

(defn- keywordize-enum [x]
  (cond
    (keyword? x) x
    (string? x) (keyword x)
    :else x))

(defn- normalize-tags [tags]
  (mapv (fn [t]
          (cond
            (string? t) t
            (map? t) (or (:slug t) (:name t) "")
            :else (str t)))
        (or tags [])))

(defn- document->api [state]
  (when state
    (convert/jsonDecode (doc/export-json state))))

(defn- document-json 
  "Serialize API/editor document without snake_case mangling."
  [raw]
  (cond
    (nil? raw) nil
    (string? raw) raw
    :else
    (letfn [(walk [v]
              (cond
                (keyword? v) (name v)
                (map? v) (reduce-kv (fn [acc k val]
                                      (assoc acc (if (keyword? k) (name k) (str k))
                                             (walk val)))
                                    {} v)
                (sequential? v) (mapv walk v)
                (dart/is? v dart:core/Map)
                (reduce (fn [acc ^String k]
                          (assoc acc k (walk (get v k))))
                        {}
                        (.-keys v))
                (dart/is? v dart:core/Iterable)
                (mapv walk v)
                :else v))]
      (convert/jsonEncode (walk raw)))))

(defn- document<-api [raw]
  (when raw
    (doc/import-json (document-json raw))))

(defn- normalize-content [c]
  (when c
    (cond-> (-> c
                (update :type keywordize-enum)
                (update :status keywordize-enum)
                (update :visibility keywordize-enum)
                (update :tags normalize-tags))
      (contains? c :document)
      (update :document document<-api))))

(defn- data [res]
  (normalize-content (:data res)))

(defn- data-list [res]
  (let [items (mapv normalize-content (or (:data res) []))]
    (store/remember-titles! items)
    items))

(defn- page-of
  "A window plus the server's own end-of-feed answer. `:has-more` is left out
   when the endpoint sends no meta, so the caller can fall back to guessing."
  [items res]
  (cond-> {:items items}
    (contains? (:meta res) :has-more)
    (assoc :has-more (boolean (get-in res [:meta :has-more])))
    (contains? (:meta res) :total)
    (assoc :total (get-in res [:meta :total]))))

(defn- data-page [res]
  (page-of (data-list res) res))

(defn- ok [x] (async/Future.value x))

(defn init!
  "Restores a stored session and revalidates the token before the UI mounts."
  []
  (-> (store/load-session!)
      (.then (fn [_]
               (if (store/signed-in?)
                 (-> (http/get! "/auth/me")
                     (.then (fn [res]
                              (store/set-session! (:user res)
                                                  (:token @store/session))
                              true))
                     (.catchError (fn [_]
                                    (store/clear-session!)
                                    true)))
                 (ok true))))))

(defn register! [creds]
  (-> (http/post! "/auth/register"
                  {:username (:username creds)
                   :password (:password creds)
                   :display-name (:display-name creds)})
      (.then (fn [res]
               (store/set-session! (:user res) (:token res))
               {:user (:user res) :token (:token res)}))))

(defn login! [creds]
  (-> (http/post! "/auth/login"
                  {:username (:username creds)
                   :password (:password creds)})
      (.then (fn [res]
               (store/set-session! (:user res) (:token res))
               {:user (:user res) :token (:token res)}))))

(defn logout! []
  (let [done (fn [_]
               (store/clear-session!)
               true)]
    (if (store/signed-in?)
      (-> (http/post! "/auth/logout")
          (.then done)
          (.catchError done))
      (ok true))))

(defn list-feed
  ([] (list-feed nil))
  ([opts]
   (-> (http/get! "/contents" (or opts {}))
       (.then data-page))))

(defn list-articles
  ([] (list-articles nil))
  ([opts]
   (-> (http/get! "/contents"
                  (merge {:type "article"} (or opts {})))
       (.then data-page))))

(defn list-questions
  ([] (list-questions nil))
  ([opts]
   (-> (http/get! "/questions" (or opts {}))
       (.then data-page))))

(defn unanswered
  ([] (unanswered nil))
  ([opts] (list-questions (assoc (or opts {}) :unanswered true))))

(defn get-content [id-or-slug]
  (-> (http/get! (str "/contents/" id-or-slug))
      (.then data)))

(defn answers
  ([qid] (answers qid nil))
  ([qid opts]
   (-> (http/get! (str "/questions/" qid "/answers") (or opts {}))
       (.then data-page))))

(defn comments
  ([tt tid] (comments tt tid nil))
  ([tt tid opts]
   (-> (http/get! "/comments"
                  (merge {:target-type (if (keyword? tt) (name tt) (str tt))
                          :target-id tid}
                         (or opts {})))
       (.then (fn [res]
                (cond-> (page-of (or (:data res) []) res)
                  (contains? (:meta res) :comment-total)
                  (assoc :comment-total (get-in res [:meta :comment-total]))))))))

(defn comment-replies
  ([id] (comment-replies id nil))
  ([id opts]
   (-> (http/get! "/comments" (merge {:root-id id} (or opts {})))
       (.then (fn [res]
                (cond-> (page-of (or (:data res) []) res)
                  (contains? (:meta res) :total)
                  (assoc :reply-total (get-in res [:meta :total]))))))))

(defn search
  ([q] (search q nil))
  ([q {:keys [type*] :as opts}]
   (if (str/blank? q)
     (ok {:items [] :has-more false})
     (-> (http/get! "/search"
                    (cond-> (merge {:q q} (dissoc opts :type*))
                      type* (assoc :type (name type*))))
         (.then data-page)))))

(defn tags
  ([] (tags nil))
  ([opts]
   (-> (http/get! "/tags" (or opts {}))
       ;; Tags are not content, so they skip normalize-content.
       (.then (fn [res] (page-of (or (:data res) []) res))))))

(defn by-tag
  ([slug] (by-tag slug nil))
  ([slug opts]
   (-> (http/get! (str "/tags/" slug) (or opts {}))
       (.then data-page))))

(defn profile [username]
  (-> (http/get! (str "/users/" username))
      (.then (fn [res] {:user (:user res)}))))

(defn update-me!
  "PATCH /auth/me. Updates the stored session user on success."
  [attrs]
  (-> (http/patch! "/auth/me" attrs)
      (.then (fn [res]
               (let [u (:user res)]
                 (store/set-session! u (:token @store/session))
                 u)))))

(defn followers
  ([user-id] (followers user-id nil))
  ([user-id opts]
   (-> (http/get! (str "/users/" user-id "/followers") (or opts {}))
       (.then (fn [res] (page-of (or (:data res) []) res))))))

(defn following-users
  ([user-id] (following-users user-id nil))
  ([user-id opts]
   (-> (http/get! (str "/users/" user-id "/following") (or opts {}))
       (.then (fn [res] (page-of (or (:data res) []) res))))))

(defn mine
  ([] (mine nil))
  ([opts]
   (-> (http/get! "/me/contents" (or opts {}))
       (.then data-page))))

(defn following-feed
  ([] (following-feed nil))
  ([opts]
   (-> (http/get! "/me/feed" (or opts {}))
       (.then data-page))))

(defn create-content!
  [{:keys [type* title document tags question-id]}]
  (let [body (cond-> {:type (name (or type* :article))
                      :title (or title "")}
               document (assoc :document (document->api document))
               tags (assoc :tags tags)
               question-id (assoc :question-id question-id))
        path (if (and (= type* :answer) question-id)
               (str "/questions/" question-id "/answers")
               (if (= type* :question) "/questions" "/contents"))]
    (-> (http/post! path body)
        (.then data))))

(defn save-draft!
  [id {:keys [title document tags]}]
  (let [body (cond-> {}
               (some? title) (assoc :title title)
               (some? document) (assoc :document (document->api document))
               (some? tags) (assoc :tags tags))]
    (-> (http/patch! (str "/contents/" id) body)
        (.then data))))

(defn publish! [id]
  (-> (http/post! (str "/contents/" id "/publish"))
      (.then data)))

(defn unpublish! [id]
  (-> (http/post! (str "/contents/" id "/unpublish"))
      (.then data)))

(defn archive! [id]
  (-> (http/post! (str "/contents/" id "/archive"))
      (.then data)))

(defn create-comment!
  [{:keys [target-type target-id parent-id content content-spans]}]
  (-> (http/post! "/comments"
                  (cond-> {:target-type (if (keyword? target-type)
                                          (name target-type)
                                          (str target-type))
                           :target-id target-id
                           :content content
                           :content-spans (or content-spans [])}
                    parent-id (assoc :parent-id parent-id)))
      (.then (fn [res] (:data res)))))

(defn update-comment!
  [id {:keys [content content-spans]}]
  (-> (http/patch! (str "/comments/" id)
                   (cond-> {:content content}
                     (some? content-spans) (assoc :content-spans content-spans)))
      (.then (fn [res] (:data res)))))

(defn delete-comment! [id]
  (-> (http/delete! (str "/comments/" id))
      (.then (fn [res] (boolean (:ok res))))))

(defn toggle-bookmark! [id]
  (-> (http/post! (str "/contents/" id "/bookmark/toggle"))
      (.then (fn [res] (boolean (:bookmarked res))))))

(defn bookmarked? [c]
  (boolean (or (:bookmarked c) false)))

(defn bookmarks
  ([] (bookmarks nil))
  ([opts]
   (-> (http/get! "/bookmarks" (or opts {}))
       (.then data-page))))

(defn toggle-like! [id liked?]
  (if liked?
    (-> (http/delete! (str "/contents/" id "/like"))
        (.then (fn [res] res)))
    (-> (http/post! (str "/contents/" id "/like"))
        (.then (fn [res] res)))))

(defn vote! [answer-id value]
  (-> (http/post! (str "/answers/" answer-id "/vote") {:value value})
      (.then identity)))

(defn unvote! [answer-id]
  (-> (http/delete! (str "/answers/" answer-id "/vote"))
      (.then identity)))

(defn follow! [user-id]
  (-> (http/post! (str "/users/" user-id "/follow"))
      (.then identity)))

(defn unfollow! [user-id]
  (-> (http/delete! (str "/users/" user-id "/follow"))
      (.then identity)))

(defn notifications
  ([] (notifications nil))
  ([opts]
   (-> (http/get! "/notifications" (or opts {}))
       (.then (fn [res]
                (-> (page-of (or (:data res) []) res)
                    (assoc :unread-count (or (:unread-count res) 0))))))))

(defn mark-notification-read! [id]
  (-> (http/post! (str "/notifications/" id "/read"))
      (.then (fn [res] (:data res)))))

(defn mark-all-notifications-read! []
  (-> (http/post! "/notifications/read-all")
      (.then identity)))

(defn upload-asset! [file-path]
  (-> (http/upload! file-path)
      (.then (fn [res] (:data res)))))
