        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

;; =============================================================================
;; 5. Media Uploads
;; =============================================================================

(defn ^:async upload-image
  "Uploads an image file using multipart/form-data. Requires Token."
  [^String file-path]
  (let [uri (Uri/parse (str base-url "/uploads/images"))
        req (http/MultipartRequest. "POST" uri)
        file (await (http/MultipartFile.fromPath "file" file-path))
        token (state/current-token)]
    
    (when (not (str/blank? token))
      (.addAll (.-headers req) {"Authorization" (str "Bearer " token)}))

    (.add (.-files req) file)

    (let [resp-stream (await (.send req))
          resp-str (await (.bytesToString resp-stream))
          body (convert/jsonDecode resp-str)]
      (if (= (.-statusCode resp-stream) 200)
        (get-in body ["data" "url"] (get body "url"))
        (throw (Exception. (str "Image upload failed: " resp-str)))))))

;; =============================================================================
;; 6. Topic Exploration
;; =============================================================================

(defn ^:async fetch-topic-posts
  "Fetches posts tagged with a specific topic."
  [tag & {:keys [page limit] :or {page 1 limit 10}}]
  (let [encoded-tag (Uri/encodeComponent tag)
        uri (Uri/parse (str base-url "/posts?tag=" encoded-tag "&page=" page "&limit=" limit))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async search-posts
  "Searches posts by a keyword query."
  [q & {:keys [page limit] :or {page 1 limit 10}}]
  (let [encoded-q (Uri/encodeComponent q)
        uri (Uri/parse (str base-url "/search/posts?q=" encoded-q "&page=" page "&limit=" limit))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async search-blocks
  "Searches blocks by a keyword query."
  [q & {:keys [page limit] :or {page 1 limit 20}}]
  (let [encoded-q (Uri/encodeComponent q)
        uri (Uri/parse (str base-url "/search/blocks?q=" encoded-q "&page=" page "&limit=" limit))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async fetch-hot-tags
  "Fetches the list of trending tags from the server."
  [& {:keys [limit] :or {limit 10}}]
  (let [uri (Uri/parse (str base-url "/tags/hot?limit=" limit))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

;; =============================================================================
;; 7. PKM & Spaced Repetition System (Readwise Features)
;; =============================================================================

(defn ^:async fetch-highlights
  "Fetches highlights created by the user, supporting optional filters."
  [& {:keys [source-type source-ref page limit] :or {page 1 limit 20}}]
  (let [query-params (cond-> []
                       source-type (conj (str "source_type=" (Uri/encodeComponent source-type)))
                       source-ref  (conj (str "source_ref=" (Uri/encodeComponent source-ref)))
                       true        (conj (str "page=" page))
                       true        (conj (str "limit=" limit)))
        query-str (str/join "&" query-params)
        uri (Uri/parse (str base-url "/highlights?" query-str))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async fetch-highlight
  "Fetches a single highlight by its UUID."
  [highlight-id]
  (let [uri (Uri/parse (str base-url "/highlights/" highlight-id))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async create-highlight
  "Creates a new highlight. If enqueue-srs is true, it automatically starts the review lifecycle."
  [payload]
  (let [uri (Uri/parse (str base-url "/highlights"))
        api-payload {"content"      (or (:content payload) (get payload "content"))
                     "source_type"  (or (:source-type payload) (get payload "source_type"))
                     "source_ref"   (or (:source-ref payload) (get payload "source_ref"))
                     "note"         (or (:note payload) (get payload "note"))
                     "context_data" (or (:context-data payload) (get payload "context_data") {})
                     "enqueue_srs"  (or (:enqueue-srs payload) (get payload "enqueue_srs") false)}
        body (convert/jsonEncode api-payload)
        resp (await (http/post uri .headers (get-auth-headers) .body body))]
    (parse-response resp)))

(defn ^:async update-highlight
  "Updates the static textual content of an existing highlight."
  [highlight-id payload]
  (let [uri (Uri/parse (str base-url "/highlights/" highlight-id))
        api-payload {"content"      (or (:content payload) (get payload "content"))
                     "note"         (or (:note payload) (get payload "note"))
                     "source_ref"   (or (:source-ref payload) (get payload "source_ref"))
                     "context_data" (or (:context-data payload) (get payload "context_data") {})}
        body (convert/jsonEncode api-payload)
        resp (await (http/put uri .headers (get-auth-headers) .body body))]
    (parse-response resp)))

(defn ^:async delete-highlight
  "Deletes a highlight. Cascades to delete associated SRS items and review logs."
  [highlight-id]
  (let [uri (Uri/parse (str base-url "/highlights/" highlight-id))
        resp (await (http/delete uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async fetch-due-reviews
  "Fetches the queue of SRS items that are due for review today.
   Returns `{:data [...] :meta {:due_count N}}` so callers can read meta.due_count."
  [& {:keys [limit include-new] :or {limit 50 include-new true}}]
  (let [uri (Uri/parse (str base-url "/reviews/due?limit=" limit "&include_new=" include-new))
        resp (await (http/get uri .headers (get-auth-headers)))
        status (.-statusCode resp)
        body-str (.-body resp)
        json-data (try
                    (if (str/blank? body-str) {} (convert/jsonDecode body-str))
                    (catch Exception _ {}))]
    (if (and (>= status 200) (< status 300))
      {"data" (get json-data "data" [])
       "meta" (get json-data "meta" {})}
      (let [err-type (get json-data "error")
            details (get json-data "details")
            detail-str (when details
                         (str/join "\n"
                                   (for [k (.-keys details)]
                                     (let [v (get details k)
                                           err-val (if (coll? v) (first v) v)]
                                       (str k ": " err-val)))))
            error-msg (cond
                        (not (str/blank? detail-str)) detail-str
                        (not (str/blank? err-type)) err-type
                        :else (str "API Error (" status ")"))]
        (throw (Exception. error-msg))))))

(defn ^:async enqueue-srs
  "Manually pushes an existing highlight into the Spaced Repetition System."
  [highlight-id]
  (let [uri (Uri/parse (str base-url "/highlights/" highlight-id "/srs"))
        resp (await (http/post uri .headers (get-auth-headers)))]
    (parse-response resp)))

(defn ^:async submit-review
  "Submits SM-2 review feedback. Grade must be 1 (Again), 2 (Hard), 3 (Good), or 4 (Easy)."
  [srs-item-id grade & {:keys [duration-ms]}]
  (let [uri (Uri/parse (str base-url "/srs_items/" srs-item-id "/reviews"))
        api-payload (cond-> {"grade" grade}
                      duration-ms (assoc "duration_ms" duration-ms))
        body (convert/jsonEncode api-payload)
        resp (await (http/post uri .headers (get-auth-headers) .body body))]
    (parse-response resp)))

(defn ^:async update-srs-status
  "Manually updates the SRS item status (e.g., suspending an item)."
  [srs-item-id status]
  (let [uri (Uri/parse (str base-url "/srs_items/" srs-item-id))
        body (convert/jsonEncode {"status" status})
        resp (await (http/patch uri .headers (get-auth-headers) .body body))]
    (parse-response resp)))

(defn ^:async fetch-review-logs
  "Retrieves the immutable review history for a specific SRS item."
  [srs-item-id & {:keys [page limit] :or {page 1 limit 50}}]
  (let [uri (Uri/parse (str base-url "/srs_items/" srs-item-id "/review_logs?page=" page "&limit=" limit))
        resp (await (http/get uri .headers (get-auth-headers)))]
    (parse-response resp)))

