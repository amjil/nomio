(ns nomio.utils.tokens
  "Global design tokens and theme configuration for the Nomio dark design system.
   Defines core colors, typography, and standard widget styles."
  (:require ["package:flutter/material.dart" :as m]))

;; =============================================================================
;; Color Palette (Dark / Black)
;; =============================================================================

(def bg-color (m/Color 0xFF0A0A0A))       ; Near-black background
(def surface-color (m/Color 0xFF1A1A1A))  ; Elevated card surface
(def primary-color (m/Color 0xFF4FA5E6))  ; Tenger Blue accent
(def primary-container (m/Color 0xFF1A3147)) ; Dark blue container
(def text-primary (m/Color 0xFFF0F4F8))   ; Light text for readability
(def text-secondary (m/Color 0xFF94A3B8)) ; Muted slate for metadata

;; SRS Semantic Colors
(def srs-again (m/Color 0xFFFF7676))
(def srs-again-bg (m/Color 0xFF3D2020))
(def srs-hard (m/Color 0xFFFFA726))
(def srs-hard-bg (m/Color 0xFF3D3020))
(def srs-good primary-color)
(def srs-good-bg primary-container)
(def srs-easy (m/Color 0xFF66BB6A))
(def srs-easy-bg (m/Color 0xFF1A3D1F))

;; =============================================================================
;; Shadows & Shapes
;; =============================================================================

(def tenger-shadow
  "A soft shadow to lift cards on dark backgrounds."
  [(m/BoxShadow
    .color (.withOpacity m.Colors/black 0.4)
    .blurRadius 20.0
    .offset (m/Offset 0.0 8.0))])

(def card-shape
  "Standard 16px rounded corners with a subtle primary-tinted border."
  (m/RoundedRectangleBorder
   .borderRadius (m/BorderRadius.circular 16.0)
   .side (m/BorderSide .color (.withOpacity primary-color 0.2) .width 1.0)))

;; =============================================================================
;; Global Theme
;; =============================================================================

(def tenger-theme
  (m/ThemeData
   .brightness m.Brightness/dark
   .scaffoldBackgroundColor bg-color
   .primaryColor primary-color
   .colorScheme (m/ColorScheme.dark
                 .primary primary-color
                 .primaryContainer primary-container
                 .surface surface-color
                 .onSurface text-primary
                 .onSurfaceVariant text-secondary
                 .error srs-again
                 .background bg-color)
   ;; 🌟 FIX: Updated to CardThemeData to support Flutter 3.27+ Material API changes
   .cardTheme (m/CardThemeData
               .color surface-color
               .elevation 0.0
               .shape card-shape)
   ;; 🌟 FIX: Updated to AppBarThemeData to support Flutter 3.27+ Material API changes
   .appBarTheme (m/AppBarThemeData
                 .backgroundColor m.Colors/transparent
                 .elevation 0.0
                 .centerTitle false
                 .iconTheme (m/IconThemeData .color primary-color)
                 .titleTextStyle (m/TextStyle .color text-primary
                                              .fontFamily "OyunQaganTig"
                                              .fontSize 20.0
                                              .fontWeight m.FontWeight/bold))))