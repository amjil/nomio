(ns nomio.utils.platform
  "Utility functions for platform detection in Flutter/ClojureDart.
   Uses flutter/foundation to safely handle Web compilation without dart:io crashes."
  (:require
   ["package:flutter/foundation.dart" :as foundation]))

;; =============================================================================
;; Core Flags
;; =============================================================================

;; True if the application is compiled and running on the web browser.
(def is-web? foundation/kIsWeb)

;; =============================================================================
;; Specific OS Detection (Safe for Web)
;; =============================================================================

(def is-android? 
  (identical? foundation/defaultTargetPlatform foundation.TargetPlatform/android))

(def is-ios? 
  (identical? foundation/defaultTargetPlatform foundation.TargetPlatform/iOS))

(def is-macos? 
  (identical? foundation/defaultTargetPlatform foundation.TargetPlatform/macOS))

(def is-windows? 
  (identical? foundation/defaultTargetPlatform foundation.TargetPlatform/windows))

(def is-linux? 
  (identical? foundation/defaultTargetPlatform foundation.TargetPlatform/linux))

;; =============================================================================
;; Device Categories
;; =============================================================================

(def is-mobile? 
  (or is-android? is-ios?))

(def is-desktop? 
  (or is-macos? is-windows? is-linux?))

;; =============================================================================
;; Feature Flags
;; =============================================================================

(defn use-virtual-keyboard?
  "Determines whether the app should mount the custom Mongolian virtual keyboard.
   Returns true on mobile platforms where native vertical script input is limited.
   Returns false on desktop or web where physical keyboards are typically used."
  []
  is-mobile?)