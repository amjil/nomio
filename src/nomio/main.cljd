(ns nomio.main
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/foundation.dart" :as foundation :refer [kIsWeb]]
            ["package:flutter_styled_toast/flutter_styled_toast.dart" :as st]
            [cljd.flutter :as f]
            [ime-core.remote-api :as remote]
            [nomio.platform :as platform]
            [nomio.bootstrap.desktop :as desktop-boot]
            [nomio.bootstrap.mobile :as mobile-boot]
            [nomio.core.api :as api]
            [nomio.core.router :as router]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.toast :as toast]))

(defn main []
  (m/WidgetsFlutterBinding.ensureInitialized)

  (when kIsWeb 
    (remote/set-config! {:base-url "localhost:3003"
                       :candidate-api-path "/api/next_word/candidates"
                       :next-word-api-path "/api/next_word/list"}))

  (try
    (if (platform/desktop?)
      (await (desktop-boot/init!))
      (await (mobile-boot/init!)))
    (catch Exception e
      (dart:core/print (str "bootstrap failed: " e))))

  (try
    (await (api/init!))
    (catch Exception e
      (dart:core/print (str "session init failed: " e))))

  (f/run
   (m/MaterialApp
    .navigatorKey store/nav-key
    .title "Nomio"
    .debugShowCheckedModeBanner false
    .theme (theme/app-theme)
    .darkTheme (theme/app-theme)
    .themeMode m.ThemeMode/dark
    .builder
    (fn [_ctx child]
      (st/StyledToast
       .child
       (f/widget
        :context host-ctx
        (do
          (toast/remember-root-ctx! host-ctx)
          (or child (m/SizedBox.shrink))))))
    .initialRoute "/"
    .onGenerateRoute
    (fn [^m/RouteSettings settings]
      (router/generate-route settings)))))
