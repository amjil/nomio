(ns nomio.pages.notifications
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.sign-in :as sign-in]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(defn- open-note!
  "Marking read is best-effort — the reader is already on their way to the
   target, so a failure here is not worth interrupting them with. It still has
   to be caught, or the rejected future surfaces as an unhandled error."
  [n on-read]
  (when-let [href (:href n)]
    (store/push-named! href))
  (when (and (:id n) (nil? (:read-at n)))
    (-> (api/mark-notification-read! (:id n))
        (.then (fn [updated] (when updated (on-read updated)) nil))
        (.catchError (fn [_] nil))))
  nil)

(def ^:private kind-icons
  {"like" m.Icons/favorite_rounded
   "follow" m.Icons/person_add_alt_1_rounded
   "comment" m.Icons/mode_comment_outlined
   "answer" m.Icons/forum_outlined
   "mention" m.Icons/alternate_email_rounded})

(defn- note-card [on-read n]
  (let [unread? (nil? (:read-at n))
        actor (or (get-in n [:actor :display-name])
                  (get-in n [:actor :username])
                  "")
        excerpt (or (:excerpt n) "")]
    (ui/panel
     {:width 250.0
      :margin (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 14.0)
      :pad 18.0
      :radius theme/radius-lg
      :color (if unread? theme/surface-alt theme/surface)
      :border (if unread? theme/divider-strong theme/divider)
      :shadow (when unread? theme/soft-shadow)
      :on-tap #(open-note! n on-read)}
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(ui/spine (if unread? theme/accent theme/divider))
       (ui/gap-h 14)
       (ui/top
        (m/Icon (get kind-icons (:type n) m.Icons/notifications_none)
                .size 17.0
                .color (if unread? theme/accent theme/ink-faint)))
       (ui/gap-h 12)
       (m/Expanded
        .flex 3
        .child (mg/text (or (:title n) (:type n) "")
                        {:size 15.5
                         :weight (if unread? m.FontWeight/w700 m.FontWeight/w500)
                         :height 1.2
                         :max-lines 3}))
       (if (empty? excerpt) ui/nothing (ui/gap-h 8))
       (if (empty? excerpt)
         ui/nothing
         (m/Expanded
          .flex 2
          .child (mg/text excerpt {:size 13.0 :color theme/ink-faint
                                   :height 1.3 :max-lines 2})))
       (if (empty? actor) ui/nothing (ui/gap-h 12))
       (if (empty? actor)
         ui/nothing
         (m/SizedBox
          .width 30.0
          .child
          (m/Column
           .crossAxisAlignment m.CrossAxisAlignment/start
           .children
           [(ui/avatar (or (:actor n) actor) 26.0)
            (ui/gap-v 10)
            (m/Flexible .child (mg/muted actor))])))]))))

(defn- mark-all! [ctx reload!]
  (-> (api/mark-all-notifications-read!)
      (.then (fn [_]
               (when (.-mounted ^m/BuildContext ctx)
                 (reload!)
                 (toast/success! ctx "Marked as read"))
               nil))
      (.catchError (fn [e]
                     (when (.-mounted ^m/BuildContext ctx)
                       (toast/error! ctx e))
                     nil)))
  nil)

(defn- aside [ctx unread reload!]
  (ui/page-header
   {:title "Notifications"
    :icon m.Icons/notifications_rounded
    :subtitle (if (pos? unread) (str unread " unread") "All caught up")
    :on-refresh reload!
    :extra (when (pos? unread)
             (ui/ghost-action {:label "Read all"
                               :icon m.Icons/done_all_rounded
                               :tone theme/accent
                               :on-tap #(mark-all! ctx reload!)}))}))

(defn- swap-note
  "Drops the server's updated copy in place rather than refetching the list, so
   the card the reader just tapped dims without the strip flickering."
  [items updated]
  (mapv #(if (= (:id %) (:id updated)) updated %) items))

(defn- signed-in-page []
  (f/widget
   :context ctx
   :let [!st (paged/state)
         !unread (atom 0)
         fetch (fn [opts]
                 (-> (api/notifications opts)
                     (.then (fn [page]
                              (when (.-mounted ^m/BuildContext ctx)
                                (reset! !unread (or (:unread-count page) 0)))
                              page))))
         reload! (fn [] (paged/reload! ctx !st fetch) nil)
         on-read (fn [updated]
                   (swap! !st update :items swap-note updated)
                   (swap! !unread #(max 0 (dec (or % 0))))
                   nil)
         _ (paged/load-more! ctx !st fetch)]
   :watch [unread !unread]
   (paged/section (aside ctx unread reload!)
                  !st fetch #(note-card on-read %))))

(defn page []
  (f/widget
   :watch [{:keys [user]} store/session]
   (if-not user
     (sign-in/prompt "Sign in to see notifications")
     (signed-in-page))))
