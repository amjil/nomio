(ns nomio.pages.search
  (:require ["package:flutter/material.dart" :as m]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [nomio.core.api :as api]
            [nomio.platform :as platform]
            [nomio.theme :as theme]
            [nomio.widgets.content-card :as cards]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.ui :as ui]
            [rich-editor.components.text-field :as custom-tf]))

(defonce ^:private !ime (atom {:external-keyboard-delegate nil}))

;; Hot-reload alias: StatefulWidget watchers keep the previous build's
;; schedule! closure, which still looks up this versioned getter.
(defonce ^{:dart/name debounce$v11} debounce$v11
  (dart:core/Duration. .milliseconds 250))

(defn- cancel-timer-atom! [!t]
  (when-let [t @!t] (.cancel ^async/Timer t))
  nil)

(defn- schedule-search! [!timer run! v]
  (when-let [t @!timer] (.cancel ^async/Timer t))
  (reset! !timer
          (async/Timer. (dart:core/Duration. .milliseconds 250)
                        #(run! v)))
  nil)

(defn- field-box [query ctrl focus schedule! clear!]
  (ui/input-panel
   {:icon m.Icons/search_rounded}
   (m/Column
    .crossAxisAlignment m.CrossAxisAlignment/center
    .children
    [(m/Expanded
      .child
      (custom-tf/text-field
       !ime
       {:controller ctrl
        :focus-node focus
        :hint "Search"
        :max-lines 1
        :on-changed (fn [v] (schedule! (or v "")))
        :style (m/TextStyle .color theme/ink .fontFamily theme/font-family)
        :decoration (m/InputDecoration .border m/InputBorder.none)}))
     (if (str/blank? query)
       ui/nothing
       (ui/icon-button {:icon m.Icons/close_rounded
                        :on-tap clear!
                        :size 30.0}))])))

(defn- page-aside []
  (m/Padding
   .padding (m.EdgeInsets/fromLTRB 20.0 24.0 6.0 24.0)
   .child (ui/page-header {:title "Search"
                           :icon m.Icons/search_rounded
                           :subtitle "Titles, bodies and tags"})))

(defn- results-pane [query !results fetch]
  (m/Expanded
   .child
   (if (str/blank? query)
     (ui/state-view {:icon m.Icons/manage_search_rounded
                     :title "Type to search"
                     :message "Articles, questions and answers"})
     (paged/strip !results fetch cards/card))))

(defn- field-and-results [query ctrl focus schedule! clear! !results fetch]
  (m/Row
   .crossAxisAlignment m.CrossAxisAlignment/stretch
   .children
   [(field-box query ctrl focus schedule! clear!)
    (results-pane query !results fetch)]))

(defn page []
  (f/widget
   :context ctx
   :let [!query (atom "")
         !results (paged/state)
         !timer (atom nil)]
   :managed [_ime-control (kb/install)
             :dispose kb/restore-ime!
             ctrl (m/TextEditingController.)
             focus (m/FocusNode.)
             _ !timer :dispose cancel-timer-atom!]

   :let [;; Reading the query from the atom keeps this function identity stable
         ;; for the strip's scroll listener, and paged's generation counter is
         ;; what stops a slow reply to an earlier query from landing late.
         fetch (fn [opts] (api/search @!query opts))

         run! (fn [q]
                (reset! !query q)
                (if (str/blank? q)
                  (paged/clear! !results)
                  (paged/reload! ctx !results fetch))
                nil)

         schedule! (fn [v] (schedule-search! !timer run! v))]

   ;; IME writes the controller directly and skips MongolTextField.onChanged.
   :bg-watcher ([^m/TextEditingValue {v .-text} ctrl]
                (schedule-search! !timer run! (or v "")))
   :watch [query !query]
   :let [clear! (fn []
                  (kb/dismiss!)
                  (.clear ctrl)
                  (run! "")
                  (.requestFocus focus)
                  nil)
         fields (field-and-results query ctrl focus schedule! clear! !results fetch)]
   ;; Own Scaffold so the IME overlay Stack fills the content pane.
   ;; Desktop: header stays outside kb/wrap so the overlay origin sits on the
   ;; field — candidates-overlay uses Stack-local Positioned (fallback ~100,100).
   ;; Mobile: wrap the whole row so the virtual-keyboard bar stays full width.
   (m/Scaffold
    .backgroundColor theme/transparent
    .resizeToAvoidBottomInset false
    .body
    (m/SafeArea
     .child
     (if (platform/desktop?)
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        [(page-aside)
         (m/Expanded .child (kb/wrap fields))])
       (kb/wrap
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/stretch
         .children
         [(page-aside)
          (m/Expanded .child fields)])))))))
