(ns nomio.pages.desktop.shell
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.side-nav :as side-nav]))

(defn desktop-shell [body-for]
  (f/widget
   ;; Subscribing to the whole app-ui atom would rebuild the shell whenever an
   ;; unrelated key (explore tab, question filter) changes.
   :watch [nav-id (f/sub store/app-ui :selected-nav-id)]
   (m/Scaffold
    .backgroundColor theme/bg
    .body
    (m/Row
     .children
     [(side-nav/rail)
      (m/VerticalDivider .width 1.0 .thickness 1.0 .color theme/divider)
      (m/Expanded
       .child
       (m/AnimatedSwitcher
        .duration (dart:core/Duration. .milliseconds 200)
        .child
        (m/KeyedSubtree
         .key (m/ValueKey nav-id)
         .child (body-for nav-id))))]))))
