(ns nomio.pages.question
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.content.reader :as nreader]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.comments :as comments]
            [nomio.widgets.content-card :as cards]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.reader-frame :as frame]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(defn- write-answer! [ctx q]
  (store/require-auth!
   (fn []
     (-> (api/create-content! {:type* :answer
                               :title (str "A: " (:title q))
                               :question-id (:id q)})
         (.then (fn [a]
                  (when (.-mounted ^m/BuildContext ctx)
                    (store/push-named! (str "/content/" (:id a) "/edit")))
                  nil))
         (.catchError (fn [e]
                        (when (.-mounted ^m/BuildContext ctx)
                          (toast/error! ctx e))
                        nil)))))
  nil)

(defn- toggle-like! [ctx !q content liked?]
  (store/require-auth!
   (fn []
     (-> (api/toggle-like! (:id content) liked?)
         (.then (fn [res]
                  (when (.-mounted ^m/BuildContext ctx)
                    (swap! !q assoc
                           :liked (:liked res)
                           :like-count (:like-count res)))
                  nil))
         (.catchError (fn [e]
                        (when (.-mounted ^m/BuildContext ctx)
                          (toast/error! ctx e))
                        nil)))))
  nil)

(defn- screen* [q]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [_ime-control (kb/install)
             :dispose kb/restore-ime!]
   :let [!q (atom q)
         ;; The endpoint windows at 20, so a popular question needs paging or
         ;; its later answers simply never appear.
         answers-fetch (fn [opts] (api/answers (:id q) opts))
         !answers (paged/state)
         _ (paged/load-more! ctx !answers answers-fetch)
         !comments (asy/load! ctx (api/comments "question" (:id q)))
         !reply (atom nil)]
   :watch [content !q]
   (let [mine? (= (:id (store/current-user)) (:author-id content))
         liked? (boolean (:liked content))]
     (m/Scaffold
      .backgroundColor theme/bg
      .resizeToAvoidBottomInset false
      .body
      (ui/backdrop
       (m/SafeArea
        .child
        (kb/wrap
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/stretch
          .children
          [(frame/meta-aside
            {:content content
             :on-back #(.pop navigator)
             :on-tag #(store/push-named! (str "/tags/" (first (:tags content))))
             :actions
             [(when mine?
                {:icon m.Icons/edit_outlined
                 :on-tap #(store/push-named! (str "/content/" (:id content) "/edit"))})
              {:icon (if liked? m.Icons/favorite_rounded m.Icons/favorite_border)
               :active? liked?
               :on-tap #(toggle-like! ctx !q content liked?)}]
             :extra (ui/action {:label "Answer"
                                :icon m.Icons/reply_rounded
                                :tone theme/gold
                                :on-tap #(write-answer! ctx content)})})

           (m/Expanded
            .flex 3
            .child (frame/paper (nreader/widget (:document content))))

           (m/Expanded
            .flex 2
            .child (frame/pane {:label "Answers" :icon m.Icons/forum_outlined}
                               (paged/strip !answers answers-fetch cards/card)))

           (m/Expanded
            .flex 2
            .child
            (frame/comments-pane
             (asy/view !comments
                       #(comments/tree % (fn [pid] (reset! !reply pid) nil)))
             (comments/composer
              :question (:id content)
              :!reply-to !reply
              :on-posted (fn []
                           (asy/load! ctx !comments (api/comments "question" (:id content)))
                           nil))))]))))))))

(defn screen [slug]
  (f/widget
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (asy/load! ctx !st (api/get-content slug)) nil)
         _ (reload!)]
   (asy/screen !st screen* :retry reload!)))
