(ns nomio.pages.question
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.content.reader :as nreader]
            [nomio.core.api :as api]
            [nomio.platform :as platform]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.comments :as comments]
            [nomio.widgets.content-card :as cards]
            [nomio.widgets.engage :as engage]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.reader-frame :as frame]
            [nomio.widgets.related :as related]
            [nomio.widgets.ui :as ui]))

(defn- write-answer! [q]
  (store/require-auth!
   (fn []
     (store/push-named! (str "/questions/" (:id q) "/answer"))))
  nil)

(defn- answers-rail [st on-open]
  (m/Container
   .decoration (m/BoxDecoration
                .border (m/Border .left (m/BorderSide .color theme/divider .width 1.0)))
   .child
   (m/Padding
    .padding (m.EdgeInsets/fromLTRB 10.0 18.0 10.0 18.0)
    .child
    (ui/tappable
     on-open theme/radius-sm
     (m/Padding
      .padding (m.EdgeInsets/symmetric .horizontal 4.0 .vertical 6.0)
      .child
      (m/Column
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/center
       .children
       [(m/Icon m.Icons/forum_outlined .size 15.0 .color theme/ink-faint)
        (ui/gap-v 10)
        (mg/label "Answers")
        (ui/gap-v 10)
        (mg/text (str (or (:total st) (count (:items st)) 0))
                 {:size 13.0 :color theme/ink-muted :weight m.FontWeight/w600})]))))))

(defn- answers-column [!answers fetch !open on-open]
  (f/widget
   :watch [open? !open
           st !answers]
   (if-not open?
     (answers-rail st (fn []
                        (when on-open (on-open))
                        (reset! !open true)
                        nil))
     (m/Expanded
      .flex 2
      .child
      (frame/pane
       {:label "Answers" :icon m.Icons/forum_outlined}
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        [(m/Expanded .child (paged/strip !answers fetch cards/card))
         (m/Padding
          .padding (m.EdgeInsets/only .left 4.0 .right 8.0 .top 12.0 .bottom 12.0)
          .child
          (ui/icon-button {:icon m.Icons/close_rounded
                           :size 32.0
                           :on-tap #(reset! !open false)}))]))))))

(defn- screen* [q]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [_ime-control (kb/install)
             :dispose kb/restore-ime!]
   :let [!q (atom q)
         answers-fetch (fn [opts] (api/answers (:id q) opts))
         !answers (paged/state)
         !answers-open (atom (not (platform/mobile?)))
         !comments-open (atom false)
         phone? (platform/mobile?)
         _ (paged/load-more! ctx !answers answers-fetch)
         paper (nreader/widget (:document q))]
   :watch [content !q]
   (let [mine? (= (:id (store/current-user)) (:author-id content))]
     (m/Scaffold
      .backgroundColor theme/bg
      .resizeToAvoidBottomInset false
      .body
      (ui/backdrop
       (m/SafeArea
        .child
        (kb/wrap
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/stretch
          .children
          [(frame/meta-aside
            {:content content
             :on-back #(.pop navigator)
             :actions
             (into [(when mine?
                      {:icon m.Icons/edit_outlined
                       :on-tap #(store/push-named! (str "/content/" (:id content) "/edit"))})
                    (engage/like-action ctx !q)]
                   (engage/owner-status-actions ctx content))
             :extra (ui/action {:label "Answer"
                                :icon m.Icons/reply_rounded
                                :tone theme/gold
                                :on-tap #(write-answer! content)})})

           (m/Expanded
            .flex 3
            .child (frame/paper paper :title (:title q)))

           (answers-column !answers answers-fetch !answers-open
                           (when phone? #(reset! !comments-open false)))

           (comments/column "question" (:id content)
                            :open-atom !comments-open
                            :on-open (when phone? #(reset! !answers-open false)))
           (related/column content)]))))))))

(defn screen [slug]
  (f/widget
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (asy/load! ctx !st (api/get-content slug)) nil)
         _ (reload!)]
   (asy/screen !st screen* :retry reload!)))
