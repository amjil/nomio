(ns nomio.pages.auth
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [nomio.core.api :as api]
            [nomio.theme :as theme]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]
            [rich-editor.components.text-field :as custom-tf]))

(defonce ^:private !ime (atom {:external-keyboard-delegate nil}))

;; The card is bounded so the vertical text field has a height to fill. Left
;; loose inside a Center it would stretch to the whole window.
(def ^:private card-height 430.0)

(defn- field [ctrl focus hint icon obscure?]
  (ui/panel
   {:pad (m.EdgeInsets/symmetric .horizontal 9.0 .vertical 14.0)
    :radius theme/radius-md
    :color theme/surface-alt}
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/start
    .children
    [(ui/top (m/Icon icon .size 16.0 .color theme/ink-faint))
     (ui/gap-h 8)
     (custom-tf/text-field
      !ime
      {:controller ctrl
       :focus-node focus
       :hint hint
       :obscure-text obscure?
       :max-lines 1
       :style (m/TextStyle .color theme/ink .fontFamily theme/font-family)
       :decoration (m/InputDecoration .border m/InputBorder.none)})])))

(defn- masthead [title blurb]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .crossAxisAlignment m.CrossAxisAlignment/start
   .children
   [(ui/brand 44.0)
    (ui/gap-v 20)
    (m/Flexible .child (mg/title title 22.0))
    (ui/gap-v 12)
    (mg/muted blurb)]))

(defn- card [child]
  (m/Center
   .child
   (ui/panel
    {:height card-height
     :pad 26.0
     :radius theme/radius-lg
     :shadow theme/card-shadow
     :margin (m.EdgeInsets/all 24.0)}
    child)))

(defn- shell [body]
  (m/Scaffold
   .backgroundColor theme/bg
   .resizeToAvoidBottomInset false
   .body (ui/backdrop (m/SafeArea .child (kb/wrap body)))))

(defn- submit-login! [ctx navigator user-ctrl pass-ctrl]
  (let [username (str/trim (.-text user-ctrl))
        password (.-text pass-ctrl)]
    (if (or (str/blank? username) (str/blank? password))
      (toast/info! ctx "Username and password are required")
      (-> (api/login! {:username username :password password})
          (.then (fn [_]
                   (when (.-mounted ^m/BuildContext ctx)
                     (toast/success! ctx "Signed in")
                     (when (.-canPop navigator) (.pop navigator)))
                   nil))
          (.catchError (fn [e]
                         (when (.-mounted ^m/BuildContext ctx)
                           (toast/error! ctx e))
                         nil)))))
  nil)

(defn- submit-register! [ctx navigator user-ctrl pass-ctrl name-ctrl]
  (let [username (str/trim (.-text user-ctrl))
        password (.-text pass-ctrl)
        display (str/trim (.-text name-ctrl))]
    (if (or (str/blank? username) (str/blank? password))
      (toast/info! ctx "Username and password are required")
      (-> (api/register! {:username username
                          :password password
                          :display-name display})
          (.then (fn [_]
                   (when (.-mounted ^m/BuildContext ctx)
                     (toast/success! ctx "Account created")
                     (when (.-canPop navigator) (.pop navigator)))
                   nil))
          (.catchError (fn [e]
                         (when (.-mounted ^m/BuildContext ctx)
                           (toast/error! ctx e))
                         nil)))))
  nil)

(defn login-screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [ime-control (kb/install)
             :dispose kb/restore-ime!
             user-ctrl (m/TextEditingController.)
             pass-ctrl (m/TextEditingController.)
             user-focus (m/FocusNode.)
             pass-focus (m/FocusNode.)]
   (shell
    (card
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(masthead "Sign in" "Welcome back to Nomio")
       (ui/gap-h 30)
       (field user-ctrl user-focus "username" m.Icons/person_outline false)
       (ui/gap-h 12)
       (field pass-ctrl pass-focus "password" m.Icons/lock_outline true)
       (ui/gap-h 24)
       (ui/action {:label "Sign in"
                   :icon m.Icons/arrow_forward_rounded
                   :on-tap #(submit-login! ctx navigator user-ctrl pass-ctrl)})
       (ui/gap-h 12)
       (ui/ghost-action {:label "Register"
                         :icon m.Icons/person_add_alt_1_outlined
                         :on-tap #(do (.pushReplacementNamed navigator "/register") nil)})])))))

(defn register-screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [ime-control (kb/install)
             :dispose kb/restore-ime!
             user-ctrl (m/TextEditingController.)
             pass-ctrl (m/TextEditingController.)
             name-ctrl (m/TextEditingController.)
             user-focus (m/FocusNode.)
             pass-focus (m/FocusNode.)
             name-focus (m/FocusNode.)]
   (shell
    (card
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(masthead "Register" "Pick a name and start writing")
       (ui/gap-h 30)
       (field name-ctrl name-focus "name" m.Icons/badge_outlined false)
       (ui/gap-h 12)
       (field user-ctrl user-focus "username" m.Icons/person_outline false)
       (ui/gap-h 12)
       (field pass-ctrl pass-focus "password" m.Icons/lock_outline true)
       (ui/gap-h 24)
       (ui/action {:label "Create account"
                   :icon m.Icons/arrow_forward_rounded
                   :on-tap #(submit-register! ctx navigator user-ctrl pass-ctrl name-ctrl)})
       (ui/gap-h 12)
       (ui/ghost-action {:label "Sign in"
                         :icon m.Icons/login_rounded
                         :on-tap #(do (.pushReplacementNamed navigator "/login") nil)})])))))
