(ns nomio.pages.explore
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.core.api :as api]
            [nomio.pages.tags :as tags]
            [nomio.state.store :as store]
            [nomio.widgets.content-card :as cards]
            [nomio.widgets.filter-bar :as filter-bar]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.ui :as ui]))

(def ^:private default-tab "articles")

(def ^:private tabs
  [["articles" "Articles"]
   ["questions" "Questions"]
   ["tags" "Tags"]])

(defn- fetch-for [tab]
  (case tab
    "questions" api/list-questions
    "tags" api/tags
    api/list-articles))

(defn page []
  (f/widget
   :context ctx
   :let [initial (or (:explore-tab @store/app-ui) default-tab)
         !tab (atom initial)
         !st (paged/state)
         ;; Indirect through the atom so the strip's scroll listener keeps
         ;; paging the tab that is actually on screen.
         fetch (fn [opts] ((fetch-for @!tab) opts))
         show! (fn [tab]
                 (swap! store/app-ui assoc :explore-tab tab)
                 (reset! !tab tab)
                 (paged/reload! ctx !st fetch)
                 nil)
         _ (show! initial)]
   :watch [tab !tab]
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/stretch
    .children
    [(m/Padding
      .padding (m.EdgeInsets/fromLTRB 20.0 24.0 12.0 24.0)
      .child
      (ui/page-header
       {:title "Explore"
        :icon m.Icons/explore_outlined
        :subtitle "What the community is publishing"
        :extra (filter-bar/single-select tabs initial show!)}))
     (m/Expanded
      .key (m/ValueKey tab)
      .child (paged/strip !st fetch (if (= tab "tags") tags/card cards/card)))])))
