(ns nomio.pages.write
  "Article / Question / Answer editor with autosave, preview, publish."
  (:require ["package:flutter/material.dart" :as m]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [block-editor.utils.history :as history]
            [nomio.content.document :as doc]
            [nomio.content.editor :as neditor]
            [nomio.content.reader :as nreader]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.sign-in :as sign-in]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]
            [rich-editor.components.text-field :as custom-tf]))

(defonce ^:private !ime (atom {:external-keyboard-delegate nil}))

(defn- cancel-timer-atom! [!t]
  (when-let [t @!t] (.cancel ^async/Timer t))
  nil)

(defn- dispose-autosave! [{:keys [!state !save-timer title-ctrl tags-ctrl on-meta]}]
  (remove-watch !state :autosave)
  (when on-meta
    (.removeListener ^m/TextEditingController title-ctrl on-meta)
    (.removeListener ^m/TextEditingController tags-ctrl on-meta))
  (cancel-timer-atom! !save-timer)
  nil)

(defn- status-label [c]
  (case (:status c)
    :published "Published"
    :draft "Draft"
    (str (:status c))))

(defn- parse-tags [^m/TextEditingController ctrl]
  (->> (str/split (or (.-text ctrl) "") #"[,\s#]+")
       (remove str/blank?)
       vec))

(defn- worth-saving? [type* title-ctrl tags-ctrl !state]
  (or (seq (str/trim (doc/plain-text @!state)))
      (and (not= type* :answer)
           (or (seq (str/trim (or (.-text title-ctrl) "")))
               (seq (parse-tags tags-ctrl))))))

(defn- persist!
  "Create on first save, patch afterwards. Empty new drafts skip the network
   so tapping Write does not leave a blank document on the server."
  [!id type* question-id ^m/TextEditingController title-ctrl tags-ctrl !state !save-status]
  (let [id @!id]
    (if (and (nil? id) (not (worth-saving? type* title-ctrl tags-ctrl !state)))
      (async/Future.value true)
      (do
        (reset! !save-status :saving)
        (let [body {:title (.-text title-ctrl)
                    :document @!state
                    :tags (parse-tags tags-ctrl)}]
          (if id
            (-> (api/save-draft! id body)
                (.then (fn [_]
                         (reset! !save-status :saved)
                         true))
                (.catchError (fn [e]
                               (reset! !save-status :error)
                               (dart:core/print (str "autosave failed: " e))
                               false)))
            (-> (api/create-content!
                 (cond-> (assoc body :type* type*)
                   question-id (assoc :question-id question-id)))
                (.then (fn [c]
                         (reset! !id (:id c))
                         (reset! !save-status :saved)
                         true))
                (.catchError (fn [e]
                               (reset! !save-status :error)
                               (dart:core/print (str "autosave failed: " e))
                               false)))))))))

(defn- published-path [c]
  (case (:type c)
    :question (str "/questions/" (or (:slug c) (:id c)))
    :answer (str "/answers/" (:id c))
    (str "/articles/" (or (:slug c) (:id c)))))

(defn- publish-flow! [ctx navigator !id type* question-id title-ctrl tags-ctrl !state !save-status]
  (-> (persist! !id type* question-id title-ctrl tags-ctrl !state !save-status)
      (.then (fn [saved?]
               (if-not saved?
                 (throw (Exception. "save failed"))
                 (if-let [id @!id]
                   (api/publish! id)
                   (throw (Exception. "Write something first"))))))
      (.then (fn [c]
               (when (.-mounted ^m/BuildContext ctx)
                 (toast/success! ctx "Published")
                 (when navigator
                   (.pushReplacementNamed navigator (published-path c))))
               nil))
      (.catchError (fn [e]
                     (when (.-mounted ^m/BuildContext ctx)
                       (toast/error! ctx e))
                     nil)))
  nil)

(defn- preview-dialog [ctx document title]
  (m/showDialog
   .context ctx
   .builder
   (fn [_]
     (m/Dialog
      .backgroundColor theme/transparent
      .insetPadding (m.EdgeInsets/all 28.0)
      .child
      (ui/panel
       {:width 760.0
        :height 520.0
        :pad 0.0
        :radius theme/radius-lg
        :shadow theme/card-shadow}
       (m/Column
        .children
        [(m/Padding
          .padding (m.EdgeInsets/fromLTRB 18.0 14.0 10.0 10.0)
          .child
          (m/Row
           .children
           [(m/Expanded .child (mg/title (or title "Preview") 16.0))
            (ui/icon-button {:icon m.Icons/close_rounded
                             :size 32.0
                             :on-tap (fn []
                                       (.pop (m/Navigator.of ctx))
                                       nil)})]))
         (m/Expanded
          .child (m/Padding
                  .padding (m.EdgeInsets/fromLTRB 8.0 0.0 8.0 12.0)
                  .child (nreader/widget document)))]))))))

(defn- meta-field [ctrl focus hint icon size-color]
  (ui/input-panel
   {:icon icon
    :margin (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 18.0)}
   (custom-tf/text-field
    !ime
    {:controller ctrl
     :focus-node focus
     :hint hint
     :max-lines 1
     :style (m/TextStyle .color size-color .fontSize 16.0 .fontFamily theme/font-family)
     :decoration (m/InputDecoration .border m/InputBorder.none)})))

(defn- save-mark [save-status]
  (let [[icon color]
        (case save-status
          :saving [m.Icons/sync_rounded theme/ink-faint]
          :saved [m.Icons/check_rounded theme/jade]
          :error [m.Icons/error_outline_rounded theme/danger]
          [m.Icons/edit_outlined theme/ink-faint])]
    (m/Icon icon .size 16.0 .color color)))

(defn- editor-chrome
  "Left-hand tools that need !state (undo/redo enable). Own :watch so the
   scaffold can mount mongol-block-editor without setState-during-build —
   same pattern as mgl-mail-app compose toolbar / mgl-notes-app editor-chrome."
  [content !state !save-status title-ctrl tags-ctrl !id type* question-id]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [st !state
           save-status !save-status]
   (let [tone (:color (theme/tone (:type content)))
         can-undo? (seq (get-in st [:history :undo-stack]))
         can-redo? (seq (get-in st [:history :redo-stack]))]
     (m/Padding
      .padding (m.EdgeInsets/fromLTRB 16.0 16.0 8.0 16.0)
      .child
      (m/Column
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/start
       .children
       [(ui/icon-button
         {:icon m.Icons/arrow_back_rounded
          :on-tap (fn []
                    (-> (persist! !id type* question-id title-ctrl tags-ctrl
                                  !state !save-status)
                        (.then (fn [saved?]
                                 (when (.-mounted ^m/BuildContext ctx)
                                   (when-not saved?
                                     (toast/error! ctx "save failed"))
                                   (.pop navigator))
                                 nil)))
                    nil)})
        (ui/gap-v 18)
        (ui/badge {:label (status-label content)
                   :color tone
                   :wash theme/accent-soft
                   :icon m.Icons/edit_outlined})
        (ui/gap-v 12)
        (save-mark save-status)
        (ui/gap-v 18)
        (ui/icon-button {:icon m.Icons/undo_rounded
                         :on-tap (when can-undo? #(history/undo! !state))})
        (ui/gap-v 8)
        (ui/icon-button {:icon m.Icons/redo_rounded
                         :on-tap (when can-redo? #(history/redo! !state))})
        (ui/gap-v 16)
        (ui/ghost-action {:label "Preview"
                          :icon m.Icons/visibility_outlined
                          :on-tap #(preview-dialog ctx @!state (.-text title-ctrl))})
        (ui/gap-v 10)
        (ui/action {:label "Publish"
                    :icon m.Icons/publish_rounded
                    :on-tap #(publish-flow! ctx navigator !id type* question-id
                                            title-ctrl tags-ctrl !state !save-status)})])))))

(defn- editor-screen [content]
  (f/widget
   :let [!state (atom (or (:document content) (doc/empty-document)))
         !save-status (atom :idle)
         !save-timer (atom nil)
         !id (atom (:id content))
         type* (:type content)
         question-id (:question-id content)
         question? (= :question type*)
         answer? (= :answer type*)
         ;; Build editor before any ancestor :watch on !state — mongol-block-editor
         ;; swap!s :editor-config at construction time (same as notes-app).
         editor-body (neditor/widget !state :wrap-ime? false)]
   ;; These two are bound only so :managed can dispose them.
   :managed [_ime-control (kb/install)
             :dispose kb/restore-ime!
             title-ctrl (m/TextEditingController. .text (or (:title content) ""))
             tags-ctrl (m/TextEditingController. .text (str/join " " (or (:tags content) [])))
             title-focus (m/FocusNode.)
             tags-focus (m/FocusNode.)
             _autosave
             (let [schedule!
                   (fn []
                     (when-let [t @!save-timer] (.cancel ^async/Timer t))
                     (reset! !save-timer
                             (async/Timer. (dart:core/Duration. .seconds 2)
                                           #(persist! !id type* question-id
                                                      title-ctrl tags-ctrl
                                                      !state !save-status)))
                     nil)]
               (add-watch !state :autosave (fn [_ _ _ _] (schedule!)))
               ;; Title and tags live in controllers, not in !state, so they need
               ;; their own hook into the same debounce.
               (.addListener title-ctrl schedule!)
               (.addListener tags-ctrl schedule!)
               {:!state !state
                :!save-timer !save-timer
                :title-ctrl title-ctrl
                :tags-ctrl tags-ctrl
                :on-meta schedule!})
             :dispose dispose-autosave!]
   (m/Scaffold
    .backgroundColor theme/bg
    .resizeToAvoidBottomInset false
    .body
    (ui/backdrop
     (m/SafeArea
      .child
      (kb/wrap
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        (cond-> [(editor-chrome content !state !save-status title-ctrl tags-ctrl
                                !id type* question-id)]
          (not answer?)
          (conj (meta-field title-ctrl title-focus "Title" m.Icons/title theme/ink))

          (or question? (not answer?))
          (conj (meta-field tags-ctrl tags-focus "#tag" m.Icons/tag theme/ink-muted))

          true
          (conj (m/Expanded
                 .child
                 (m/Padding
                  .padding (m.EdgeInsets/fromLTRB 6.0 16.0 16.0 16.0)
                  .child
                  (ui/panel
                   {:pad 8.0
                    :radius theme/radius-lg
                    :color theme/surface
                    :shadow theme/soft-shadow}
                   editor-body))))))))))))

(defn- fetch
  "A missing draft is an error like any other, so the screen can report why it
   failed instead of blaming every failure on a 404."
  [content-id]
  (-> (api/get-content content-id)
      (.then (fn [content]
               (if content
                 content
                 (throw (Exception. "This draft no longer exists")))))))

(defn screen [content-id]
  (f/widget
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (asy/load! ctx !st (fetch content-id)) nil)
         _ (reload!)]
   (asy/screen !st editor-screen :retry reload!)))

(defn blank
  "Local draft. Nothing is POSTed until the reader actually writes."
  [type*]
  (f/widget
   :watch [{:keys [user]} store/session]
   (if-not user
     (sign-in/prompt "Sign in to write")
     (editor-screen {:type (or type* :article)
                     :status :draft
                     :title ""
                     :tags []
                     :document (doc/empty-document)}))))

(defn blank-answer [question-id]
  (f/widget
   :watch [{:keys [user]} store/session]
   (if-not user
     (sign-in/prompt "Sign in to write")
     (f/widget
      :context ctx
      :let [!st (atom {:status :loading})
            reload! (fn [] (asy/load! ctx !st (fetch question-id)) nil)
            _ (reload!)]
      (asy/screen !st
                  (fn [q]
                    (editor-screen {:type :answer
                                    :status :draft
                                    :question-id (:id q)
                                    :title (str "A: " (or (:title q) ""))
                                    :tags []
                                    :document (doc/empty-document)}))
                  :retry reload!)))))
