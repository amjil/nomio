(ns nomio.pages.profile
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.content-card :as cards]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.sign-in :as sign-in]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(defn- toggle-follow! [ctx u following? reload!]
  (store/require-auth!
   (fn []
     (-> (if following? (api/unfollow! (:id u)) (api/follow! (:id u)))
         (.then (fn [_]
                  (when (.-mounted ^m/BuildContext ctx)
                    (reload!))
                  nil))
         (.catchError (fn [e]
                        (when (.-mounted ^m/BuildContext ctx)
                          (toast/error! ctx e))
                        nil)))))
  nil)

(defn- counter [value label]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .crossAxisAlignment m.CrossAxisAlignment/start
   .children
   [(mg/text (str (or value 0)) {:size 16.0 :weight m.FontWeight/w700})
    (ui/gap-v 6)
    (mg/muted label 11.5)]))

(defn- aside [ctx data me? reload!]
  (let [u (:user data)
        following? (boolean (:following u))
        name (or (:display-name u) (:username u) "")]
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/start
     .children
     [(ui/avatar name 54.0)
      (ui/gap-v 18)
      (m/Flexible .child (mg/title name 20.0))
      (if (:username u) (ui/gap-v 10) ui/nothing)
      (if (:username u) (mg/muted (str "@" (:username u))) ui/nothing)
      (if (:follower-count u) (ui/gap-v 18) ui/nothing)
      (if (:follower-count u)
        (m/Row
         .mainAxisSize m.MainAxisSize/min
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children
         [(counter (:follower-count u) "followers")
          (ui/gap-h 14)
          (counter (:following-count u) "following")])
        ui/nothing)
      (ui/gap-v 20)
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/start
       .children
       [(if (and (not me?) u)
          (if following?
            (ui/ghost-action {:label "Unfollow"
                              :icon m.Icons/person_remove_alt_1_outlined
                              :on-tap #(toggle-follow! ctx u following? reload!)})
            (ui/action {:label "Follow"
                        :icon m.Icons/person_add_alt_1_rounded
                        :on-tap #(toggle-follow! ctx u following? reload!)}))
          ui/nothing)
        (if me? (ui/gap-h 10) ui/nothing)
        (if me?
            (ui/ghost-action {:label "Saved"
                            :icon m.Icons/bookmark_border
                            :on-tap (fn []
                                      (store/set-nav! "bookmarks")
                                      (store/pop!)
                                      nil)})
          ui/nothing)
        (if me? (ui/gap-h 10) ui/nothing)
        (if me?
          (ui/ghost-action {:label "Log out"
                            :icon m.Icons/logout_rounded
                            :tone theme/danger
                            :on-tap #(api/logout!)})
          ui/nothing)])])))

(defn- contents [me? !pub pub-fetch !drafts drafts-fetch]
  (if-not me?
    (paged/strip !pub pub-fetch cards/card)
    (m/Row
     .crossAxisAlignment m.CrossAxisAlignment/stretch
     .children
     [(m/Expanded
       .flex 3
       .child (paged/strip !pub pub-fetch cards/card))
      (m/Expanded
       .flex 2
       .child
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        [(m/Padding
          .padding (m.EdgeInsets/fromLTRB 8.0 24.0 4.0 24.0)
          .child (mg/label "Drafts" theme/gold))
         (m/Expanded .child (paged/strip !drafts drafts-fetch cards/card))]))])))

(defn- profile-for [uname me?]
  (f/widget
   ;; Keyed on the username so viewing a different profile refetches instead of
   ;; reusing the previous one's State.
   :key uname
   :context ctx
   :let [!user (atom {:status :loading})
         !pub (paged/state)
         !drafts (paged/state)
         pub-fetch (fn [opts] (api/list-feed (merge {:author uname} opts)))
         drafts-fetch (fn [opts] (api/mine (merge {:status "draft"} opts)))
         reload! (fn []
                   (asy/load! ctx !user (api/profile uname))
                   (paged/reload! ctx !pub pub-fetch)
                   (when me? (paged/reload! ctx !drafts drafts-fetch))
                   nil)
         _ (do (asy/load! ctx !user (api/profile uname))
               (paged/load-more! ctx !pub pub-fetch)
               (when me? (paged/load-more! ctx !drafts drafts-fetch)))]
   :watch [user-st !user]
   (asy/section (aside ctx (:data user-st) me? reload!)
                !user
                (fn [_] (contents me? !pub pub-fetch !drafts drafts-fetch))
                :retry reload!)))

(defn page
  ([] (page nil))
  ([username]
   (f/widget
    :watch [{:keys [user]} store/session]
    (let [uname (or username (:username user))
          me? (and user (= uname (:username user)))]
      (if uname
        (profile-for uname me?)
        (sign-in/prompt "Sign in to see your profile"))))))
