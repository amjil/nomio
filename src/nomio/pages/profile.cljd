(ns nomio.pages.profile
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.content-card :as cards]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.sign-in :as sign-in]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(defn- toggle-follow! [ctx u following? reload!]
  (store/require-auth!
   (fn []
     (-> (if following? (api/unfollow! (:id u)) (api/follow! (:id u)))
         (.then (fn [_]
                  (when (.-mounted ^m/BuildContext ctx)
                    (reload!))
                  nil))
         (.catchError (fn [e]
                        (when (.-mounted ^m/BuildContext ctx)
                          (toast/error! ctx e))
                        nil)))))
  nil)

(defn- counter [value label]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .crossAxisAlignment m.CrossAxisAlignment/start
   .children
   [(mg/text (str (or value 0)) {:size 16.0 :weight m.FontWeight/w700})
    (ui/gap-v 6)
    (mg/muted label 11.5)]))

(defn- aside [ctx data me? reload!]
  (let [u (:user data)
        following? (boolean (:following u))
        name (or (:display-name u) (:username u) "")]
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/start
     .children
     [(ui/avatar name 54.0)
      (ui/gap-v 18)
      (m/Flexible .child (mg/title name 20.0))
      (if (:username u) (ui/gap-v 10) ui/nothing)
      (if (:username u) (mg/muted (str "@" (:username u))) ui/nothing)
      (if (:follower-count u) (ui/gap-v 18) ui/nothing)
      (if (:follower-count u)
        (m/Row
         .mainAxisSize m.MainAxisSize/min
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children
         [(counter (:follower-count u) "followers")
          (ui/gap-h 14)
          (counter (:following-count u) "following")])
        ui/nothing)
      (ui/gap-v 20)
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/start
       .children
       [(if (and (not me?) u)
          (if following?
            (ui/ghost-action {:label "Unfollow"
                              :icon m.Icons/person_remove_alt_1_outlined
                              :on-tap #(toggle-follow! ctx u following? reload!)})
            (ui/action {:label "Follow"
                        :icon m.Icons/person_add_alt_1_rounded
                        :on-tap #(toggle-follow! ctx u following? reload!)}))
          ui/nothing)
        (if me? (ui/gap-h 10) ui/nothing)
        (if me?
          (ui/ghost-action {:label "Saved"
                            :icon m.Icons/bookmark_border
                            :on-tap #(store/set-nav! "bookmarks")})
          ui/nothing)
        (if me? (ui/gap-h 10) ui/nothing)
        (if me?
          (ui/ghost-action {:label "Log out"
                            :icon m.Icons/logout_rounded
                            :tone theme/danger
                            :on-tap #(api/logout!)})
          ui/nothing)])])))

(defn- contents [data me?]
  (let [items (concat (:articles data)
                      (:questions data)
                      (:answers data)
                      (when me? (:drafts data)))]
    (if (empty? items)
      (ui/state-view {:icon m.Icons/edit_note_rounded
                      :title "Nothing published yet"
                      :message (if me?
                                 "Anything you write shows up here"
                                 "This account has not published yet")})
      (cards/strip items))))

(defn- profile-for [uname me?]
  (f/widget
   ;; Keyed on the username so viewing a different profile refetches instead of
   ;; reusing the previous one's State.
   :key uname
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (asy/load! ctx !st (api/profile uname)) nil)
         _ (reload!)]
   :watch [st !st]
   (asy/section (aside ctx (:data st) me? reload!)
                !st
                (fn [data] (contents data me?))
                :retry reload!)))

(defn page
  ([] (page nil))
  ([username]
   (f/widget
    :watch [{:keys [user]} store/session]
    (let [uname (or username (:username user))
          me? (and user (= uname (:username user)))]
      (if uname
        (profile-for uname me?)
        (sign-in/prompt "Sign in to see your profile"))))))
