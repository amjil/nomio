(ns nomio.pages.answer
  (:require ["package:flutter/material.dart" :as m]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [nomio.content.reader :as nreader]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.comments :as comments]
            [nomio.widgets.engage :as engage]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.reader-frame :as frame]
            [nomio.widgets.related :as related]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(defn- cast-vote! [ctx !a dir]
  (store/require-auth!
   (fn []
     (let [a @!a]
       (-> (if (= (:my-vote a) dir)
             (api/unvote! (:id a))
             (api/vote! (:id a) dir))
           (.then (fn [res]
                    (when (.-mounted ^m/BuildContext ctx)
                      (swap! !a assoc
                             :my-vote (:my-vote res)
                             :vote-score (:vote-score res)))
                    nil))
           (.catchError (fn [e]
                          (when (.-mounted ^m/BuildContext ctx)
                            (toast/error! ctx e))
                          nil))))))
  nil)

(defn- vote-box [a !a ctx]
  (let [score (or (:vote-score a) 0)
        mine (:my-vote a)]
    (ui/panel
     {:pad (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 10.0)
      :radius theme/radius-lg
      :color theme/surface}
     (m/Column
      .mainAxisSize m.MainAxisSize/min
      .crossAxisAlignment m.CrossAxisAlignment/center
      .children
      [(ui/icon-button {:icon m.Icons/keyboard_arrow_up_rounded
                        :size 32.0
                        :active? (= mine 1)
                        :on-tap #(cast-vote! ctx !a 1)})
       (ui/gap-v 8)
       (mg/text (str score) {:size 15.0 :weight m.FontWeight/w700})
       (ui/gap-v 8)
       (ui/icon-button {:icon m.Icons/keyboard_arrow_down_rounded
                        :size 32.0
                        :active? (= mine -1)
                        :on-tap #(cast-vote! ctx !a -1)})]))))

(defn- parent-link [q]
  (if-not q
    ui/nothing
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/start
     .children
     [(mg/label "Question")
      (ui/gap-v 10)
      (ui/tappable
       #(store/push-named! (str "/questions/" (or (:slug q) (:id q))))
       theme/radius-sm
       (m/Padding
        .padding (m.EdgeInsets/symmetric .horizontal 2.0 .vertical 4.0)
        .child (mg/text (or (:title q) "")
                        {:size 14.0 :color theme/gold :max-lines 3})))])))

(defn- screen* [a q]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [_ime-control (kb/install)
             :dispose kb/restore-ime!]
   :let [!a (atom a)
         paper (nreader/widget (:document a))]
   :watch [ans !a]
   (m/Scaffold
    .backgroundColor theme/bg
    .resizeToAvoidBottomInset false
    .body
    (ui/backdrop
     (m/SafeArea
      .child
      (kb/wrap
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        [(frame/meta-aside
          {:content ans
           :on-back #(.pop navigator)
           :actions
           (into [(when (= (:id (store/current-user)) (:author-id ans))
                    {:icon m.Icons/edit_outlined
                     :on-tap #(store/push-named! (str "/content/" (:id ans) "/edit"))})]
                 (engage/owner-status-actions ctx ans))
           :extra (m/Column
                   .mainAxisSize m.MainAxisSize/min
                   .crossAxisAlignment m.CrossAxisAlignment/start
                   .children
                   [(vote-box ans !a ctx)
                    (ui/gap-v 18)
                    (parent-link q)])})

         (m/Expanded
          .flex 3
          .child (frame/paper paper :title (:title a)))

         (comments/column "answer" (:id ans))
         (related/column (cond-> ans
                           (and (empty? (:tags ans)) q)
                           (assoc :tags (:tags q))))])))))))

(defn- fetch
  "An answer plus its parent question. A missing question still renders the
   answer, so that lookup failing is not an error for the page."
  [id]
  (-> (api/get-content id)
      (.then (fn [a]
               (if (:question-id a)
                 (-> (api/get-content (:question-id a))
                     (.then (fn [q] {:a a :q q}))
                     (.catchError (fn [_] {:a a :q nil})))
                 (async/Future.value {:a a :q nil}))))))

(defn screen [id]
  (f/widget
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (asy/load! ctx !st (fetch id)) nil)
         _ (reload!)]
   (asy/screen !st
               (fn [{:keys [a q]}] (screen* a q))
               :retry reload!)))
