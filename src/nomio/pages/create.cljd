(ns nomio.pages.create
  (:require ["package:flutter/material.dart" :as m]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.ui :as ui]))

(defn- start! [type*]
  (store/require-auth!
   (fn []
     (store/push-named! (str "/create/new/" (name type*)))))
  nil)

(defn- tile [{:keys [icon label blurb type*]}]
  (let [{:keys [color wash]} (theme/tone type*)]
    (ui/panel
     {:width 250.0
      :height 340.0
      :margin (m.EdgeInsets/all 14.0)
      :pad 26.0
      :radius theme/radius-lg
      :shadow theme/card-shadow
      :on-tap #(start! type*)}
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(ui/spine color)
       (ui/gap-h 18)
       (ui/top
        (m/Container
         .width 46.0
         .height 46.0
         .decoration (m/BoxDecoration
                      .color wash
                      .borderRadius (theme/r 15.0))
         .child (m/Center .child (m/Icon icon .size 22.0 .color color))))
       (ui/gap-h 16)
       (m/Expanded .flex 2 .child (mg/title label 19.0))
       (ui/gap-h 10)
       (m/Expanded .flex 3 .child (mg/muted blurb))]))))

(defn page []
  (m/Center
   .child
   (m/Row
    .mainAxisSize m.MainAxisSize/min
    .mainAxisAlignment m.MainAxisAlignment/center
    .children
    [(m/Padding
      .padding (m.EdgeInsets/only .right 20.0)
      .child
      (m/Column
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/start
       .children
       [(ui/brand 44.0)
        (ui/gap-v 20)
        (mg/title "Write" 22.0)
        (ui/gap-v 12)
        (mg/muted "Start something new")]))
     (tile {:icon m.Icons/article_outlined
            :label "Article"
            :blurb "A piece you publish on its own"
            :type* :article})
     (tile {:icon m.Icons/help_outline
            :label "Question"
            :blurb "Ask the community for an answer"
            :type* :question})])))
