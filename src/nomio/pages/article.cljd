(ns nomio.pages.article
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.content.reader :as nreader]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.comments :as comments]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.reader-frame :as frame]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(defn- open-link [target]
  (let [title (if (map? target) (:title target) (str target))]
    (when (seq title)
      (when-let [hit (store/resolve-title title)]
        (store/open-content! hit))))
  nil)

(defn- toggle-like! [ctx !c content liked?]
  (store/require-auth!
   (fn []
     (-> (api/toggle-like! (:id content) liked?)
         (.then (fn [res]
                  (when (.-mounted ^m/BuildContext ctx)
                    (swap! !c assoc
                           :liked (:liked res)
                           :like-count (:like-count res)))
                  nil))
         (.catchError (fn [e]
                        (when (.-mounted ^m/BuildContext ctx)
                          (toast/error! ctx e))
                        nil)))))
  nil)

(defn- toggle-bookmark! [ctx !c content]
  (store/require-auth!
   (fn []
     (-> (api/toggle-bookmark! (:id content))
         (.then (fn [bm]
                  (when (.-mounted ^m/BuildContext ctx)
                    (swap! !c assoc :bookmarked bm))
                  nil))
         (.catchError (fn [e]
                        (when (.-mounted ^m/BuildContext ctx)
                          (toast/error! ctx e))
                        nil)))))
  nil)

(defn- screen* [c]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [_ime-control (kb/install)
             :dispose kb/restore-ime!]
   :let [!c (atom c)
         !comments (asy/load! ctx (api/comments "article" (:id c)))
         !reply (atom nil)]
   :watch [content !c]
   (let [mine? (= (:id (store/current-user)) (:author-id content))
         liked? (boolean (:liked content))
         bookmarked? (api/bookmarked? content)]
     (m/Scaffold
      .backgroundColor theme/bg
      .resizeToAvoidBottomInset false
      .body
      (ui/backdrop
       (m/SafeArea
        .child
        (kb/wrap
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/stretch
          .children
          [(frame/meta-aside
            {:content content
             :on-back #(.pop navigator)
             :on-tag #(store/push-named! (str "/tags/" (first (:tags content))))
             :actions
             [(when mine?
                {:icon m.Icons/edit_outlined
                 :on-tap #(store/push-named! (str "/content/" (:id content) "/edit"))})
              {:icon (if liked? m.Icons/favorite_rounded m.Icons/favorite_border)
               :active? liked?
               :on-tap #(toggle-like! ctx !c content liked?)}
              {:icon (if bookmarked? m.Icons/bookmark_rounded m.Icons/bookmark_border)
               :active? bookmarked?
               :on-tap #(toggle-bookmark! ctx !c content)}]})

           (m/Expanded
            .flex 3
            .child (frame/paper (nreader/widget (:document content)
                                                :on-link open-link)
                                :title (:title content)))

           (m/Expanded
            .flex 2
            .child
            (frame/comments-pane
             (asy/view !comments
                       #(comments/tree % (fn [pid] (reset! !reply pid) nil)))
             (comments/composer
              :article (:id content)
              :!reply-to !reply
              :on-posted (fn []
                           (asy/load! ctx !comments (api/comments "article" (:id content)))
                           nil))))])))))))) 

(defn screen [slug]
  (f/widget
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (asy/load! ctx !st (api/get-content slug)) nil)
         _ (reload!)]
   (asy/screen !st screen* :retry reload!)))
