(ns nomio.widgets.reference-search
  "A dedicated widget for searching and inserting post, block, or highlight references.
   Supports 3 tabs: Posts, Blocks, and Highlights to allow full PKM resurfacing in the editor.
   Fully styled with Tenger Blue design system."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   [cljd.flutter :as f]
   [clojure.string :as str]
   
   ;; Nomio business & network layer
   [nomio.core.api :as api]
   [nomio.utils.tokens :as tokens]
   [components.toast :as toast]
   [nomio.utils.platform :as platform]

   ;; Custom TextField & IME components
   [rich-editor.components.text-field :as custom-tf]
   [shared-ime.controller :as ime-ctrl]
   [virtual-keyboard.keyboard :as keyboard]
   [virtual-keyboard.options :as options]
   [shared-ime.overlay-view :as overlay]))

;; =============================================================================
;; Isolated State for the Search Modal
;; =============================================================================

(defonce !ref-search-state
  (atom {:root ["search-block"]
         :blocks {"search-block" {:id "search-block" :type :paragraph :content ""}}
         :active-block-id "search-block"
         :cursor-visible true
         :external-keyboard-delegate nil
         :history {:undo-stack [] :redo-stack [] :max-depth 100}}))

;; =============================================================================
;; Modal Content View
;; =============================================================================

(defn- reference-search-view
  "Top-level view component for the bottom sheet modal."
  [_sheet-ctx !target-editor-state captured-active-id modal-h]
  (let [!raw-results (atom [])
        !loading? (atom false)
        ;; Toggle between :post, :block, and :highlight
        !search-type (atom :post)
        
        do-search! 
        (fn [q]
          (reset! !loading? true)
          (let [;; Route to the appropriate network API based on the selected tab
                fetch-promise (case @!search-type
                                :post      (api/search-posts q :limit 20)
                                :block     (api/search-blocks q :limit 20)
                                :highlight (api/fetch-highlights :limit 20))]
            (-> fetch-promise
                (.then (fn [data]
                         (let [items (cond
                                       (sequential? data) data
                                       (and (map? data) (sequential? (:data data))) (:data data)
                                       (and (map? data) (sequential? (get data "data"))) (get data "data")
                                       :else [])]
                           (reset! !raw-results (vec items))
                           (reset! !loading? false)
                           nil)))
                (.catchError (fn [_]
                               (reset! !loading? false)
                               nil)))))]
    (f/widget
     :context local-ctx
     
     :managed [search-ctrl (m/TextEditingController.)
               search-focus-node (m/FocusNode.)]
               
     :watch [results !raw-results
             loading? !loading?
             search-type !search-type
             ref-search-state !ref-search-state]
     
     :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                :keyboard/key-container-color m/Colors.grey.shade500
                                                :keyboard/font-size 16})
           
           main-content
           (m/Container
            .color tokens/bg-color
            .child
            (m/Row
             .children
             [;; A. Sidebar Search Category Controls
              (m/Container
               .width 80.0
               .margin (m/EdgeInsets.only .left 16.0 .top 16.0 .bottom 16.0)
               .decoration (m/BoxDecoration 
                            .color tokens/surface-color 
                            .borderRadius (m/BorderRadius.circular 40.0)
                            .boxShadow tokens/tenger-shadow
                            .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
               .child
               (m/Column
                .children
                [(m/Padding .padding (m/EdgeInsets.only .top 24.0 .bottom 16.0) .child (m/Icon m.Icons/search .color tokens/primary-color))
                 
                 (m/Expanded
                  .child
                  (m/Padding
                   .padding (m/EdgeInsets.only .bottom 16.0)
                   .child
                   (custom-tf/text-field
                    !ref-search-state
                    {:controller search-ctrl
                     :focus-node search-focus-node
                     :autofocus true
                     :hint "Хайх..."
                     :max-lines 1
                     :on-submitted (fn [text] 
                                     (do-search! (str/trim text))
                                     nil)
                     :style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-primary .fontSize 18.0)})))
                 
                 ;; Three tabs switcher (Post / Block / Highlight)
                 (m/Container
                  .padding (m/EdgeInsets.symmetric .vertical 16.0)
                  .decoration (m/BoxDecoration .border (m/Border .top (m/BorderSide .color (.withOpacity tokens/text-secondary 0.2) .width 1.0)))
                  .child
                  (m/Column
                   .mainAxisSize m.MainAxisSize/min
                   .children
                   [(m/InkWell
                     .onTap (fn [] (reset! !search-type :post) (do-search! (.-text search-ctrl)) nil)
                     .child (m/Padding 
                             .padding (m/EdgeInsets.symmetric .vertical 16.0 .horizontal 8.0)
                             .child (mgl/MongolText "Нийтлэл"
                                                    .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0
                                                                        .fontWeight (if (= search-type :post) m.FontWeight/bold m.FontWeight/normal)
                                                                        .color (if (= search-type :post) tokens/primary-color tokens/text-secondary)))))
                    (m/InkWell
                     .onTap (fn [] (reset! !search-type :block) (do-search! (.-text search-ctrl)) nil)
                     .child (m/Padding 
                             .padding (m/EdgeInsets.symmetric .vertical 16.0 .horizontal 8.0)
                             .child (mgl/MongolText "Хэсэг"
                                                    .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0
                                                                        .fontWeight (if (= search-type :block) m.FontWeight/bold m.FontWeight/normal)
                                                                        .color (if (= search-type :block) tokens/primary-color tokens/text-secondary)))))
                    ;; Highlight category tab selection
                    (m/InkWell
                     .onTap (fn [] (reset! !search-type :highlight) (do-search! (.-text search-ctrl)) nil)
                     .child (m/Padding 
                             .padding (m/EdgeInsets.symmetric .vertical 16.0 .horizontal 8.0)
                             .child (mgl/MongolText "Эшлэл"
                                                    .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0
                                                                        .fontWeight (if (= search-type :highlight) m.FontWeight/bold m.FontWeight/normal)
                                                                        .color (if (= search-type :highlight) tokens/primary-color tokens/text-secondary)))))]))]))
              
              (m/SizedBox .width 32.0)
              
              ;; B. Horizontal Results Scroll View
              (m/Expanded
               .child
               (if loading?
                 (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color))
                 (if (empty? results)
                   (m/Center .child (mgl/MongolText "Илэрц алга" .style (m/TextStyle .color tokens/text-secondary .fontFamily "OyunQaganTig" .fontSize 16.0)))
                   (m/ListView.builder
                    .scrollDirection m.Axis/horizontal
                    .physics (m/BouncingScrollPhysics.)
                    .padding (m/EdgeInsets.only .top 16.0 .bottom 16.0 .right 32.0)
                    .itemCount (count results)
                    .itemBuilder
                    (fn [_ i]
                      (let [item (nth results i)
                            
                            ;; Dynamic parsing fields maps based on payload architecture
                            display-title (case search-type
                                            :post      (get item "title" (get item :title "Гарчиггүй"))
                                            :block     (get item "text" (get item :text "Хоосон"))
                                            :highlight (get item "content" (get item :content "Эшлэл хоосон")))
                                            
                            display-subtitle (case search-type
                                               :post      (str "@" (get item "author_username" (get item :author_username "user")))
                                               :block     (str "Эх сурвалж: " (get item "post_title" (get item :post_title "")))
                                               :highlight (str "Тэмдэглэл: " (get item "note" (get item :note "Байхгүй"))))
                                               
                            icon-data (case search-type
                                        :post      m.Icons/link
                                        :block     m.Icons/format_quote
                                        :highlight m.Icons/psychology)]
                        
                        (m/Padding
                         .padding (m/EdgeInsets.only .right 16.0)
                         .child
                         (m/InkWell
                          .onTap (fn []
                                   (let [now-ms (.-millisecondsSinceEpoch (dc/DateTime.now))
                                         new-id (str "ref-" now-ms)
                                         new-p-id (str "block-" (inc now-ms))
                                         
                                         ;; Construct custom reference payload structures for structural integration
                                         new-block (case search-type
                                                     :post      {:id new-id :type :post-quote :data {:ref-post-id (get item "id" (get item :id))} :content display-title :content-spans [] :children []}
                                                     :block     {:id new-id :type :block-ref :data {:ref-post-id (get item "post_id" (get item :post_id)) :ref-block-id (get item "block_id" (get item :block_id))} :content display-title :content-spans [] :children []}
                                                     :highlight {:id new-id :type :paragraph :data {:ref-highlight-id (get item "id" (get item :id))} :content (str "“" display-title "”") :content-spans [] :children []})
                                         
                                         empty-p {:id new-p-id :type :paragraph :content "" :content-spans [] :children []}]
                                     
                                     ;; Atomic mutation on parent editor layout tree
                                     (swap! !target-editor-state
                                            (fn [state]
                                              (let [root (:root state)
                                                    idx-val (loop [idx 0, coll root]
                                                              (if (empty? coll) -1
                                                                (if (= (first coll) captured-active-id) idx
                                                                  (recur (inc idx) (rest coll)))))
                                                    idx (if (>= idx-val 0) (inc idx-val) (count root))
                                                    new-root (vec (concat (subvec root 0 idx) [new-id new-p-id] (subvec root idx)))]
                                                (-> state
                                                    (assoc-in [:blocks new-id] new-block)
                                                    (assoc-in [:blocks new-p-id] empty-p)
                                                    (assoc :root new-root)
                                                    (assoc :active-block-id new-p-id)))))
                                     (toast/success local-ctx "Амжилттай холбогдлоо" :fade)
                                     (m/Navigator.pop local-ctx)
                                     nil))
                          .borderRadius (m/BorderRadius.circular 16.0)
                          .child
                          (m/Container
                           .width 180.0
                           .padding (m/EdgeInsets.all 24.0)
                           .decoration (m/BoxDecoration 
                                        .color (if (= search-type :post) tokens/primary-container tokens/surface-color)
                                        .border (if (= search-type :post) 
                                                  (m/Border.all .color m.Colors/transparent .width 1.0)
                                                  (m/Border.all .color (.withOpacity tokens/text-secondary 0.2) .width 1.0))
                                        .borderRadius (m/BorderRadius.circular 16.0))
                           .child
                           (m/Column
                            .crossAxisAlignment m.CrossAxisAlignment/start
                            .children
                            [(m/Icon icon-data .color tokens/primary-color .size 24.0)
                             (m/SizedBox .height 16.0)
                             (m/Expanded
                              .child
                              (mgl/MongolText display-title 
                                              .style (m/TextStyle .fontSize (if (= search-type :post) 18.0 16.0) 
                                                                  .color tokens/text-primary
                                                                  .fontFamily "OyunQaganTig" 
                                                                  .fontWeight (if (= search-type :post) m.FontWeight/bold m.FontWeight/normal))
                                              .maxLines 5 
                                              .overflow m.TextOverflow/ellipsis))
                             (m/SizedBox .height 16.0)
                             (m/Divider .color (.withOpacity tokens/text-secondary 0.2))
                             (m/SizedBox .height 16.0)
                             (mgl/MongolText display-subtitle
                                             .style (m/TextStyle .fontSize 13.0 .color tokens/text-secondary .fontFamily "OyunQaganTig"))]))))))))))]))]
     
     :bind {:info info}
     
     (m/Container
      .height modal-h
      .child
      (m/ClipRRect
       .borderRadius (m/BorderRadius.vertical .top (m/Radius.circular 24.0))
       .child
       (m/Scaffold
        .backgroundColor tokens/bg-color
        .resizeToAvoidBottomInset false
        .body
        (if (platform/use-virtual-keyboard?)
          (m/Column
           .children
           [(m/Expanded
             .child
             (m/Stack
              .children
              [main-content
               (keyboard/candidates {:widget-key (m/ValueKey. "ref-modal-cand")})]))
            
            (m/SafeArea
             .top false
             .child
             (keyboard/keyboard 
              {:widget-key (m/ValueKey. "ref-modal-kb")
               :custom-fns
               {:on-return
                (fn []
                  (when-let [cb (:on-return (:external-keyboard-delegate @!ref-search-state))] (cb))
                  nil)
                :on-backspace
                (fn []
                  (when-let [cb (:on-backspace (:external-keyboard-delegate @!ref-search-state))] (cb))
                  nil)}}))])
          
          (overlay/ime-global-wrapper main-content "ref-modal-ime"))))))))

;; =============================================================================
;; Entry Point
;; =============================================================================

(defn show-dialog!
  "Public API to launch the reference search modal."
  [ctx !target-editor-state]
  (let [captured-active-id (:active-block-id @!target-editor-state)
        media-q (m/MediaQuery.of ctx)
        screen-h (.-height (.-size media-q))
        top-padding (.-top (.-padding media-q))
        safe-top (if (> top-padding 0) (+ top-padding 12.0) (if platform/is-web? 24.0 48.0))
        modal-h (- screen-h safe-top)]
    
    (swap! !target-editor-state assoc :active-block-id nil :cursor-visible false)
    
    (let [primary-focus (.-primaryFocus m/FocusManager.instance)]
      (when primary-focus (.unfocus primary-focus)))
    
    (reset! !ref-search-state 
            {:root ["search-block"]
             :blocks {"search-block" {:id "search-block" :type :paragraph :content ""}}
             :active-block-id "search-block"
             :cursor-visible true
             :external-keyboard-delegate nil
             :history {:undo-stack [] :redo-stack [] :max-depth 100}})
             
    (-> (m/showModalBottomSheet
         .context ctx
         .isScrollControlled true
         .backgroundColor m.Colors/transparent
         .builder (fn [sheet-ctx]
                    (reference-search-view sheet-ctx !target-editor-state captured-active-id modal-h)))
        
        (.whenComplete
         (fn []
           (when (nil? (:active-block-id @!target-editor-state))
             (swap! !target-editor-state assoc :active-block-id captured-active-id :cursor-visible true))
           nil)))))