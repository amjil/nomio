(ns nomio.widgets.async
  "Async data → UI. Every page shares the loading / error / empty states here."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.core.errors :as errors]
            [nomio.theme :as theme]
            [nomio.widgets.ui :as ui]))

(defn spinner []
  (ui/spinner))

(defn empty-state
  ([] (empty-state "Nothing here yet"))
  ([label]
   (ui/state-view {:icon m.Icons/inbox_outlined :title label})))

(defn- failure [e retry]
  (ui/state-view {:icon m.Icons/error_outline_rounded
                  :tone theme/danger
                  :title "Something went wrong"
                  :message (errors/message e)
                  :action-label "Retry"
                  :on-action retry}))

(defn load!
  "Run `future`, tracking {:status :loading|:ok|:error} in `!st`.

   `ctx` gates the callbacks: without it a slow response resolving after the
   page was popped writes to a disposed State and crashes."
  ([ctx future] (load! ctx (atom {:status :loading}) future))
  ([ctx !st future]
   (reset! !st {:status :loading})
   (-> future
       (.then (fn [data]
                (when (.-mounted ^m/BuildContext ctx)
                  (reset! !st {:status :ok :data data}))
                nil))
       (.catchError (fn [e]
                      (when (.-mounted ^m/BuildContext ctx)
                        (reset! !st {:status :error :error e}))
                      nil)))
   !st))

(defn view
  "Watch a `load!` atom and render loading / error / (build data).
   Pass `:retry` a thunk to offer a retry button on failure."
  [!st build & {:keys [retry]}]
  (f/widget
   :watch [st !st]
   (case (:status st)
     :error (failure (:error st) retry)
     :ok (build (:data st))
     (spinner))))

(defn screen
  "Whole-page async wrapper: loading and error get their own Scaffold so the
   reader routes don't each hand-roll one."
  [!st build & {:keys [retry]}]
  (f/widget
   :watch [st !st]
   (case (:status st)
     :ok (build (:data st))
     :error (m/Scaffold .backgroundColor theme/bg
                        .body (ui/backdrop (failure (:error st) retry)))
     (m/Scaffold .backgroundColor theme/bg
                 .body (ui/backdrop (spinner))))))

(defn section
  "Left-hand column plus an async right pane — the layout the list pages share."
  [aside !st build & {:keys [retry]}]
  (m/Row
   .crossAxisAlignment m.CrossAxisAlignment/stretch
   .children
   [(m/Padding
     .padding (m.EdgeInsets/fromLTRB 20.0 24.0 12.0 24.0)
     .child aside)
    (m/Expanded .child (view !st build :retry retry))]))

(defn titled-section [title !st build & {:keys [retry icon subtitle tone]}]
  (section (ui/page-header {:title title
                            :subtitle subtitle
                            :icon (or icon m.Icons/layers_outlined)
                            :tone (or tone theme/accent)
                            :on-refresh retry})
           !st build :retry retry))

(defn list-page
  "Fetch once on mount, then render a heading beside the result.
   `fetch` is a thunk so the request is not re-issued on every rebuild."
  [title fetch build]
  (f/widget
   :context ctx
   :let [!st (atom {:status :loading})
         reload! (fn [] (load! ctx !st (fetch)) nil)
         _ (reload!)]
   (titled-section title !st build :retry reload!)))
