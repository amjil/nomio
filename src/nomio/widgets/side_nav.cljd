(ns nomio.widgets.side-nav
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.ui :as ui]))

(def tabs
  [{:id "home" :icon m.Icons/home_outlined :selected-icon m.Icons/home_rounded :label "Home"}
   {:id "explore" :icon m.Icons/explore_outlined :selected-icon m.Icons/explore :label "Explore"}
   {:id "articles" :icon m.Icons/article_outlined :selected-icon m.Icons/article_rounded :label "Articles"}
   {:id "questions" :icon m.Icons/help_outline :selected-icon m.Icons/help_rounded :label "Questions"}
   {:id "search" :icon m.Icons/search_rounded :selected-icon m.Icons/search_rounded :label "Search"}
   {:id "create" :icon m.Icons/edit_outlined :selected-icon m.Icons/edit_rounded :label "Write"}
   {:id "bookmarks" :icon m.Icons/bookmark_border :selected-icon m.Icons/bookmark_rounded :label "Bookmarks"}
   {:id "notifications" :icon m.Icons/notifications_none :selected-icon m.Icons/notifications_rounded :label "Notify"}
   {:id "profile" :icon m.Icons/person_outline :selected-icon m.Icons/person_rounded :label "Profile"}])

(def mobile-tabs
  [{:id "home" :icon m.Icons/home_outlined :selected-icon m.Icons/home_rounded :label "Home"}
   {:id "explore" :icon m.Icons/explore_outlined :selected-icon m.Icons/explore :label "Explore"}
   {:id "create" :icon m.Icons/edit_outlined :selected-icon m.Icons/edit_rounded :label "Write"}
   {:id "notifications" :icon m.Icons/notifications_none :selected-icon m.Icons/notifications_rounded :label "Notify"}
   {:id "profile" :icon m.Icons/person_outline :selected-icon m.Icons/person_rounded :label "Profile"}])

(def ^:private ease (dart:core/Duration. .milliseconds 180))

(defn- destination [{:keys [id icon selected-icon label]} active?]
  (m/Padding
   .padding (m.EdgeInsets/symmetric .horizontal 9.0 .vertical 3.0)
   .child
   (m/AnimatedContainer
    .duration ease
    .clipBehavior m.Clip/antiAlias
    .decoration (m/BoxDecoration
                 .color (if active? theme/accent-soft theme/transparent)
                 .borderRadius (theme/r 17.0)
                 .border (m/Border.all
                          .color (if active? theme/divider-strong theme/transparent)
                          .width 1.0))
    .child
    (ui/tappable
     #(store/set-nav! id)
     17.0
     (m/Padding
      .padding (m.EdgeInsets/symmetric .horizontal 11.0 .vertical 15.0)
      .child
      (m/Column
       .mainAxisSize m.MainAxisSize/min
       .children
       [(m/Icon (if active? selected-icon icon)
                .size 21.0
                .color (if active? theme/accent theme/ink-faint))
        (m/SizedBox .height 10.0)
        (mg/text label {:size 12.5
                        :max-lines 1
                        :color (if active? theme/ink theme/ink-faint)
                        :weight (when active? m.FontWeight/w600)})]))))))

(defn- footer [user]
  (m/Padding
   .padding (m.EdgeInsets/symmetric .horizontal 12.0 .vertical 14.0)
   .child
   (if user
     (ui/tappable
      #(store/set-nav! "profile")
      theme/radius-pill
      (ui/avatar user 38.0))
     (ui/icon-button {:icon m.Icons/login_rounded
                      :on-tap #(store/push-named! "/login")}))))

(defn rail []
  (f/widget
   ;; Subscribing to the whole app-ui atom would rebuild the rail whenever an
   ;; unrelated key (explore tab, question filter) changes.
   :watch [selected-nav-id (f/sub store/app-ui :selected-nav-id)
           {:keys [user]} store/session]
   (m/Container
    .width 80.0
    .decoration (m/BoxDecoration
                 .color theme/surface
                 .border (m/Border .right (m/BorderSide .color theme/divider .width 1.0)))
    .child
    (m/SafeArea
     .right false
     .child
     (m/Column
      .children
      [(m/Padding
        .padding (m.EdgeInsets/symmetric .vertical 20.0)
        .child (ui/brand 40.0))
       (m/Container .height 1.0 .width 34.0 .color theme/divider)
       (m/Expanded
        .child
        (m/SingleChildScrollView
         .padding (m.EdgeInsets/symmetric .vertical 12.0)
         .child
         (m/Column
          .children
          (mapv (fn [t] (destination t (= (:id t) selected-nav-id))) tabs))))
       (m/Container .height 1.0 .width 34.0 .color theme/divider)
       (footer user)])))))
