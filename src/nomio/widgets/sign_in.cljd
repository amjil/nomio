(ns nomio.widgets.sign-in
  "Placeholder shown in tabs that need an account."
  (:require ["package:flutter/material.dart" :as m]
            [nomio.state.store :as store]
            [nomio.widgets.ui :as ui]))

(defn prompt
  ([] (prompt "Sign in to continue"))
  ([label]
   (ui/state-view {:icon m.Icons/lock_outline_rounded
                   :title label
                   :message "Reading lists and notifications live with your account"
                   :action-label "Sign in"
                   :action-icon m.Icons/login_rounded
                   :on-action #(store/push-named! "/login")})))
