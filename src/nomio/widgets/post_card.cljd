(ns nomio.widgets.post-card
  "Post preview card component: Responsible for displaying the post's cover, title, summary, tags, and meta-information.
   Fully styled with Tenger Blue design system for a modern, airy look.
   Upgraded to Content-Driven Sizing (IntrinsicWidth) for natural Mongolian LTR flow."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   [nomio.utils.tokens :as tokens]
   [nomio.utils.time-format :as time-format]))

;; =============================================================================
;; 1. Helper: Extract preview information from blocks
;; =============================================================================

(defn- extract-preview
  "Extracts cover image and plain text summary from rich text blocks."
  [blocks]
  (let [first-img (first (filter #(or (= (get % "type") "image") (= (get % :type) "image")) blocks))
        text-blocks (filter #(not= (get % "type") "image") blocks)
        ;; Extract the first 80 characters as a summary
        preview-text (apply str (take 80 (apply str (map #(or (get % "text") (get % "content") "") text-blocks))))
        
        raw-img-url (or (get first-img "url") (get-in first-img ["data" "url"]))]
    {:image-url (if (and raw-img-url (not (empty? raw-img-url))) raw-img-url nil)
     :content (if (empty? preview-text)
                "Хоосон байна"
                (str preview-text "..."))}))

;; =============================================================================
;; 2. Helper: Render Clickable Tag
;; =============================================================================

(defn- render-tag
  "Renders a single tag as a clickable pill with Tenger Blue styling. 
   Navigates to the Topic Screen when tapped."
  [ctx tag-name]
  (m/Padding
   .padding (m/EdgeInsets.only .bottom 12.0)
   .child
   (m/InkWell
    .onTap (fn []
             (m/Navigator.pushNamed ctx "/topic" .arguments {:tag tag-name})
             nil)
    .borderRadius (m/BorderRadius.circular 8.0)
    .child
    (m/Container
     .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 12.0)
     .decoration (m/BoxDecoration
                  .color tokens/primary-container
                  .borderRadius (m/BorderRadius.circular 8.0))
     .child
     (mgl/MongolText (str "# " tag-name)
                     .style (m/TextStyle .fontSize 12.0
                                         .color tokens/primary-color
                                         .fontWeight m.FontWeight/bold
                                         .fontFamily "OyunQaganTig"))))))

;; =============================================================================
;; 3. Core Card Component
;; =============================================================================

(defn post-card
  "Post preview card.
   Parameters:
   - :post Dictionary data of the post fetched from the backend.
   - :on-tap Callback function triggered when the card body is tapped."
  [{:keys [post on-tap]}]
  (f/widget
   :context ctx

   :let [blocks (or (get post "blocks") (get post :blocks) [])
         preview (extract-preview blocks)
         title (or (get post "title") (get post :title) "Гарчиггүй")
         tags (vec (or (get post "tags") (get post :tags) []))
         time-str (time-format/format-relative (or (get post "created_at") (get post "inserted_at") (get post :created_at)))
         author-id (or (get post "author_id") (get post :author_id) "")
         author-nickname (or (get post "author_nickname") (get post :author_nickname))
         author-username (or (get post "author_username") (get post :author_username))
         author-label (cond
                        (and author-nickname author-username)
                        (str author-nickname " @" author-username)
                        author-nickname author-nickname
                        author-username (str "@" author-username)
                        :else (str "Хэрэглэгч " author-id))]

   (m/Container
    .decoration (m/BoxDecoration
                 .color tokens/surface-color
                 .borderRadius (m/BorderRadius.circular 20.0)
                 .boxShadow tokens/tenger-shadow
                 .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
    .child
    (m/ClipRRect
     .borderRadius (m/BorderRadius.circular 19.0) ;; Slightly smaller than outer border to prevent clipping issues
     .child
     (m/Material
      .color m.Colors/transparent
      .child
      (m/InkWell
       .onTap on-tap
       .child
       ;; 🌟 FIX 1: Wrap in IntrinsicWidth to constrain the card to its natural content width
       (m/IntrinsicWidth
        .child
        (m/Column
         ;; 🌟 FIX 2: Stretch the cross axis so the Cover Image exactly matches the text width
         .crossAxisAlignment m.CrossAxisAlignment/stretch
         .children
         [;; ------------------------------------------
          ;; A. Top: Cover Image
          ;; ------------------------------------------
          (if (:image-url preview)
            ;; We use a fixed height container instead of AspectRatio to avoid infinite width errors
            (m/Container
             .height 120.0
             .child (m/Image.network (:image-url preview) .fit m.BoxFit/cover))

            ;; Fallback placeholder image
            (m/Container
             .height 120.0
             ;; 🌟 FIX 3: Removed `.width double/infinity`! IntrinsicWidth + stretch handles the width now.
             .color tokens/bg-color
             .child (m/Center .child (m/Icon m.Icons/article .color (.withOpacity tokens/text-secondary 0.3) .size 48.0))))

          ;; ------------------------------------------
          ;; B. Bottom: Text Area
          ;; ------------------------------------------
          (m/Expanded
           .child
           (m/Padding
            .padding (m/EdgeInsets.all 16.0)
            .child
            ;; 🌟 FIX 4: Add a minimum width constraint so cards don't get extremely skinny
            (m/Container
             .constraints (m/BoxConstraints .minWidth 140.0)
             .child
             (m/Row
              .crossAxisAlignment m.CrossAxisAlignment/start
              ;; 🌟 FIX 5: mainAxisSize must be min to prevent Row from demanding infinite width
              .mainAxisSize m.MainAxisSize/min
              .children
              [;; 1. Title
               (m/Padding
                .padding (m/EdgeInsets.only .right 12.0)
                .child
                (m/SizedBox
                 .width 24.0 ;; Fixed width column for title
                 .child
                 (mgl/MongolText title
                                 .style (m/TextStyle .fontSize 18.0
                                                     .fontFamily "OyunQaganTig"
                                                     .fontWeight m.FontWeight/bold
                                                     .color tokens/text-primary)
                                 .maxLines 10
                                 .overflow m.TextOverflow/ellipsis)))

               ;; 2. Summary
               ;; 🌟 FIX 6: Removed `m/Expanded`! The MongolText will now naturally dictate its own width based on maxLines.
               (mgl/MongolText (:content preview)
                               .style (m/TextStyle .fontSize 14.0
                                                   .fontFamily "OyunQaganTig"
                                                   .color tokens/text-secondary
                                                   .height 1.5)
                               .maxLines 5
                               .overflow m.TextOverflow/ellipsis)

               ;; 3. Topics / Tags
               (if (seq tags)
                 (m/Padding
                  .padding (m/EdgeInsets.only .left 12.0)
                  .child
                  (m/Column
                   .mainAxisAlignment m.MainAxisAlignment/start
                   .mainAxisSize m.MainAxisSize/min ;; Keep column tight
                   .children
                   (mapv #(render-tag ctx %) (take 2 tags))))
                 (m/SizedBox.shrink))

               ;; 4. Meta-information
               (m/Padding
                .padding (m/EdgeInsets.only .left 12.0)
                .child
                (m/Column
                 .mainAxisAlignment m.MainAxisAlignment/end
                 .crossAxisAlignment m.CrossAxisAlignment/center
                 .mainAxisSize m.MainAxisSize/min ;; Keep column tight
                 .children
                 [;; Clickable Author Section
                  (m/InkWell
                   .onTap (fn []
                            (m/Navigator.pushNamed ctx "/profile" .arguments {:id author-id})
                            nil)
                   .borderRadius (m/BorderRadius.circular 8.0)
                   .child
                   (m/Padding
                    .padding (m/EdgeInsets.all 4.0)
                    .child
                    (m/Column
                     .children [(m/Icon m.Icons/person .size 14.0 .color tokens/primary-color)
                                (m/SizedBox .height 6.0)
                                (mgl/MongolText author-label
                                                .style (m/TextStyle .fontSize 12.0 .color tokens/primary-color .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold))])))

                  (m/SizedBox .height 12.0)

                  ;; Publish time
                  (mgl/MongolText time-str
                                  .style (m/TextStyle .fontSize 11.0 .color tokens/text-secondary .fontFamily "OyunQaganTig"))]))]))))]))))))))