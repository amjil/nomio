(ns nomio.widgets.comments
  "Comment thread plus a compose dialog. The list stays collapsed to a
   count so the paper can use the width; writing happens in
   components.dialog/vertical-custom-dialog, wrapped with kb/wrap so
   Mongolian IME candidates paint (same pattern as mgl-mail-app)."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [components.dialog :as dialog]
            [rich-editor.components.text-field :as custom-tf]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.confirm :as confirm]
            [nomio.widgets.keyboard :as kb]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.paged :as paged]
            [nomio.widgets.reader-frame :as frame]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

;; "reply" in Mongolian script.
(def ^:private reply-label "ᠬᠠᠷᠢᠭᠤᠯᠬᠤ")

(defn- author-label [c]
  (or (get-in c [:author :display-name])
      (get-in c [:author :username])
      ""))

(defn- byline [c]
  (let [name (author-label c)]
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/center
     .children
     [(ui/top (ui/avatar (or (:author c) name) 28.0))
      (ui/gap-v 10)
      (mg/muted name)])))

(defn- reply-link [on-reply id]
  (ui/tappable
   #(on-reply id)
   theme/radius-sm
   (m/Padding
    .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 8.0)
    .child
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/center
     .children
     [(ui/top (m/Icon m.Icons/reply_rounded .size 15.0 .color theme/accent))
      (ui/gap-v 6)
      (mg/text reply-label {:size 12.5 :color theme/accent})]))))

(defn- reply-to-mark
  "Grey @author of the comment this one actually replied to. Only painted
   when that parent is not the thread root (a second-level-to-second-level
   reply still sits at depth 1)."
  [c]
  (if-let [src (:reply-to c)]
    (let [name (author-label src)]
      (if (str/blank? name)
        ui/nothing
        (m/Row
         .mainAxisSize m.MainAxisSize/min
         .children
         [(mg/text (str "@" name)
                   {:size 13.0 :color theme/ink-faint :height 1.3})
          (ui/gap-h 10)])))
    ui/nothing))

(defn- thread-step [child]
  (m/Padding
   .padding (m.EdgeInsets/only .top 32.0 .left 20.0)
   .child
   (m/Container
    .padding (m.EdgeInsets/only .left 12.0)
    .decoration (m/BoxDecoration
                 .border (m/Border .left (m/BorderSide
                                          .color theme/divider-strong
                                          .width 1.0)))
    .child child)))

(def ^:private reply-page-size 20)

(defn- replies-left
  "Replies still waiting on the server. What this session posted already sits in
   :pending-replies, so counting it as unloaded would both inflate the More
   badge and keep it on screen after the last window arrived."
  [c]
  (max 0 (- (or (:reply-count c) 0)
            (count (or (:replies c) []))
            (count (or (:pending-replies c) [])))))

(defn- more-replies-control [c on-more]
  (let [left (replies-left c)
        tap #(on-more (:id c))]
    (cond
      (= :paging (:replies-status c))
      (m/SizedBox
       .width 28.0 .height 28.0
       .child (m/CircularProgressIndicator
               .strokeWidth 1.8 .color theme/accent))

      (= :error (:replies-status c))
      (ui/ghost-action {:label "Retry"
                        :icon m.Icons/refresh_rounded
                        :tone theme/danger
                        :on-tap tap})

      :else
      (ui/tappable
       tap theme/radius-sm
       (m/Padding
        .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 8.0)
        .child
        (m/Column
         .mainAxisSize m.MainAxisSize/min
         .crossAxisAlignment m.CrossAxisAlignment/center
         .children
         [(ui/top (m/Icon m.Icons/keyboard_arrow_right_rounded
                          .size 15.0 .color theme/accent))
          (ui/gap-v 6)
          (mg/text (str left)
                   {:size 12.5 :color theme/accent :weight m.FontWeight/w600})
          (ui/gap-v 6)
          (mg/text "More" {:size 12.5 :color theme/accent})]))))))

(defn- mine? [c]
  (when-let [me (store/current-user)]
    (= (:id me) (or (:author-id c) (get-in c [:author :id])))))

(defn- owner-col [icon color on-tap]
  (ui/tappable
   on-tap theme/radius-sm
   (m/Padding
    .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 8.0)
    .child (ui/top (m/Icon icon .size 15.0 .color color)))))

(defn- owner-controls [c on-edit on-delete]
  (m/Row
   .mainAxisSize m.MainAxisSize/min
   .children
   [(owner-col m.Icons/edit_outlined theme/ink-muted #(on-edit c))
    (ui/gap-h 4)
    (owner-col m.Icons/delete_outline_rounded theme/danger #(on-delete c))]))

(defn- comment-node
  "One comment and, at depth 0 only, its replies. A Row, not a Column: the
   byline, body, reply control and nested replies step left to right so
   each vertical line of Mongolian can run the full height of the pane.
   Depth is capped at two (root + reply); replies do not nest further, but
   a second-level comment can still be replied to — the new one hangs next
   to its siblings with a grey @author pointing at the original."
  [c {:keys [on-reply on-more on-edit on-delete] :as handlers} depth]
  (let [leaf? (>= depth 1)
        kids (when-not leaf? (or (:replies c) []))
        more? (and (not leaf?)
                   on-more
                   (pos? (replies-left c)))
        own? (boolean (mine? c))]
    (m/Row
     .crossAxisAlignment m.CrossAxisAlignment/start
     .mainAxisSize m.MainAxisSize/min
     .children
     (into
      [(byline c)
       (ui/gap-h 14)
       (reply-to-mark c)
       (mg/text (or (:content c) "") {:size 14.5 :height 1.3})
       (if on-reply (ui/gap-h 10) ui/nothing)
       (if on-reply (reply-link on-reply (:id c)) ui/nothing)
       (if own? (ui/gap-h 8) ui/nothing)
       (if own? (owner-controls c on-edit on-delete) ui/nothing)]
      ;; Replies hang off the right of the root. Top indent is the
      ;; nested step in vertical script (the analogue of a left gutter
      ;; in horizontal text); the rule marks the thread. Locally posted
      ;; replies that belong after the unloaded window sit past More.
      (let [kid-nodes (mapv (fn [k]
                              (thread-step (comment-node k handlers (inc depth))))
                            kids)
            pending (when-not leaf? (or (:pending-replies c) []))]
        (cond-> kid-nodes
          more? (conj (thread-step (more-replies-control c on-more)))
          (seq pending)
          (into (mapv (fn [k]
                        (thread-step (comment-node k handlers (inc depth))))
                      pending))))))))

(defn- thread-card [c handlers]
  (ui/panel
   ;; No locked width: MongolText wraps to the next column when it runs
   ;; out of height, and the card grows with it.
   {:margin (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 14.0)
    :pad 16.0
    :radius theme/radius-md}
   (comment-node c handlers 0)))

(defn- close-dialog! [dctx]
  (kb/dismiss!)
  (when (.-mounted ^m/BuildContext dctx)
    (.pop (m/Navigator.of dctx)))
  nil)

(defn- send-plain! [ctx dctx ctrl !busy submit! success]
  (let [content (str/trim (or (.-text ^m/TextEditingController ctrl) ""))]
    (cond
      (str/blank? content)
      (toast/info! ctx "Write something first")

      @!busy
      nil

      :else
      (do
        (reset! !busy true)
        (-> (submit! content)
            (.then (fn [_]
                     (close-dialog! dctx)
                     (toast/success! ctx success)
                     nil))
            (.catchError (fn [e]
                           (reset! !busy false)
                           (toast/error! ctx e)
                           nil))))))
  nil)

(defn- field-box [ctrl focus !ime]
  (m/GestureDetector
   .behavior m.HitTestBehavior/opaque
   .onTap (fn [] (.requestFocus ^m/FocusNode focus) nil)
   .child
   (m/Container
    .padding (m.EdgeInsets/all 8.0)
    .alignment m.Alignment/topLeft
    .decoration (m/BoxDecoration
                 .color theme/surface-alt
                 .border (m/Border.all .color theme/divider)
                 .borderRadius (theme/r theme/radius-md))
    .child
    (custom-tf/text-field
     !ime
     {:controller ctrl
      :focus-node focus
      :autofocus true
      :hint "Write a comment"
      :max-lines nil
      :style (m/TextStyle .fontSize 16.0
                          .fontFamily theme/font-family
                          .color theme/ink)
      :decoration (m/InputDecoration .border m/InputBorder.none)}))))

(defn- dialog-action [label on-tap accent?]
  (mgl/MongolTextButton
   .onPressed on-tap
   .child (mgl/MongolText
           label
           .style (m/TextStyle .fontFamily theme/font-family
                               .fontSize 14.0
                               .color (if accent? theme/accent theme/ink-muted)
                               .fontWeight (if accent? m.FontWeight/w600 m.FontWeight/w400)))))

(defn- compose-body [dctx ctrl focus !ime title on-send send-label !busy]
  (f/widget
   :watch [busy? !busy]
   (m/Padding
    .padding (m.EdgeInsets/all 18.0)
    .child
    (m/Row
     .crossAxisAlignment m.CrossAxisAlignment/stretch
     .children
     [(m/Container
       .alignment m.Alignment/topCenter
       .padding (m.EdgeInsets/only .right 16.0)
       .decoration (m/BoxDecoration
                    .border (m/Border .right (m/BorderSide .color theme/divider .width 1.0)))
       .child (mg/title title 16.0))
      (m/Expanded .child (field-box ctrl focus !ime))
      (m/Padding
       .padding (m.EdgeInsets/only .left 16.0)
       .child
       (m/Column
        .mainAxisAlignment m.MainAxisAlignment/end
        .children
        [(dialog-action "Cancel" #(close-dialog! dctx) false)
         (ui/gap-v 16)
         (dialog-action send-label (when-not busy? on-send) true)]))]))))

(defn- text-dialog!
  [ctx {:keys [title initial send-label submit! success]}]
  (m/showDialog
   .context ctx
   .builder
   (fn [dctx]
     (f/widget
      :managed [ctrl (m/TextEditingController. .text (or initial ""))
                focus (m/FocusNode.)]
      :let [!ime (atom {:external-keyboard-delegate nil})
            !busy (atom false)
            send! #(send-plain! ctx dctx ctrl !busy submit! success)]
      (dialog/vertical-custom-dialog
       {:width-factor 0.72
        :height-factor 0.72
        :child (kb/wrap (compose-body dctx ctrl focus !ime
                                     (or title "Comment")
                                     send!
                                     (or send-label "Send")
                                     !busy)
                        "comment-dialog-ime")}))))
  nil)

(defn compose!
  "Open the comment dialog. Guests are sent to sign-in first."
  [ctx target-type target-id & {:keys [parent-id on-posted]}]
  (store/require-auth!
   (fn []
     (text-dialog! ctx {:title (if parent-id reply-label "Comment")
                        :send-label "Send"
                        :success "Comment posted"
                        :submit!
                        (fn [content]
                          (-> (api/create-comment!
                               (cond-> {:target-type target-type
                                        :target-id target-id
                                        :content content}
                                 parent-id (assoc :parent-id parent-id)))
                              (.then (fn [posted]
                                       (when on-posted (on-posted posted))
                                       posted))))})))
  nil)

(defn- loaded-count [st]
  (+ (count (or (:items st) []))
     (count (or (:pinned st) []))))

(defn- count-mark [st]
  (cond
    (some? (:comment-total st))
    (mg/text (str (:comment-total st))
             {:size 13.0 :color theme/ink-muted :weight m.FontWeight/w600})

    (= :error (:status st))
    (m/Icon m.Icons/error_outline_rounded .size 14.0 .color theme/danger)

    (= :ok (:status st))
    (mg/text (str (loaded-count st))
             {:size 13.0 :color theme/ink-muted :weight m.FontWeight/w600})

    :else
    (m/SizedBox
     .width 14.0 .height 14.0
     .child (m/CircularProgressIndicator
             .strokeWidth 1.8 .color theme/accent))))

(defn- rail [st on-open on-write]
  (m/Container
   .decoration (m/BoxDecoration
                .border (m/Border .left (m/BorderSide .color theme/divider .width 1.0)))
   .child
   (m/Padding
    .padding (m.EdgeInsets/fromLTRB 10.0 18.0 10.0 18.0)
    .child
    (m/Column
     .mainAxisAlignment m.MainAxisAlignment/spaceBetween
     .crossAxisAlignment m.CrossAxisAlignment/center
     .children
     [(ui/tappable
       on-open theme/radius-sm
       (m/Padding
        .padding (m.EdgeInsets/symmetric .horizontal 4.0 .vertical 6.0)
        .child
        (m/Column
         .mainAxisSize m.MainAxisSize/min
         .crossAxisAlignment m.CrossAxisAlignment/center
         .children
         [(m/Icon m.Icons/mode_comment_outlined .size 15.0 .color theme/ink-faint)
          (ui/gap-v 10)
          (mg/label "Comments")
          (ui/gap-v 10)
          (count-mark st)])))
      (ui/icon-button {:icon m.Icons/edit_outlined
                       :size 36.0
                       :active? true
                       :on-tap on-write})]))))

(defn- patch-thread! [!st id f]
  (let [touch (fn [xs] (mapv (fn [c] (if (= (:id c) id) (f c) c)) xs))]
    (swap! !st (fn [st]
                 (-> st
                     (update :items touch)
                     (update :pinned #(touch (or % [])))))))
  nil)

(defn- ensure-author [posted]
  (if (get-in posted [:author :username])
    posted
    (let [u (store/current-user)]
      (cond-> posted
        u (assoc :author {:id (:id u)
                          :username (:username u)
                          :display-name (:display-name u)}
                 :author-id (:id u))))))

(defn- find-in [cs id]
  (some #(when (= (:id %) id) %) cs))

(defn- with-reply-to [posted root]
  (let [pid (:parent-id posted)
        rid (:id root)]
    (if (or (nil? pid) (= pid rid))
      posted
      (if-let [src (or (find-in (or (:replies root) []) pid)
                       (find-in (or (:pending-replies root) []) pid))]
        (assoc posted :reply-to src)
        posted))))

(defn- add-reply [root posted]
  (let [c (with-reply-to posted root)
        loaded (vec (or (:replies root) []))
        pending (vec (or (:pending-replies root) []))
        seen (into #{} (map :id) (concat loaded pending))]
    (if (contains? seen (:id c))
      root
      (let [caught-up? (not (pos? (replies-left root)))]
        (if caught-up?
          (-> root
              (assoc :replies (conj loaded c))
              (update :reply-count #(inc (or % (count loaded)))))
          (-> root
              (assoc :pending-replies (conj pending c))
              (update :reply-count #(inc (or % (+ (count loaded) (count pending)))))))))))

(defn- accept-posted!
  "Drop the created comment into the open strip instead of refetching page 1.
   A new root belongs at the chronological end; a reply hangs on its thread."
  [!st posted]
  (when-let [c (and posted (ensure-author posted))]
    (if (nil? (:parent-id c))
      (paged/pin-end! !st (assoc c :replies [] :reply-count 0))
      (let [rid (or (:root-id c) (:parent-id c))]
        (patch-thread! !st rid #(add-reply % c))))
    (swap! !st update :comment-total #(inc (or % 0))))
  nil)

(defn- map-deep [c id f]
  (if (= (:id c) id)
    (f c)
    (-> c
        (update :replies #(mapv (fn [k] (map-deep k id f)) (or % [])))
        (update :pending-replies
                #(mapv (fn [k] (map-deep k id f)) (or % []))))))

(defn- apply-edit! [!st updated]
  (when (and updated (:id updated))
    (let [id (:id updated)
          bump (fn [c]
                 (assoc c
                        :content (:content updated)
                        :content-spans (or (:content-spans updated) [])
                        :updated-at (:updated-at updated)))]
      (swap! !st (fn [st]
                   (let [touch (fn [xs] (mapv #(map-deep % id bump) xs))]
                     (-> st
                         (update :items touch)
                         (update :pinned #(touch (or % [])))))))))
  nil)

(defn- drop-id [xs id]
  (into [] (remove #(= (:id %) id)) (or xs [])))

(defn- remove-from-thread [c id]
  (if (= (:id c) id)
    nil
    (let [replies (drop-id (:replies c) id)
          pending (drop-id (:pending-replies c) id)
          gone? (or (not= (count replies) (count (or (:replies c) [])))
                    (not= (count pending) (count (or (:pending-replies c) []))))]
      (cond-> (assoc c :replies replies :pending-replies pending)
        gone? (update :reply-count #(max 0 (dec (or % 0))))))))

(defn- remove-comment! [!st id]
  (swap! !st
         (fn [st]
           (let [root? (or (some #(= (:id %) id) (:items st))
                           (some #(= (:id %) id) (or (:pinned st) [])))
                 touch (fn [xs]
                         (if root?
                           (drop-id xs id)
                           (into [] (keep #(remove-from-thread % id)) xs)))]
             (-> st
                 (update :items touch)
                 (update :pinned #(touch (or % [])))
                 (update :comment-total #(max 0 (dec (or % 0))))))))
  nil)

(defn- edit-comment! [ctx !st c]
  (text-dialog! ctx {:title "Edit"
                     :initial (or (:content c) "")
                     :send-label "Save"
                     :success "Comment updated"
                     :submit!
                     (fn [content]
                       (-> (api/update-comment! (:id c) {:content content
                                                         :content-spans []})
                           (.then (fn [updated]
                                    (apply-edit! !st updated)
                                    updated))))})
  nil)

(defn- delete-comment! [ctx !st c]
  (confirm/show! ctx {:title "Delete this comment?"
                      :confirm-label "Delete"
                      :danger? true
                      :on-confirm
                      (fn []
                        (-> (api/delete-comment! (:id c))
                            (.then (fn [_]
                                     (when (.-mounted ^m/BuildContext ctx)
                                       (remove-comment! !st (:id c))
                                       (toast/success! ctx "Comment deleted"))
                                     nil))
                            (.catchError (fn [e]
                                           (when (.-mounted ^m/BuildContext ctx)
                                             (toast/error! ctx e))
                                           nil))))})
  nil)

(defn- load-more-replies! [ctx !st id]
  (let [st @!st
        gen (:gen st)
        root (or (some #(when (= (:id %) id) %) (:items st))
                 (some #(when (= (:id %) id) %) (or (:pinned st) [])))]
    (when (and root
               (.-mounted ^m/BuildContext ctx)
               (not= :paging (:replies-status root))
               (pos? (replies-left root)))
      (patch-thread! !st id #(assoc % :replies-status :paging))
      (-> (api/comment-replies id {:limit reply-page-size
                                   :offset (count (or (:replies root) []))})
          (.then (fn [page]
                   (when (and (.-mounted ^m/BuildContext ctx)
                              (= gen (:gen @!st)))
                     (patch-thread! !st id
                                    (fn [c]
                                      (let [seen (into #{} (map :id) (:replies c))
                                            fresh (into [] (remove #(contains? seen (:id %))
                                                                   (or (:items page) [])))
                                            loaded (into (vec (or (:replies c) [])) fresh)
                                            loaded-ids (into #{} (map :id) loaded)
                                            pending (into [] (remove #(contains? loaded-ids (:id %))
                                                                     (or (:pending-replies c) [])))
                                            n (count loaded)
                                            ;; Same rule as paged/ended?: an empty window
                                            ;; or the server saying stop both hide More,
                                            ;; so a stuck offset cannot loop.
                                            done? (or (empty? fresh)
                                                      (false? (:has-more page)))
                                            total (if done?
                                                    (+ n (count pending))
                                                    (or (:reply-total page)
                                                        (:reply-count c)
                                                        n))]
                                        (assoc c
                                               :replies loaded
                                               :pending-replies pending
                                               :reply-count total
                                               :replies-status :ok)))))
                   nil))
          (.catchError (fn [_]
                         (when (and (.-mounted ^m/BuildContext ctx)
                                    (= gen (:gen @!st)))
                           (patch-thread! !st id #(assoc % :replies-status :error)))
                         nil)))))
  nil)

(defn column
  "Trailing comments column. Collapsed to a count until opened; writing
   always goes through `compose!` so the paper keeps its width. Roots page
   through paged/strip; each card carries a preview of that thread's replies
   and can ask for the rest. A newly posted comment is inserted locally
   rather than refetching page 1.

   Pass `:open-atom` to share open state with a sibling pane (question
   answers). `:on-open` runs just before the column expands, so a phone
   can collapse the other rail first."
  [target-type target-id & {:keys [open-atom on-open]}]
  (f/widget
   :context ctx
   :let [!open (or open-atom (atom false))
         !st (paged/state)
         fetch (fn [opts] (api/comments target-type target-id opts))
         _ (paged/load-more! ctx !st fetch)
         more! (fn [id] (load-more-replies! ctx !st id) nil)
         show! (fn []
                 (when on-open (on-open))
                 (reset! !open true)
                 nil)]
   :watch [open? !open
           st !st
           _sess store/session]
   (let [write! (fn [pid]
                  (compose! ctx target-type target-id
                            :parent-id pid
                            :on-posted (fn [posted]
                                         (accept-posted! !st posted)
                                         (show!)))
                  nil)
         handlers {:on-reply write!
                   :on-more more!
                   :on-edit #(edit-comment! ctx !st %)
                   :on-delete #(delete-comment! ctx !st %)}]
     (if-not open?
       (rail st show! #(write! nil))
       (m/Expanded
        .flex 2
        .child
        (frame/pane
         {:label "Comments" :icon m.Icons/mode_comment_outlined}
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/stretch
          .children
          [(m/Expanded
            .child (paged/strip !st fetch #(thread-card % handlers)))
           (m/Padding
            .padding (m.EdgeInsets/only .left 4.0 .right 8.0 .top 12.0 .bottom 12.0)
            .child
            (m/Column
             .mainAxisAlignment m.MainAxisAlignment/spaceBetween
             .crossAxisAlignment m.CrossAxisAlignment/center
             .children
             [(ui/icon-button {:icon m.Icons/close_rounded
                               :size 32.0
                               :on-tap #(reset! !open false)})
              (ui/icon-button {:icon m.Icons/edit_outlined
                               :size 36.0
                               :active? true
                               :on-tap #(write! nil)})]))])))))))
