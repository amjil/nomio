(ns nomio.widgets.comments
  "Comments use mgl-richtext-editor (simple-editor), not the block editor.
   Laid out for traditional vertical Mongolian: a line grows downward,
   the next line steps to the right."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [rich-editor.components.simple-editor :as se]
            [nomio.core.api :as api]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.toast :as toast]
            [nomio.widgets.ui :as ui]))

(def ^:private post-id "main-post-id")

;; "reply" in Mongolian script.
(def ^:private reply-label "ᠬᠠᠷᠢᠭᠤᠯᠬᠤ")

(defn- author-label [c]
  (or (get-in c [:author :display-name])
      (get-in c [:author :username])
      ""))

(defn- byline [c]
  (let [name (author-label c)]
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/center
     .children
     [(ui/top (ui/avatar name 28.0))
      (ui/gap-v 10)
      (mg/muted name)])))

(defn- reply-link [on-reply id]
  (ui/tappable
   #(on-reply id)
   theme/radius-sm
   (m/Padding
    .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 8.0)
    .child
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/center
     .children
     [(ui/top (m/Icon m.Icons/reply_rounded .size 15.0 .color theme/accent))
      (ui/gap-v 6)
      (mg/text reply-label {:size 12.5 :color theme/accent})]))))

(defn- by-id-map [comments]
  (into {} (map (juxt :id identity) comments)))

(defn- thread-root-id
  "Walk parent pointers until a comment with no parent."
  [c by-id]
  (loop [cur c]
    (if-let [parent (get by-id (:parent-id cur))]
      (recur parent)
      (:id cur))))

(defn- two-level-by-parent
  "Roots stay roots. A reply-to-a-reply is rehung off the thread root so
   it still shows — as a sibling of the first reply, never a third indent."
  [comments]
  (let [by-id (by-id-map comments)]
    (->> comments
         (map (fn [c]
                (if (:parent-id c)
                  (let [rid (thread-root-id c by-id)]
                    (if (= rid (:id c)) c (assoc c :parent-id rid)))
                  c)))
         (group-by :parent-id))))

(defn- comment-node
  "One comment and, at depth 0 only, its replies. A Row, not a Column: the
   byline, body, reply control and nested replies step left to right so
   each vertical line of Mongolian can run the full height of the pane.
   Depth is capped at two (root + reply); replies do not nest further."
  [c by-parent on-reply depth]
  (let [leaf? (>= depth 1)
        kids (when-not leaf? (or (get by-parent (:id c)) []))
        reply? (and on-reply (not leaf?))]
    (m/Row
     .crossAxisAlignment m.CrossAxisAlignment/start
     .mainAxisSize m.MainAxisSize/min
     .children
     (into
      [(byline c)
       (ui/gap-h 14)
       (mg/text (or (:content c) "") {:size 14.5 :height 1.3})
       (if reply? (ui/gap-h 10) ui/nothing)
       (if reply? (reply-link on-reply (:id c)) ui/nothing)]
      ;; Replies hang off the right of the root. Top indent is the
      ;; nested step in vertical script (the analogue of a left gutter
      ;; in horizontal text); the rule marks the thread.
      (map (fn [k]
             (m/Padding
              .padding (m.EdgeInsets/only .top 32.0 .left 20.0)
              .child
              (m/Container
               .padding (m.EdgeInsets/only .left 12.0)
               .decoration (m/BoxDecoration
                            .border (m/Border .left (m/BorderSide
                                                     .color theme/divider-strong
                                                     .width 1.0)))
               .child (comment-node k by-parent on-reply (inc depth)))))
           kids)))))

(defn tree
  ([comments] (tree comments nil))
  ([comments on-reply]
   (let [by-parent (two-level-by-parent comments)
         roots (or (get by-parent nil) [])]
     (if (empty? roots)
       (ui/state-view {:icon m.Icons/mode_comment_outlined
                       :title "No comments yet"})
       (m/ListView
        .scrollDirection m.Axis/horizontal
        .padding (m.EdgeInsets/all 12.0)
        .children
        (mapv (fn [c]
                (ui/panel
                 ;; No locked width: MongolText wraps to the next column
                 ;; when it runs out of height, and the card grows with it.
                 {:margin (m.EdgeInsets/only .right 14.0)
                  :pad 16.0
                  :radius theme/radius-md}
                 (comment-node c by-parent on-reply 0)))
              roots))))))

(defn- send! [ctx !ed !tick !reply target-type target-id on-posted]
  (store/require-auth!
   (fn []
     (let [content (or (get-in @!ed [:blocks post-id :content]) "")
           spans (or (get-in @!ed [:blocks post-id :content-spans]) [])]
       (if (str/blank? content)
         (toast/info! ctx "Write something first")
         (-> (api/create-comment!
              (cond-> {:target-type target-type
                       :target-id target-id
                       :content (str/trim content)
                       :content-spans spans}
                @!reply (assoc :parent-id @!reply)))
             (.then (fn [_]
                      (when (.-mounted ^m/BuildContext ctx)
                        (reset! !ed @(se/init-simple-state))
                        (reset! !reply nil)
                        (swap! !tick inc)
                        (when on-posted (on-posted))
                        (toast/success! ctx "Comment posted"))
                      nil))
             (.catchError (fn [e]
                            (when (.-mounted ^m/BuildContext ctx)
                              (toast/error! ctx e))
                            nil)))))))
  nil)

(defn- replying-chip [!reply]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .crossAxisAlignment m.CrossAxisAlignment/center
   .children
   [(ui/icon-button {:icon m.Icons/close_rounded
                     :size 26.0
                     :on-tap #(reset! !reply nil)})
    (ui/gap-v 8)
    (m/Icon m.Icons/reply_rounded .size 15.0 .color theme/accent)
    (ui/gap-v 6)
    (mg/text reply-label {:size 12.5 :color theme/accent})]))

(defn composer
  [target-type target-id & {:keys [on-posted parent-id !reply-to]}]
  (f/widget
   :context ctx
   ;; State lives in :let so a rebuild does not discard the draft.
   :let [!ed (se/init-simple-state)
         !tick (atom 0)
         !actual-reply (or !reply-to (atom parent-id))]
   :watch [_ !tick
           reply !actual-reply]
   (ui/panel
    {:pad 8.0
     :width 168.0
     :radius theme/radius-lg
     :color theme/surface}
    ;; One chrome rail on the trailing edge. Chip and send stacked
    ;; vertically share a single column of width, so a narrow pane
    ;; cannot overflow the Row the way three side-by-side children did.
    (m/Row
     .crossAxisAlignment m.CrossAxisAlignment/stretch
     .children
     [(m/Expanded .child (se/simple-editor !ed))
      (ui/gap-h 6)
      (m/Column
       .mainAxisAlignment m.MainAxisAlignment/spaceBetween
       .crossAxisAlignment m.CrossAxisAlignment/center
       .children
       [(if reply (replying-chip !actual-reply) ui/nothing)
        (ui/icon-button {:icon m.Icons/send_rounded
                         :active? true
                         :size 36.0
                         :on-tap #(send! ctx !ed !tick !actual-reply
                                         target-type target-id on-posted)})])]))))
