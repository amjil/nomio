(ns nomio.widgets.filter-bar
  "Radio-style column of capsules — the filter control every list page uses."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.widgets.ui :as ui]))

(defn single-select
  "`options` is [[value label] ...]. `on-change` receives the newly selected
   value. Re-tapping the active capsule is a no-op rather than a clear, since
   every page these sit on needs *some* filter applied."
  [options default on-change]
  (f/widget
   :let [!sel (atom default)
         choose! (fn [v]
                   (when (not= v @!sel)
                     (reset! !sel v)
                     (on-change v))
                   nil)]
   :watch [sel !sel]
   (m/Column
    .mainAxisSize m.MainAxisSize/min
    .crossAxisAlignment m.CrossAxisAlignment/start
    .children
    (into []
          (comp (map (fn [[value label]]
                       (ui/pill {:label label
                                 :active? (= value sel)
                                 :on-tap #(choose! value)})))
                (interpose (ui/gap-v 10)))
          options))))
