(ns nomio.widgets.paged
  "Infinite-scroll version of the horizontal card strip.

   A fetch resolves to {:items [...] :has-more bool}, where :has-more is the
   server's meta. Feeds still get de-duplicated by id, which both guards against
   an endpoint that ignores the window and lets the strip end cleanly if the
   meta is ever missing."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.refresh :as rfr]
            [nomio.widgets.ui :as ui]))

(def ^:private page-size 20)

;; Start loading this far (in px) before the trailing edge.
(def ^:private prefetch-extent 600.0)

;; :gen rises whenever the feed underneath changes — a new tab, a reload, a
;; refresh. A response carrying a stale :gen is dropped, so a slow page-2 that
;; lands after the reader switched tabs cannot append to the wrong list.
(def ^:private blank
  {:items [] :pinned [] :status :idle :error nil :done? false
   :offset 0 :gen 0 :scroll-to-end? false})

(defn- restart
  "Back to empty, but on a new generation so replies to the old one are ignored."
  [st]
  (assoc blank :gen (inc (:gen st))))

;; :loading is the only one that blanks the strip — it means nothing is on
;; screen yet. :paging appends, :refreshing replaces under the existing cards.
(def ^:private in-flight #{:loading :paging :refreshing})

(defn state []
  (atom blank))

(defn clear!
  "Empties the strip and abandons any reply still in flight. For a feed whose
   input went away, like a search box the reader emptied."
  [!st]
  (swap! !st restart)
  nil)

(defn- ended?
  "The server's own answer wins. A page with nothing unseen in it ends the feed
   regardless — an endpoint that ignores the window would otherwise loop — and
   a short page is the fallback when no meta came back at all."
  [page fresh n]
  (cond
    (empty? fresh) true
    (contains? page :has-more) (not (:has-more page))
    :else (< n page-size)))

(defn- absorb [st page]
  (let [items (:items page)
        seen (into #{} (map :id) (:items st))
        fresh (into [] (remove #(contains? seen (:id %))) items)]
    (cond-> (assoc st
                   :status :ok
                   :error nil
                   :failed nil
                   :items (into (:items st) fresh)
                   :pinned (into [] (remove #(contains? (into #{} (map :id) (into (:items st) fresh)) (:id %))
                                            (or (:pinned st) [])))
                   :offset (+ (:offset st) (count items))
                   :done? (ended? page fresh (count items)))
      (contains? page :comment-total)
      (assoc :comment-total (max (int (or (:comment-total st) 0))
                                 (int (:comment-total page))))
      (contains? page :total)
      (assoc :total (int (:total page))))))

(defn- current?
  "A reply is worth keeping only if its generation is still on screen — and only
   if the strip itself is, since writing to a disposed State crashes."
  [ctx !st g]
  (and (.-mounted ^m/BuildContext ctx) (= g (:gen @!st))))

(defn- shown
  "Server windows, then items posted this session that belong after them."
  [st]
  (into (vec (or (:items st) [])) (or (:pinned st) [])))

(defn pin-end!
  "Place `item` at the chronological end of the full list. If every server
   window is already on screen it joins :items; otherwise it stays in :pinned
   so later pages do not leave it sitting in the middle."
  [!st item]
  (when (and item (:id item))
    (swap! !st
           (fn [st]
             (let [id (:id item)]
               (if (some #(= (:id %) id) (shown st))
                 st
                 (-> (if (:done? st)
                       (update st :items (fnil conj []) item)
                       (update st :pinned (fnil conj []) item))
                     (assoc :status :ok :error nil :scroll-to-end? true)))))))
  nil)

(defn load-more!
  "Fetches the next window unless one is already in flight or the feed ended.
   `fetch` takes {:limit n :offset n} and resolves to {:items [...] :has-more b}.
   Returns the in-flight future, or nil when the call was a no-op."
  [ctx !st fetch]
  (let [{:keys [status done? offset items pinned gen]} @!st
        empty? (and (empty? items) (empty? (or pinned [])))]
    (when-not (or done? (contains? in-flight status))
      (swap! !st assoc :status (if empty? :loading :paging))
      (-> (fetch {:limit page-size :offset offset})
          (.then (fn [page]
                   (when (current? ctx !st gen)
                     (swap! !st absorb page))
                   nil))
          (.catchError (fn [e]
                         (when (current? ctx !st gen)
                           (swap! !st assoc :status :error :error e :failed :paging))
                         nil))))))

(defn reload!
  "Drops everything and fetches the first window again."
  [ctx !st fetch]
  (swap! !st restart)
  (load-more! ctx !st fetch))

(defn refresh!
  "Refetches the first window while leaving the current cards on screen, and
   returns that future — a pull-to-refresh indicator animates until it settles,
   so the strip it is attached to has to stay mounted meanwhile."
  [ctx !st fetch]
  (let [g (inc (:gen @!st))]
    (swap! !st assoc :status :refreshing :gen g)
    (-> (fetch {:limit page-size :offset 0})
        (.then (fn [page]
                 (when (current? ctx !st g)
                   (swap! !st
                          (fn [st]
                            (absorb (assoc blank
                                           :gen (:gen st)
                                           :pinned (or (:pinned st) [])
                                           :comment-total (:comment-total st)
                                           :total (:total st))
                                    page))))
                 nil))
        (.catchError (fn [e]
                       (when (current? ctx !st g)
                         (swap! !st assoc :status :error :error e :failed :refresh))
                       nil)))))

(defn- near-end? [^m/ScrollController ctrl]
  (and (.-hasClients ctrl)
       (let [pos (.-position ctrl)]
         (>= (.-pixels pos) (- (.-maxScrollExtent pos) prefetch-extent)))))

(defn- attach-scroll
  "Bundles the controller with its listener so both can be torn down together."
  [ctx !st fetch]
  (let [ctrl (m/ScrollController.)
        on-scroll (fn [] (when (near-end? ctrl) (load-more! ctx !st fetch)) nil)]
    (.addListener ctrl on-scroll)
    {:ctrl ctrl :on-scroll on-scroll}))

;; :managed threads the :dispose value, so it has to be a symbol.
(defn- detach-scroll! [{:keys [ctrl on-scroll]}]
  (.removeListener ^m/ScrollController ctrl on-scroll)
  (.dispose ^m/ScrollController ctrl)
  nil)

(defn- jump-end! [^m/ScrollController ctrl]
  (when (.-hasClients ctrl)
    (let [end (.-maxScrollExtent (.-position ctrl))]
      (when (pos? end)
        (.jumpTo ctrl end))))
  nil)

(defn- reveal-end! [ctx !st ^m/ScrollController ctrl]
  (m/WidgetsBinding.instance.addPostFrameCallback
   (fn [_]
     (when (.-mounted ^m/BuildContext ctx)
       (jump-end! ctrl)
       (swap! !st assoc :scroll-to-end? false))
     nil))
  nil)

(defn- vacant
  "An empty feed still needs a way back. The pull gesture lives on the list, so
   with no cards to drag there would otherwise be no way to refetch at all —
   and a screen like /tags/:slug has no heading button to fall back on."
  [retry]
  (ui/state-view {:icon m.Icons/inbox_outlined
                  :title "Nothing here yet"
                  :message "Pull the strip to the right to look again"
                  :action-label "Reload"
                  :on-action retry}))

(defn- trailer [st retry]
  (cond
    (= :paging (:status st))
    (m/Padding
     .padding (m.EdgeInsets/symmetric .horizontal 28.0)
     .child (ui/spinner))

    (= :error (:status st))
    (m/Padding
     .padding (m.EdgeInsets/symmetric .horizontal 20.0)
     .child (m/Center
             .child (ui/ghost-action {:label "Retry"
                                      :icon m.Icons/refresh_rounded
                                      :tone theme/danger
                                      :on-tap retry})))

    :else (m/SizedBox.shrink)))

(defn strip
  "Horizontal strip of `card-fn` items that pulls the next page as it nears the
   trailing edge, and refetches from scratch when dragged to the right."
  [!st fetch card-fn]
  (f/widget
   :context ctx
   :managed [scroll (attach-scroll ctx !st fetch) :dispose detach-scroll!]
   :watch [st !st]
   (let [items (shown st)
         n (count items)
         ;; A trailing slot costs a separator too, so it is only worth adding
         ;; while there is something to put in it.
         tail? (contains? #{:paging :error} (:status st))
         more! (fn [] (load-more! ctx !st fetch) nil)
         again! (fn [] (reload! ctx !st fetch) nil)
         ;; A failed pull-to-refresh must retry that refresh, not page-2:
         ;; load-more! is a no-op when the feed was already done.
         retry-tail! (fn []
                       (if (= :refresh (:failed st))
                         (do (refresh! ctx !st fetch) nil)
                         (more!)))
         _ (when (:scroll-to-end? st)
             (reveal-end! ctx !st (:ctrl scroll)))]
     (cond
       (and (empty? items) (= :error (:status st)))
       (asy/view !st (fn [_] (asy/empty-state)) :retry again!)

       (empty? items)
       (if (= :loading (:status st)) (ui/skeleton-strip) (vacant again!))

       :else
       (rfr/strip
        {:scroll-controller (:ctrl scroll)
         :item-count (if tail? (inc n) n)
         :item-builder (fn [_ i]
                         (if (< (int i) n)
                           (card-fn (nth items (int i)))
                           (trailer st retry-tail!)))
         :on-refresh (fn [] (refresh! ctx !st fetch))})))))

(defn section
  "Left-hand column beside a paginated strip — the paged counterpart of
   asy/section."
  [aside !st fetch card-fn]
  (m/Row
   .crossAxisAlignment m.CrossAxisAlignment/stretch
   .children
   [(m/Padding
     .padding (m.EdgeInsets/fromLTRB 20.0 24.0 12.0 24.0)
     .child aside)
    (m/Expanded .child (strip !st fetch card-fn))]))

(defn list-page
  "Heading beside a paginated strip — the paged counterpart of asy/list-page.
   Pointer users have no pull gesture, so the header carries a refresh button."
  [title fetch card-fn & {:keys [icon tone subtitle]}]
  (f/widget
   :context ctx
   :let [!st (state)
         _ (load-more! ctx !st fetch)]
   (section (ui/page-header
             {:title title
              :subtitle subtitle
              :icon (or icon m.Icons/layers_outlined)
              :tone (or tone theme/accent)
              :on-refresh (fn [] (reload! ctx !st fetch) nil)})
            !st fetch card-fn)))
