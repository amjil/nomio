(ns nomio.widgets.keyboard
  "In-app Mongolian virtual keyboard (mobile) and shared IME overlay (desktop)."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [nomio.platform :as platform]
            [nomio.theme :as theme]
            [virtual-keyboard.input-control :as input-control]
            [virtual-keyboard.keyboard :as vk]
            [virtual-keyboard.options :as vk-options]
            [shared-ime.overlay-view :as overlay]))

(def info
  (merge vk-options/keyboard-option
         {:keyboard/mongol-font-family "OyunQaganTig"
          :keyboard/english-font-family theme/font-family
          :keyboard/font-size 16
          :keyboard/key-container-color theme/surface-hi
          :keyboard/long-press-container-color theme/surface-alt
          :keyboard/action-keys-container-color theme/accent-deep
          :keyboard/key-text-color theme/ink
          :keyboard/action-text-color theme/ink-muted
          :keyboard/shift-click-text-color theme/ink
          :keyboard/key-cap-border-radius (int theme/radius-sm)}))

(defn install []
  (input-control/set-control)
  true)

(defn restore-ime! [_]
  (input-control/restore-control)
  nil)

(defn candidates []
  (vk/candidates nil))

(defn bar []
  (m/Container
   .decoration (m/BoxDecoration
                .color theme/surface
                .border (m/Border .top (m/BorderSide .color theme/divider .width 1.0)))
   .child (vk/keyboard {})))

(defn wrap
  "Wrap page body with mobile VK or desktop IME overlay."
  [main-content]
  (if (platform/mobile?)
    (f/widget
     :let [kb-info info]
     :bind {:info kb-info}
     (m/Column
      .children
      [(m/Expanded
        .child
        (m/Stack
         .children
         [main-content
          (candidates)]))
       (bar)]))
    (overlay/ime-global-wrapper main-content)))
