(ns nomio.widgets.reader-frame
  "Shared furniture for the three reader screens — article, question, answer.
   They differ in what hangs off the sides, not in how a page is framed."
  (:require ["package:flutter/material.dart" :as m]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.mongol :as mg]
            [nomio.widgets.ui :as ui]))

(defn- byline [content]
  (let [name (or (get-in content [:author :display-name])
                 (get-in content [:author :username])
                 "")]
    (if (empty? name)
      ui/nothing
      (m/Column
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/center
       .children
       [(ui/top (ui/avatar name 30.0))
        (ui/gap-v 9)
        (mg/muted name)]))))

(defn- tag-slug [t]
  (cond
    (string? t) t
    (map? t) (or (:slug t) (:name t) "")
    :else (str t)))

(defn- tag-chip [tag]
  (let [slug (tag-slug tag)]
    (if (empty? slug)
      ui/nothing
      (ui/tappable
       #(store/push-named! (str "/tags/" slug))
       theme/radius-pill
       (m/Container
        .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 9.0)
        .decoration (m/BoxDecoration
                     .color theme/violet-soft
                     .borderRadius (theme/r theme/radius-pill))
        .child (mg/text (str "#" slug)
                        {:size 12.0 :color theme/violet :max-lines 2}))))))

(defn- tag-line [tags]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .crossAxisAlignment m.CrossAxisAlignment/center
   .children
   (into []
         (comp (map tag-chip)
               (interpose (ui/gap-v 8)))
         tags)))

(defn- action-col [actions]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .crossAxisAlignment m.CrossAxisAlignment/start
   .children
   (into []
         (comp (keep identity)
               (map (fn [{:keys [icon on-tap active?]}]
                      (ui/icon-button {:icon icon :on-tap on-tap :active? active?
                                       :size 36.0})))
               (interpose (ui/gap-v 8)))
         actions)))

(defn meta-aside
  "The leading column of a reader: what this is, who wrote it, and
   everything you can do to it. The title lives on the paper, next to
   the body, so a short article still reads as one piece."
  [{:keys [content on-back actions extra]}]
  (let [{:keys [color wash icon label]} (theme/tone (:type content))
        tags (:tags content)]
    (m/Padding
     .padding (m.EdgeInsets/fromLTRB 18.0 16.0 8.0 18.0)
     .child
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(m/Column
        .mainAxisSize m.MainAxisSize/min
        .crossAxisAlignment m.CrossAxisAlignment/center
        .children
        [(ui/icon-button {:icon m.Icons/arrow_back_rounded :on-tap on-back})
         (ui/gap-v 20)
         (ui/badge {:label label :color color :wash wash :icon icon})])
       (ui/gap-h 14)
       (m/Padding
        .padding (m.EdgeInsets/only .top 58.0)
        .child
        (ui/top
         (m/Row
          .mainAxisSize m.MainAxisSize/min
          .crossAxisAlignment m.CrossAxisAlignment/start
          .children
          (cond-> [(m/Column
                    .mainAxisSize m.MainAxisSize/min
                    .crossAxisAlignment m.CrossAxisAlignment/center
                    .children
                    (cond-> [(byline content)]
                      (seq actions) (conj (ui/gap-v 20) (action-col actions))))]
            (seq tags) (conj (ui/gap-h 12) (tag-line tags))
            extra (conj (ui/gap-h 16) extra)))))]))))

(defn paper
  "The document surface. Title and body share the leading edge of the
   same panel, so a short article does not leave them stranded on
   opposite sides of an empty sheet."
  [child & {:keys [title]}]
  (m/Padding
   .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 16.0)
   .child
   (ui/panel
    {:pad 4.0
     :radius theme/radius-lg
     :color theme/surface
     :shadow theme/soft-shadow}
    (if (seq title)
      (m/Row
       .crossAxisAlignment m.CrossAxisAlignment/stretch
       .children
       [(m/Padding
         .padding (m.EdgeInsets/fromLTRB 14.0 16.0 0.0 16.0)
         .child (mg/title title 21.0))
        (ui/gap-h 12)
        (m/Expanded .child child)])
      child))))

(defn pane
  "A titled side column. The title runs down the leading edge, where a reader
   of vertical script looks first."
  [{:keys [label icon divider?] :or {divider? true}} body]
  (m/Container
   .decoration (when divider?
                 (m/BoxDecoration
                  .border (m/Border .left (m/BorderSide .color theme/divider .width 1.0))))
   .child
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/stretch
    .children
    [(m/Padding
      .padding (m.EdgeInsets/fromLTRB 12.0 18.0 2.0 18.0)
      .child
      (m/Column
       .mainAxisSize m.MainAxisSize/min
       .crossAxisAlignment m.CrossAxisAlignment/start
       .children
       [(m/Icon icon .size 15.0 .color theme/ink-faint)
        (ui/gap-v 10)
        (mg/label label)]))
     (m/Expanded .child body)])))
