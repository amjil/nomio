(ns nomio.widgets.block-renderer
  "Read-only rich text block renderer: Parses backend JSON blocks into Flutter native Widgets.
   Completely redesigned for Native Traditional Mongolian script: Left-to-Right flow, vertical pills and borders.
   Fully styled with Tenger Blue aesthetics."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/gestures.dart" :as g]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   ["dart:convert" :as convert]
   [cljd.flutter :as f]
   [nomio.utils.tokens :as tokens]
   [components.toast :as toast]
   ["package:mgl_editor_core/mgl_selectable_text.dart" :as mgl-sel]
   [nomio.widgets.capture-modal :as capture]))

;; =============================================================================
;; 1. Core Selection Utilities
;; =============================================================================

(defn- mgl-separator? 
  "Determines if a character is a word boundary. Excludes Mongolian modifiers."
  [^String s idx]
  (let [code (.codeUnitAt s idx)]
    (or (<= code 31) 
        (== code 0x0020) 
        (== code 0x3000) 
        (== code 0x202E) 
        (contains? #{"." "," "!" "?" "：" "；" "“" "”" "（" "）" "(" ")" "《" "》" "〈" "〉" "、" "\n" "\t"} 
                   (subs s idx (inc idx))))))

(defn- get-word-boundaries 
  "Calculates the [start, end] boundaries of the word under the given offset."
  [^String text offset]
  (let [len (count text)
        safe-off (max 0 (min offset len))]
    (if (and (< safe-off len) (mgl-separator? text safe-off))
      [safe-off safe-off]
      (let [start (loop [i (dec safe-off)]
                    (if (or (< i 0) (mgl-separator? text i))
                      (inc i)
                      (recur (dec i))))
            end (loop [i safe-off]
                  (if (or (>= i len) (mgl-separator? text i))
                    i
                    (recur (inc i))))]
        [start end]))))

(defn- get-safe-offset [text-key global-pos content-len]
  (try
    (let [pos (mgl-sel.MglSelectableText/getPositionAtOffset text-key global-pos)]
      (max 0 (min (.-offset pos) content-len)))
    (catch dc/Exception _ 0)))

(defn- build-text-spans 
  "Slices plain text with span markers and converts them into an array of Flutter TextSpans."
  [text spans base-style]
  (let [text-len (count text)]
    (if (or (empty? spans) (empty? text))
      [(m/TextSpan .text text .style base-style)]
      (loop [pos 0
             rem-spans (sort-by #(or (get % "start") (get % :start)) spans)
             acc []]
        (if (or (empty? rem-spans) (>= pos text-len))
          (if (< pos text-len)
            (conj acc (m/TextSpan .text (subs text pos) .style base-style))
            acc)
          (let [span (first rem-spans)
                start (max pos (or (get span "start") (get span :start) 0))
                end (min text-len (or (get span "end") (get span :end) 0))
                attrs (or (get span "attrs") (get span :attrs) {})]
            (if (>= start end)
              (recur pos (rest rem-spans) acc)
              (let [acc (if (< pos start)
                          (conj acc (m/TextSpan .text (subs text pos start) .style base-style))
                          acc)
                    styled-font (cond-> base-style
                                  (or (get attrs "bold") (get attrs :bold))      (.copyWith .fontWeight m.FontWeight/bold)
                                  (or (get attrs "italic") (get attrs :italic))    (.copyWith .fontStyle m.FontStyle/italic)
                                  (or (get attrs "underline") (get attrs :underline)) (.copyWith .decoration m.TextDecoration/underline))]
                (recur end 
                       (rest rem-spans)
                       (conj acc (m/TextSpan .text (subs text start end) .style styled-font)))))))))))

;; =============================================================================
;; 2. Persistent State Registry
;; =============================================================================

(defonce !block-registry (atom {}))

(defn- get-block-context [block-id]
  (let [existing (get @!block-registry block-id)]
    (if existing
      existing
      (let [new-ctx {:text-key (m/GlobalKey.)
                     :!overlay (atom nil)
                     :!menu-data (atom {:dx 0 :dy 0 :text ""})
                     :!selection (atom nil)}]
        (swap! !block-registry assoc block-id new-ctx)
        new-ctx))))

;; =============================================================================
;; 3. Manual Gesture Driver & Selectable Text Wrapper
;; =============================================================================

(defn- render-selectable-text 
  [ctx block-id text-content spans base-font post-id]
  (let [spans-array (build-text-spans text-content spans base-font)
        text-len (count text-content)
        on-highlight-fn #(capture/show-capture-dialog! ctx % (str post-id) "post_block")]
    
    (f/widget
     :context local-ctx
     :key (m/ValueKey. (str "st-" block-id))
     :let [{:keys [text-key !overlay !menu-data !selection]} (get-block-context block-id)
           
           hide-menu! 
           (fn [_]
             (when-let [entry @!overlay]
               (.remove entry)
               (reset! !overlay nil))
             nil)
               
           show-menu! 
           (fn [sel]
             (when (and sel (not (.-isCollapsed sel)))
               (let [start-offset (.-baseOffset sel)
                     global-pos (mgl-sel.MglSelectableText/getGlobalOffsetForCaret text-key start-offset)
                     selected-text (if (.-isValid sel) (.textInside sel text-content) "")]
                 
                 ;; For vertical text, popping the menu to the right (+40.0) is native behavior
                 (reset! !menu-data {:dx (if global-pos (+ (.-dx global-pos) 40.0) 100.0)
                                     :dy (if global-pos (.-dy global-pos) 100.0)
                                     :text selected-text})
                 
                 (when (nil? @!overlay)
                   (let [entry (m/OverlayEntry
                                .builder
                                (fn [b-ctx]
                                  (f/widget
                                   :watch [data !menu-data]
                                   (m/Positioned
                                    .left (:dx data)
                                    .top (:dy data)
                                    .child
                                    (m/Material
                                     .elevation 8.0
                                     .color tokens/primary-color
                                     .borderRadius (m/BorderRadius.circular 12.0)
                                     .child
                                     (m/InkWell
                                      .onTap (fn []
                                               (hide-menu! nil)
                                               (reset! !selection nil)
                                               (when-not (empty? (:text data))
                                                 (on-highlight-fn (:text data))))
                                      .borderRadius (m/BorderRadius.circular 12.0)
                                      .child
                                      ;; 🌟 FIX 1: The overlay menu is now a VERTICAL PILL (Column)
                                      (m/Padding
                                       .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 20.0)
                                       .child
                                       (m/Column
                                        .mainAxisSize m.MainAxisSize/min
                                        .children
                                        [(m/Icon m.Icons/edit_note .color m.Colors/white .size 20.0)
                                         (m/SizedBox .height 12.0)
                                         (mgl/MongolText "Эшлэх"
                                                         .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                                             .color m.Colors/white 
                                                                             .fontSize 15.0 
                                                                             .fontWeight m.FontWeight/bold))]))))))))]
                     (reset! !overlay entry)
                     (.insert (m/Overlay.of local-ctx) entry)))))
             nil)]

     ;; Remove overlay when navigating away (back button, route pop, etc.)
     :managed [_ nil
               :dispose hide-menu!]
             
     :watch [current-sel !selection]
     
     (m/GestureDetector
      .behavior m.HitTestBehavior/translucent
      .dragStartBehavior g/DragStartBehavior.down
      
      .onTapUp (fn [_] 
                 (hide-menu! nil) 
                 (reset! !selection nil))
      
      .onLongPressStart (fn [^m/LongPressStartDetails details]
                          (hide-menu! nil)
                          (let [offset (get-safe-offset text-key (.globalPosition details) text-len)
                                [w-start w-end] (get-word-boundaries text-content offset)
                                new-sel (m/TextSelection. .baseOffset w-start .extentOffset w-end)]
                            (reset! !selection new-sel)
                            (if (not (.-isCollapsed new-sel))
                              (show-menu! new-sel))))
      
      .onPanStart (fn [^m/DragStartDetails details]
                    (hide-menu! nil)
                    (let [offset (get-safe-offset text-key (.globalPosition details) text-len)]
                      (reset! !selection (m/TextSelection. .baseOffset offset .extentOffset offset))))
      
      .onPanUpdate (fn [^m/DragUpdateDetails details]
                     (when-let [sel @!selection]
                       (let [offset (get-safe-offset text-key (.globalPosition details) text-len)
                             new-sel (m/TextSelection. .baseOffset (.-baseOffset sel) .extentOffset offset)]
                         (reset! !selection new-sel)
                         (if (not (.-isCollapsed new-sel))
                           (show-menu! new-sel)
                           (hide-menu! nil)))))

      .child
      (mgl-sel/MglSelectableText
       .key (m/ValueKey. (str "mst-" block-id))
       .textKey text-key
       .textSpan (m/TextSpan .children spans-array)
       .selection current-sel
       .showStartHandle (boolean (and current-sel (not (.-isCollapsed current-sel))))
       .showEndHandle (boolean (and current-sel (not (.-isCollapsed current-sel)))))))))

;; =============================================================================
;; 4. Core: Block Renderer
;; =============================================================================

(defn render-block 
  "Renders the corresponding read-only Mongolian component based on the backend block dictionary."
  [block post-id] 
  (let [b-id (or (get block "id") (get block :id) (str (hash block)))]
    (f/widget
     :context ctx
     :key (m/ValueKey. b-id)
     
     :let [b-type (or (get block "type") (name (get block :type :paragraph)))
           text-content (or (get block "text") (get block "content") (get block :content) "")
           spans (or (get block "spans") (get block "content-spans") (get block :content-spans) [])
           image-url (or (get block "url") (get-in block ["data" "url"]) (get-in block [:data :url]) "")
           
           raw-data-val (or (get block "data") (get block :data))
           raw-data (cond
                      (string? raw-data-val) (try (convert/jsonDecode raw-data-val) (catch dc/Exception _ {}))
                      raw-data-val raw-data-val
                      :else {})
                      
           ref-post-id (or (get raw-data "ref-post-id")
                           (get raw-data "ref_post_id")
                           (get raw-data :ref-post-id)
                           (get block "ref_post_id")
                           (get block "ref-post-id")
                           (get block :ref_post_id)
                           (get block "source_post_id"))
           
           base-font (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-primary)]

       (m/Padding
        .padding (m/EdgeInsets.only .right 24.0)
        .child
        (case b-type
          "post-quote"
          (m/GestureDetector
           .behavior m.HitTestBehavior/opaque
           .onTap (fn []
                    (if ref-post-id
                      (m/Navigator.pushNamed ctx "/post" .arguments {:id ref-post-id})
                      (do 
                        (dc/print (str "🚨 [DEBUG ALARM] Missing ID! Block data is: " block))
                        (toast/error ctx "Уучлаарай, холбоосны ID олдсонгүй")))
                    nil)
           .child
           (m/Container
            .padding (m/EdgeInsets.all 16.0)
            .decoration (m/BoxDecoration
                         .color (.withOpacity tokens/primary-color 0.05)
                         .border (m/Border.all .color (.withOpacity tokens/primary-color 0.2))
                         .borderRadius (m/BorderRadius.circular 16.0))
            .child
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/center
             .children
             [(m/Icon m.Icons/link .size 20.0 .color tokens/primary-color)
              (m/SizedBox .height 16.0)
              (m/Expanded
               .child
               (mgl/MongolText text-content
                               .style (m/TextStyle .fontSize 15.0 .color tokens/primary-color .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold)
                               .maxLines 5
                               .overflow m.TextOverflow/ellipsis))])))

          "block-ref"
          (m/GestureDetector
           .behavior m.HitTestBehavior/opaque
           .onTap (fn []
                    (if ref-post-id
                      (m/Navigator.pushNamed ctx "/post" .arguments {:id ref-post-id})
                      (do 
                        (dc/print (str "🚨 [DEBUG ALARM] Missing ID! Block data is: " block))
                        (toast/error ctx "Уучлаарай, холбоосны ID олдсонгүй")))
                    nil)
           .child
           (m/Container
            .padding (m/EdgeInsets.all 16.0)
            .decoration (m/BoxDecoration
                         .color tokens/bg-color
                         .border (m/Border.all .color (.withOpacity tokens/text-secondary 0.2))
                         .borderRadius (m/BorderRadius.circular 16.0))
            .child
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/center
             .children
             [(m/Icon m.Icons/format_quote .size 20.0 .color tokens/text-secondary)
              (m/SizedBox .height 16.0)
              (m/Expanded
               .child
               (mgl/MongolText text-content
                               .style (m/TextStyle .fontSize 15.0 .color tokens/text-secondary .fontStyle m.FontStyle/italic .fontFamily "OyunQaganTig")
                               .maxLines 5
                               .overflow m.TextOverflow/ellipsis))])))

          "backlink"
          (m/GestureDetector
           .behavior m.HitTestBehavior/opaque
           .onTap (fn []
                    (if ref-post-id
                      (m/Navigator.pushNamed ctx "/post" .arguments {:id ref-post-id})
                      (do 
                        (dc/print (str "🚨 [DEBUG ALARM] Missing ID! Block data is: " block))
                        (toast/error ctx "Уучлаарай, холбоосны ID олдсонгүй")))
                    nil)
           .child
           (m/Container
            .padding (m/EdgeInsets.all 16.0)
            .decoration (m/BoxDecoration
                         .color tokens/bg-color
                         .border (m/Border.all .color (.withOpacity tokens/primary-color 0.2))
                         .borderRadius (m/BorderRadius.circular 16.0))
            .child
            ;; 🌟 FIX 2: Entire Backlink card is a Column to stack Icon, Title, and Body vertically
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/center
             .children
             [(m/Column
               .crossAxisAlignment m.CrossAxisAlignment/center
               .children
               [(m/Icon (if (= (get block "quote_type") "block") m.Icons/format_quote m.Icons/link)
                        .size 16.0 .color tokens/primary-color)
                (m/SizedBox .height 8.0)
                (mgl/MongolText "Иш татсан"
                                .style (m/TextStyle .fontSize 13.0 .color tokens/primary-color .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold))])
              (m/SizedBox .height 16.0)
              (m/Expanded
               .child
               (mgl/MongolText text-content
                               .style (m/TextStyle .fontSize 15.0 .color tokens/text-secondary .fontFamily "OyunQaganTig")
                               .maxLines 5
                               .overflow m.TextOverflow/ellipsis))])))

          "image"
          (m/ClipRRect
           .borderRadius (m/BorderRadius.circular 16.0)
           .child (m/Image.network image-url 
                                   .width 240.0
                                   .height 320.0 ;; 🌟 Bound height to prevent infinite expansion in LTR flow
                                   .fit m.BoxFit/cover
                                   .loadingBuilder (fn [ctx child progress]
                                                     (if (nil? progress)
                                                       child
                                                       (m/Container
                                                        .width 240.0 .height 320.0
                                                        .color (.withOpacity tokens/text-secondary 0.1)
                                                        .child (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color)))))))

          "heading-1"
          (render-selectable-text ctx b-id text-content spans 
                                  (.copyWith base-font .fontSize 28.0 .fontWeight m.FontWeight/w900) 
                                  post-id)

          "heading-2"
          (render-selectable-text ctx b-id text-content spans 
                                  (.copyWith base-font .fontSize 22.0 .fontWeight m.FontWeight/bold) 
                                  post-id)

          "blockquote"
          (m/Container
           ;; 🌟 FIX 3: Left Border for Blockquotes (native for vertical LTR text)
           .padding (m/EdgeInsets.only .left 16.0)
           .decoration (m/BoxDecoration .border (m/Border .left (m/BorderSide .color (.withOpacity tokens/primary-color 0.5) .width 4.0)))
           .child (render-selectable-text ctx b-id text-content spans 
                                          (.copyWith base-font .fontSize 16.0 .fontStyle m.FontStyle/italic .color tokens/text-secondary) 
                                          post-id))

          "list-item"
          (m/Column
           .crossAxisAlignment m.CrossAxisAlignment/start
           .children
           [(m/Padding
             ;; 🌟 FIX 4: Bullet point padding on the bottom, allowing text to flow downwards natively
             .padding (m/EdgeInsets.only .bottom 8.0)
             .child (m/Text "• " .style (m/TextStyle .fontSize 18.0 .color tokens/text-primary)))
            (m/Expanded
             .child
             (render-selectable-text ctx b-id text-content spans 
                                     (.copyWith base-font .fontSize 16.0 .height 1.6) 
                                     post-id))])

          ;; Default Paragraph
          (render-selectable-text ctx b-id text-content spans 
                                  (.copyWith base-font .fontSize 16.0 .height 1.6) 
                                  post-id))))))