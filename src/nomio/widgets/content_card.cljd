(ns nomio.widgets.content-card
  (:require ["package:flutter/material.dart" :as m]
            [clojure.string :as str]
            [nomio.content.document :as doc]
            [nomio.state.store :as store]
            [nomio.theme :as theme]
            [nomio.widgets.async :as asy]
            [nomio.widgets.mongol :as mg]))

(defn- type-label [t]
  (case t
    :article "Article"
    :question "Question"
    :answer "Answer"
    (str t)))

(defn- card-excerpt [c]
  (or (:excerpt c)
      (when (:document c) (doc/excerpt (:document c) 60))
      ""))

(defn- engagement-label [c]
  (str (when (:like-count c) (str "♥ " (:like-count c) " "))
       (when (:vote-score c) (str "▲ " (:vote-score c)))))

(defn- author-label [c]
  (or (get-in c [:author :display-name])
      (get-in c [:author :username])
      ""))

(defn card [c]
  (m/InkWell
   .onTap #(store/open-content! c)
   .child
   (m/Container
    .width 220.0
    .margin (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
    .padding (m.EdgeInsets/all 16.0)
    .decoration (m/BoxDecoration
                 .color theme/surface
                 .borderRadius (m.BorderRadius/circular 12.0)
                 .border (m/Border.all .color theme/divider))
    .child
    ;; Vertical Mongolian text grows along the row's main axis, so everything
    ;; of unbounded length is Flexible or a long title overflows the card.
    (m/Row
     .crossAxisAlignment m.CrossAxisAlignment/start
     .children
     [(mg/text (type-label (:type c)) {:size 12.0 :color theme/accent})
      (m/SizedBox .width 8.0)
      (m/Flexible
       .child (mg/text (or (:title c) "") {:size 18.0 :weight m.FontWeight/w600}))
      (m/SizedBox .width 8.0)
      (m/Flexible .child (mg/muted (card-excerpt c)))
      (m/SizedBox .width 8.0)
      (m/Flexible .child (mg/muted (author-label c)))
      (if (seq (:tags c))
        (m/Flexible .child (mg/muted (str "#" (str/join " #" (:tags c)))))
        (m/SizedBox.shrink))
      (if (or (:like-count c) (:vote-score c))
        (mg/muted (engagement-label c))
        (m/SizedBox.shrink))]))))

(defn strip [items]
  (if (empty? items)
    (asy/empty-state)
    (m/ListView
     .scrollDirection m.Axis/horizontal
     .padding (m.EdgeInsets/symmetric .horizontal 8.0)
     .children (mapv card items))))
