(ns nomio.screens.daily-review
  "Daily Review screen featuring the immersive Tenger Blue flashcard UI.
   Fixed JSON String key access for Dart interop."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   [cljd.flutter :as f]
   [nomio.core.api :as api]
   [nomio.utils.tokens :as tokens]))

;; =============================================================================
;; UI Components
;; =============================================================================

(defn- feedback-button 
  "Buttons use semantic colors with a 10% opacity background for a soft, modern look."
  [label color bg-color on-tap]
  (m/Expanded
   .child
   (m/Padding
    .padding (m/EdgeInsets.symmetric .horizontal 6.0)
    .child
    (m/ElevatedButton
     .style (m/ElevatedButton.styleFrom
             .backgroundColor bg-color
             .foregroundColor color
             .elevation 0.0
             .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.circular 16.0))
             .padding (m/EdgeInsets.symmetric .vertical 20.0))
     .onPressed on-tap
     .child (mgl/MongolText label 
                            .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold .fontSize 15.0))))))

(defn- review-card 
  "Renders a single flashcard optimized for vertical Mongolian text."
  [item]
  ;; 🌟 FIX: Use string keys to safely access Dart JSON map, with keyword fallbacks just in case
  (let [highlight (or (get item "highlight") (get item :highlight) {})
        content (or (get highlight "content") (get highlight :content) "Хоосон")
        source-ref (or (get highlight "source_ref") (get highlight :source_ref) "Тодорхойгүй")]
    (m/Padding
     .padding (m/EdgeInsets.only .left 32.0 .right 32.0 .top 16.0 .bottom 32.0)
     .child
     (m/Container
      .decoration (m/BoxDecoration
                   .color tokens/surface-color
                   .borderRadius (m/BorderRadius.circular 24.0)
                   .boxShadow tokens/tenger-shadow
                   .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
      .child
      (m/Padding
       .padding (m/EdgeInsets.all 40.0)
       .child
       (m/Column
        .mainAxisAlignment m.MainAxisAlignment/center
        .children
        [;; Main Highlight Content
         (m/Expanded
          .child
          (m/Center
           .child
           (mgl/MongolText content
                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 26.0 .height 1.6 .color tokens/text-primary)
                           .textAlign mgl/MongolTextAlign.center)))
         
         ;; Source Metadata
         (m/SizedBox .height 32.0)
         (m/Divider .color (.withOpacity tokens/text-secondary 0.2))
         (m/SizedBox .height 16.0)
         (mgl/MongolText (str "Эх сурвалж: " source-ref)
                         .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 13.0 .color tokens/text-secondary))]))))))

;; =============================================================================
;; Main Screen Widget
;; =============================================================================

(defn screen 
  "The main screen widget managing the daily review session state."
  []
  (let [!state (atom {:loading? true :items [] :error nil})
        !current-idx (atom 0)
        !card-start-time (atom (dc/DateTime.now))]
    
    ;; Fetch due reviews on initialization
    (-> (api/fetch-due-reviews :limit 50 :include-new true)
        (.then (fn [items]
                 (reset! !state {:loading? false :items (vec items) :error nil})
                 (reset! !card-start-time (dc/DateTime.now))))
        (.catchError (fn [err] (reset! !state {:loading? false :items [] :error (str err)}))))

    (f/widget
     :context local-ctx
     :managed [page-ctrl (m/PageController. .initialPage 0)]
     :watch [state-map !state current-idx !current-idx]
     
     :let [{:keys [loading? items error]} state-map
           total (count items)
           is-finished? (>= current-idx total)
           
           handle-grade! 
           (fn [grade]
             (let [current-item (nth items current-idx)
                   duration-ms (.inMilliseconds (.difference (dc/DateTime.now) @!card-start-time))
                   ;; 🌟 FIX: Safe access to the review item ID using string key
                   item-id (or (get current-item "id") (get current-item :id))]
               
               ;; Submit the review to the backend
               (api/submit-review item-id grade :duration-ms duration-ms)
               
               ;; Advance to the next card
               (swap! !current-idx inc)
               (when (< @!current-idx total)
                 (reset! !card-start-time (dc/DateTime.now))
                 (.nextPage page-ctrl .duration (dart:core/Duration .milliseconds 400) .curve m.Curves/easeOutQuart))
               nil))]
     
     (m/Scaffold
      .backgroundColor tokens/bg-color
      .appBar (m/AppBar
               .title (m/Text (if (or loading? error is-finished?) "Давтлага" (str "Өдрийн давтлага (" (inc current-idx) "/" total ")"))
                              .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color tokens/text-secondary))
               .centerTitle true)
      .body
      (cond
        ;; State 1: Loading
        loading? (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color))
        
        ;; State 2: Error
        error (m/Center .child (m/Text (str "Алдаа: " error)))
        
        ;; State 3: Session Finished
        is-finished?
        (m/Center
         .child
         (m/Column
          .mainAxisAlignment m.MainAxisAlignment/center
          .children
          [(m/Container .padding (m/EdgeInsets.all 24.0) .decoration (m/BoxDecoration .color tokens/srs-easy-bg .shape m.BoxShape/circle)
             .child (m/Icon m.Icons/auto_awesome .color tokens/srs-easy .size 64.0))
           (m/SizedBox .height 32.0)
           (mgl/MongolText "Бүх картыг давтаж дууслаа!" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 22.0 .color tokens/text-primary .fontWeight m.FontWeight/bold))
           (m/SizedBox .height 12.0)
           (mgl/MongolText "Таны ой тогтоолт сайжирсаар байна." .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 15.0 .color tokens/text-secondary))]))
        
        ;; State 4: Active Review Session
        :else
        (m/Column
         .children
         [(m/Expanded
           .child
           (m/PageView.builder
            .controller page-ctrl
            .physics (m/NeverScrollableScrollPhysics.) 
            .itemCount total
            .itemBuilder (fn [_ idx] (review-card (nth items idx)))))
          
          ;; Bottom Action Bar with 4 Feedback Options
          (m/SafeArea
           .child
           (m/Padding
            .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 32.0)
            .child
            (m/Row
             .mainAxisAlignment m.MainAxisAlignment/spaceEvenly
             .children
             [(feedback-button "Дахих" tokens/srs-again tokens/srs-again-bg #(handle-grade! 1))
              (feedback-button "Хэцүү" tokens/srs-hard tokens/srs-hard-bg #(handle-grade! 2))
              (feedback-button "Сайн"  tokens/srs-good tokens/srs-good-bg #(handle-grade! 3))
              (feedback-button "Амархан" tokens/srs-easy tokens/srs-easy-bg #(handle-grade! 4))])))]))))))