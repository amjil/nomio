(ns nomio.screens.highlight-manager
  "A dedicated screen for managing captured highlights, notes, and SRS statuses.
   Updated to Tenger Blue design system with a horizontal scrolling flow optimized for vertical script."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   [cljd.flutter :as f]
   [nomio.core.api :as api]
   [components.toast :as toast]
   [nomio.utils.tokens :as tokens]
   [nomio.widgets.capture-modal :as capture]))

;; =============================================================================
;; UI Components
;; =============================================================================

(defn- highlight-card
  "Renders a single highlight item with swipe-up-to-delete and status toggles.
   Accepts ctx from the parent widget to trigger toasts and modals."
  [ctx item refresh-fn!]
  (let [hl-id (get item :id)
        srs-item (get item :srs_item)
        srs-id (get srs-item :id)
        status (get srs-item :status "new")
        suspended? (= status "suspended")
        has-note? (not (empty? (get item :note)))
        
        toggle-status!
        (fn []
          (if srs-id
            (-> (api/update-srs-status srs-id (not suspended?))
                (.then (fn [res]
                         (if (:ok res)
                           (do (toast/success ctx "Төлөв өөрчлөгдлөө" :fade)
                               (refresh-fn!))
                           (toast/error ctx "Алдаа гарлаа" :fade)))))
            (toast/error ctx "SRS карт олдсонгүй" :fade)))
            
        delete-item!
        (fn []
          (-> (api/delete-highlight hl-id)
              (.then (fn [success?]
                       (if success?
                         (do (toast/success ctx "Устгагдлаа" :fade)
                             (refresh-fn!))
                         (toast/error ctx "Устгахад алдаа гарлаа" :fade))))))]
    
    (m/Dismissible
     .key (m/Key. (str "hl-" hl-id))
     ;; 🌟 FIX: Change dismiss direction to UP since the list is scrolling horizontally
     .direction m.DismissDirection/up
     .background (m/Container
                  .decoration (m/BoxDecoration 
                               .color tokens/srs-again 
                               .borderRadius (m/BorderRadius.circular 20.0))
                  .margin (m/EdgeInsets.only .right 24.0 .bottom 16.0 .top 16.0)
                  .alignment m.Alignment/bottomCenter
                  .padding (m/EdgeInsets.only .bottom 32.0)
                  ;; 🌟 FIXED: Changed m.Icons.delete_sweep to m.Icons/delete_sweep
                  .child (m/Icon m.Icons/delete_sweep .color m.Colors/white .size 32.0))
     .confirmDismiss (fn [_] (dc/Future.value true))
     .onDismissed (fn [_] (delete-item!))
     .child
     (m/Container
      ;; 🌟 FIX: Fixed width for horizontal scrolling
      .width 320.0
      .margin (m/EdgeInsets.only .right 24.0 .bottom 16.0 .top 16.0)
      .decoration (m/BoxDecoration
                   .color tokens/surface-color
                   .borderRadius (m/BorderRadius.circular 20.0)
                   .boxShadow tokens/tenger-shadow
                   .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
      .child
      (m/Material
       .color m.Colors/transparent
       .child
       (m/InkWell
        .borderRadius (m/BorderRadius.circular 20.0)
        .onTap (fn []
                 (capture/show-capture-dialog! 
                  ctx
                  (get item :content) 
                  (get item :source_ref) 
                  (get item :source_type)))
        .child
        (m/Padding
         .padding (m/EdgeInsets.all 24.0)
         .child
         (m/Column
          .crossAxisAlignment m.CrossAxisAlignment/start
          .children
          [;; Status & Source Header
           (m/Row
            .mainAxisAlignment m.MainAxisAlignment/spaceBetween
            .children
            [(m/Row
              .children
              [(m/Icon (if suspended? m.Icons/pause_circle_filled m.Icons/play_circle_fill) 
                       .color (if suspended? tokens/text-secondary tokens/srs-easy) 
                       .size 16.0)
               (m/SizedBox .width 8.0)
               (mgl/MongolText (if suspended? "Түр зогссон" "Идэвхтэй") 
                               .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 13.0 .color tokens/text-secondary))])
             (mgl/MongolText (get item :source_type "Одоогоор тодорхойгүй") 
                             .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 13.0 .color tokens/primary-color .fontWeight m.FontWeight/bold))])
           
           (m/SizedBox .height 24.0)
           
           ;; Highlight Content
           (m/Expanded
            .child
            (m/SingleChildScrollView
             .scrollDirection m.Axis/horizontal
             .physics (m/BouncingScrollPhysics.)
             .child
             (mgl/MongolText (get item :content "Хоосон")
                             .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0 .height 1.6 .color tokens/text-primary))))
           
           ;; Note Area
           (when has-note?
             (m/Container
              .margin (m/EdgeInsets.only .top 20.0)
              .padding (m/EdgeInsets.all 16.0)
              .decoration (m/BoxDecoration 
                           .color tokens/primary-container 
                           .borderRadius (m/BorderRadius.circular 12.0))
              .child (m/Row
                      .crossAxisAlignment m.CrossAxisAlignment/start
                      .children
                      [(m/Icon m.Icons/lightbulb_outline .color tokens/primary-color .size 18.0)
                       (m/SizedBox .width 12.0)
                       (m/Expanded
                        .child (mgl/MongolText (get item :note "")
                                               .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .color tokens/primary-color)))])))
           
           (m/SizedBox .height 16.0)
           (m/Divider .color (.withOpacity tokens/text-secondary 0.1))
           
           ;; Action Buttons
           (m/Row
            .mainAxisAlignment m.MainAxisAlignment/end
            .children
            [(m/TextButton.icon
              .style (m/TextButton.styleFrom .foregroundColor tokens/text-secondary)
              .icon (m/Icon (if suspended? m.Icons/play_arrow m.Icons/pause) .size 18.0)
              .label (mgl/MongolText (if suspended? "Сэргээх" "Зогсоох") .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold))
              .onPressed toggle-status!)])]))))))))

;; =============================================================================
;; Main Screen Widget
;; =============================================================================

(defn screen 
  "The main highlight manager screen."
  []
  (let [!state (atom {:loading? true :items [] :error nil})
        
        fetch-data!
        (fn []
          (reset! !state {:loading? true :items (:items @!state) :error nil})
          (-> (api/fetch-highlights :limit 100)
              (.then (fn [items]
                       (reset! !state {:loading? false :items (vec items) :error nil})))
              (.catchError (fn [e]
                             (reset! !state {:loading? false :items [] :error (str e)})))))]
    
    (fetch-data!)

    (f/widget
     :context local-ctx
     :watch [state-map !state]
     :let [{:keys [loading? items error]} state-map]
     
     (m/Scaffold
      .backgroundColor tokens/bg-color
      .appBar (m/AppBar
               .elevation 0.0
               .backgroundColor m.Colors/transparent
               .iconTheme (m/IconThemeData .color tokens/primary-color)
               .title (mgl/MongolText "Миний эшлэлүүд" 
                                      .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 20.0 .fontWeight m.FontWeight/bold .color tokens/text-primary))
               .actions [(m/IconButton 
                          .icon (m/Icon m.Icons/refresh .color tokens/primary-color) 
                          .onPressed fetch-data!)
                         (m/SizedBox .width 16.0)])
      .body
      (m/SafeArea
       .child
       (cond
         loading?
         (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color))
         
         error
         (m/Center .child (m/Text (str "Алдаа гарлаа: " error) .style (m/TextStyle .color tokens/srs-again)))
         
         (empty? items)
         (m/Center
          .child
          (m/Column
           .mainAxisAlignment m.MainAxisAlignment/center
           .children
           [(m/Container
             .padding (m/EdgeInsets.all 24.0)
             .decoration (m/BoxDecoration .color tokens/primary-container .shape m.BoxShape/circle)
             .child (m/Icon m.Icons/inbox .size 48.0 .color tokens/primary-color))
            (m/SizedBox .height 24.0)
            (mgl/MongolText "Эшлэл одоогоор алга байна." .style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-secondary .fontSize 16.0))]))
         
         :else
         (m/RefreshIndicator
          .color tokens/primary-color
          .backgroundColor tokens/surface-color
          .onRefresh (fn [] (dc/Future.sync fetch-data!))
          .child
          (m/ListView.builder
           .scrollDirection m.Axis/horizontal
           .physics (m/AlwaysScrollableScrollPhysics.)
           .padding (m/EdgeInsets.only .left 24.0 .right 24.0 .bottom 32.0 .top 16.0)
           .itemCount (count items)
           .itemBuilder
           (fn [_ idx]
             (highlight-card local-ctx (nth items idx) fetch-data!))))))))))