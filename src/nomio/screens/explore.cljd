(ns nomio.screens.explore
  "Explore and Search screen updated with Tenger Blue aesthetics. 
   Features an AppBar with a back button, a vertical search bar, dynamic hot topics, 
   and full integration with the centralized Native Virtual Keyboard.
   Uses a full-screen CustomScrollView for a native horizontal canvas experience."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [clojure.string :as str]
   [cljd.flutter :as f]
   [nomio.core.api :as api]
   [nomio.widgets.post-card :as post-card]
   [nomio.utils.tokens :as tokens]
   
   ;; Rich Editor & Custom TextField
   [rich-editor.components.text-field :as custom-tf]
   
   ;; 🌟 Centralized Keyboard Wrapper
   [nomio.widgets.keyboard-wrapper :as kw]))

;; =============================================================================
;; Editor State for Search Bar
;; =============================================================================
(defonce !search-state
  (atom {:root ["search-block"]
         :blocks {"search-block" {:id "search-block" :type :paragraph :content ""}}
         :active-block-id nil
         :cursor-visible false
         :external-keyboard-delegate nil
         :history {:undo-stack [] :redo-stack [] :max-depth 100}}))

;; =============================================================================
;; Main Screen
;; =============================================================================
(defn explore-screen []
  (let [!posts (atom [])
        !loading? (atom true)
        !current-query (atom "")
        !hot-tags (atom [])

        load-posts! (fn [query]
                      (reset! !loading? true)
                      (reset! !current-query query)
                      (let [fetch-promise (if (str/blank? query)
                                            (api/fetch-posts :page 1 :limit 10)
                                            (api/search-posts query :page 1 :limit 10))]
                        (-> fetch-promise
                            (.then (fn [data]
                                     (let [items (cond
                                                   (sequential? data) data
                                                   (and (map? data) (sequential? (:data data))) (:data data)
                                                   (and (map? data) (sequential? (get data "data"))) (get data "data")
                                                   :else [])]
                                       (reset! !posts items)
                                       (reset! !loading? false))))
                            (.catchError (fn [_]
                                           (reset! !posts [])
                                           (reset! !loading? false))))))

        load-tags! (fn []
                     (-> (api/fetch-hot-tags :limit 10)
                         (.then (fn [tags-data]
                                  (let [items (cond
                                                (sequential? tags-data) tags-data
                                                (and (map? tags-data) (sequential? (:data tags-data))) (:data tags-data)
                                                (and (map? tags-data) (sequential? (get tags-data "data"))) (get tags-data "data")
                                                :else [])
                                        tag-names (map #(or (get % "tag") (get % :tag)) items)]
                                    (reset! !hot-tags (vec tag-names)))))
                         (.catchError (fn [_]
                                        (reset! !hot-tags [])))))]

    (load-posts! "")
    (load-tags!)

    (f/widget
     :context ctx
     :managed [search-ctrl (m/TextEditingController.)
               search-focus-node (m/FocusNode)]

     :watch [posts !posts
             loading? !loading?
             current-query !current-query
             hot-tags !hot-tags
             search-state !search-state] ;; Ensure text-field re-renders on state changes

     (m/Scaffold
      .backgroundColor tokens/bg-color
      ;; Prevent mobile native keyboard from crushing our virtual one
      .resizeToAvoidBottomInset false 

      .appBar
      (m/AppBar
       .elevation 0.0
       .backgroundColor m.Colors/transparent
       .leading (m/IconButton
                 .icon (m/Icon m.Icons/arrow_back .color tokens/primary-color)
                 .tooltip "Буцах"
                 .onPressed #(m/Navigator.pop ctx)))

      .body
      (m/SafeArea
       .child
       ;; 🌟 Wrapped seamlessly in our new centralized custom keyboard
       (kw/with-virtual-keyboard
        (m/CustomScrollView
         .scrollDirection m.Axis/horizontal
         .physics (m/BouncingScrollPhysics.)
         .slivers
         [;; ---------------------------------------------------------
          ;; Sliver A: Far Left Vertical Search Bar Area
          ;; ---------------------------------------------------------
          (m/SliverToBoxAdapter
           .child
           (m/Container
            .width 80.0
            .margin (m/EdgeInsets.only .left 16.0 .top 16.0 .bottom 24.0)
            .decoration (m/BoxDecoration
                         .color tokens/surface-color
                         .boxShadow tokens/tenger-shadow
                         .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0)
                         .borderRadius (m/BorderRadius.circular 40.0))
            .child
            (m/Column
             .children
             [(m/Padding
               .padding (m/EdgeInsets.only .top 32.0 .bottom 16.0)
               .child (m/Icon m.Icons/search .color tokens/primary-color .size 28.0))

              (m/Expanded
               .child
               (m/Padding
                .padding (m/EdgeInsets.only .bottom 32.0)
                .child
                (custom-tf/text-field
                 !search-state
                 {:controller search-ctrl
                  :focus-node search-focus-node
                  :hint "Хайх..."
                  :max-lines 1
                  :on-submitted (fn [text]
                                  (let [clean-text (str/trim text)]
                                    (load-posts! clean-text)))
                  :style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-primary .fontSize 18.0)})))])))

          (m/SliverToBoxAdapter .child (m/SizedBox .width 40.0))

          ;; ---------------------------------------------------------
          ;; Sliver B: Middle Trending Tags (Hot Topics)
          ;; ---------------------------------------------------------
          (m/SliverToBoxAdapter
           .child
           (m/Padding
            .padding (m/EdgeInsets.only .top 24.0)
            .child
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/start
             .children
             [(mgl/MongolText "Түгээмэл сэдвүүд"
                              .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 20.0 .fontWeight m.FontWeight/bold .color tokens/text-primary))
              (m/SizedBox .height 24.0)

              (if (empty? hot-tags)
                (m/SizedBox .height 100.0 .child (m/Center .child (m/CircularProgressIndicator .strokeWidth 2.0 .color tokens/primary-color)))
                (m/Wrap
                 .direction m.Axis/vertical
                 .spacing 16.0
                 .runSpacing 16.0
                 .children
                 (mapv (fn [tag]
                         (m/InkWell
                          .onTap (fn [] (m/Navigator.pushNamed ctx "/topic" .arguments {:tag tag}) nil) 
                          .borderRadius (m/BorderRadius.circular 12.0)
                          .child
                          (m/Container
                           .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 16.0)
                           .decoration (m/BoxDecoration
                                        .color tokens/primary-container
                                        .borderRadius (m/BorderRadius.circular 12.0))
                           .child
                           (mgl/MongolText (str "# " tag)
                                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .fontWeight m.FontWeight/w600 .color tokens/primary-color)))))
                       hot-tags)))])))

          ;; ---------------------------------------------------------
          ;; Sliver C: Divider
          ;; ---------------------------------------------------------
          (m/SliverToBoxAdapter
           .child
           (m/Padding
            .padding (m/EdgeInsets.symmetric .horizontal 40.0 .vertical 24.0)
            .child (m/VerticalDivider .width 1.0 .color (.withOpacity tokens/text-secondary 0.2))))

          ;; ---------------------------------------------------------
          ;; Sliver D: Feed Title
          ;; ---------------------------------------------------------
          (m/SliverToBoxAdapter
           .child
           (m/Padding
            .padding (m/EdgeInsets.only .top 24.0 .right 24.0)
            .child
            (mgl/MongolText
             (if (str/blank? current-query)
               "Санал болгох"
               (str "\"" current-query "\" хайлтын үр дүн"))
             .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 20.0 .fontWeight m.FontWeight/bold .color tokens/text-primary))))

          ;; ---------------------------------------------------------
          ;; Sliver E: Feed Content (Loading / Empty / List)
          ;; ---------------------------------------------------------
          (if loading?
            (m/SliverFillRemaining
             .hasScrollBody false
             .child (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color)))

            (if (empty? posts)
              (m/SliverFillRemaining
               .hasScrollBody false
               .child (m/Center
                       .child (mgl/MongolText "Илэрц олдсонгүй"
                                              .style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-secondary .fontSize 16.0))))

              (m/SliverList
               .delegate
               (m/SliverChildBuilderDelegate
                (f/build [i]
                         (let [post (nth posts i)
                               post-id (or (get post "id") (get post :id))]
                           (m/Padding
                            .padding (m/EdgeInsets.only .top 24.0 .right 20.0)
                            .child
                            (m/SizedBox 
                             .width 180.0
                             .child
                             (post-card/post-card 
                              {:post post
                               :on-tap #(m/Navigator.pushNamed ctx "/post" .arguments {:id post-id})})))))
                .childCount (count posts)))))

          ;; End Padding
          (m/SliverToBoxAdapter .child (m/SizedBox .width 40.0))])))))))