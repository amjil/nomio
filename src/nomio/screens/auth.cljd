(ns nomio.screens.auth
  "Authentication screens for Login and Registration.
   Completely redesigned for Native Traditional Mongolian script: Left-to-Right horizontal flow.
   Uses 100% content-driven sizing including buttons without fixed SizedBox."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:core" :as dc]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [nomio.core.api :as api]
            [nomio.core.state :as state]
            [components.toast :as toast]
            [nomio.utils.tokens :as tokens]
            [nomio.widgets.keyboard-wrapper :as kw]))

;; =============================================================================
;; UI Components
;; =============================================================================

(defn- form-field 
  "A specialized form row for Native Mongolian: Vertical label on the left, Vertical MongolTextField on the right."
  [label-text ctrl is-password? keyboard-type]
  (m/Padding
   .padding (m/EdgeInsets.only .right 24.0)
   .child
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/start
    .children
    [;; Left: Vertical Label
     (m/Padding
      .padding (m/EdgeInsets.only .top 16.0)
      .child
      (mgl/MongolText label-text 
                      .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color tokens/text-secondary)))
     
     (m/SizedBox .width 16.0)
     
     ;; Right: Vertical Input Field
     (m/SizedBox
      .width 56.0
      .height 280.0
      .child
      (mgl/MongolTextField
       .controller ctrl
       .obscureText is-password?
       .keyboardType keyboard-type
       .maxLines 1
       .textAlign mgl/MongolTextAlign.top
       .style (m/TextStyle .fontSize 16.0 .color tokens/text-primary .fontFamily "OyunQaganTig")
       .decoration (m/InputDecoration
                    .filled true
                    .fillColor tokens/bg-color
                    .contentPadding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 16.0)
                    .border (m/OutlineInputBorder 
                             .borderRadius (m/BorderRadius.circular 12.0) 
                             .borderSide m.BorderSide/none)
                    .focusedBorder (m/OutlineInputBorder 
                                    .borderRadius (m/BorderRadius.circular 12.0)
                                    .borderSide (m/BorderSide .color tokens/primary-color .width 1.5)))))])))

;; =============================================================================
;; 1. Login Screen
;; =============================================================================

(defn login-screen []
  (let [!loading? (atom false)]
    (f/widget
     :context ctx
     :managed [email-ctrl (m/TextEditingController.)
               password-ctrl (m/TextEditingController.)]
     :watch [loading? !loading?]

     :let [do-login!
           (fn []
             (let [email (.-text email-ctrl)
                   password (.-text password-ctrl)]
               (if (or (empty? email) (empty? password))
                 (toast/error ctx "Мэдээллээ бүрэн оруулна уу")
                 (do
                   (reset! !loading? true)
                   (-> (api/login {"email" email "password" password})
                       (.then (fn [user-data]
                                (state/login! user-data)
                                (reset! !loading? false)
                                (toast/success ctx "Амжилттай нэвтэрлээ")
                                (m/Navigator.pushReplacementNamed ctx "/")))
                       (.catchError (fn [err]
                                      (reset! !loading? false)
                                      (let [clean-err (str/replace (str err) #"^Exception: " "")]
                                        (dc/print (str "=== Login Error ===\n" clean-err))
                                        (toast/error ctx clean-err)))))))))]

     (m/Scaffold
      .backgroundColor tokens/bg-color
      .resizeToAvoidBottomInset false
      .body
      (m/SafeArea
       .child
       (kw/with-virtual-keyboard
        (m/Center
         .child
         (m/SingleChildScrollView
          .scrollDirection m.Axis/horizontal
          .physics (m/BouncingScrollPhysics.)
          .padding (m/EdgeInsets.all 24.0)
          .child
          (m/Container
           .decoration (m/BoxDecoration
                        .color tokens/surface-color
                        .borderRadius (m/BorderRadius.circular 24.0)
                        .boxShadow tokens/tenger-shadow
                        .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
           .child
           (m/Padding
            .padding (m/EdgeInsets.all 40.0)
            .child
            (m/Row
             .crossAxisAlignment m.CrossAxisAlignment/start
             .children
             [;; Branding Header
              (m/Column
               .mainAxisSize m.MainAxisSize/min
               .children
               [(m/Container
                 .padding (m/EdgeInsets.all 16.0)
                 .decoration (m/BoxDecoration .color tokens/primary-container .shape m.BoxShape/circle)
                 .child (m/Icon m.Icons/auto_stories .size 40.0 .color tokens/primary-color))
                (m/SizedBox .height 24.0)
                (mgl/MongolText "ᠨᠡᠪᠲᠡᠷᠡᠬᠦ"
                                .style (m/TextStyle .fontSize 32.0 .fontWeight m.FontWeight/bold .color tokens/text-primary .fontFamily "OyunQaganTig"))])
              
              (m/SizedBox .width 48.0)

              ;; Form Fields
              (form-field "И-мэйл хаяг" email-ctrl false m.TextInputType/emailAddress)
              (form-field "Нууц үг" password-ctrl true m.TextInputType/text)
              
              (m/SizedBox .width 16.0)

              ;; Login Button (🌟 FIX: 彻底去除了外部 SizedBox，靠内部 padding 自动撑开完美形状)
              (mgl/MongolElevatedButton
               .style (m/ElevatedButton.styleFrom
                       .backgroundColor tokens/primary-color
                       .foregroundColor m.Colors/white
                       .elevation 0.0
                       .padding (m/EdgeInsets.symmetric .vertical 48.0 .horizontal 20.0)
                       .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.circular 16.0)))
               .onPressed (if loading? nil do-login!)
               .child (if loading?
                        (m/SizedBox .width 24.0 .height 24.0 .child (m/CircularProgressIndicator .color m.Colors/white .strokeWidth 2.0))
                        (mgl/MongolText "Нэвтрэх" .style (m/TextStyle .fontSize 16.0 .fontWeight m.FontWeight/bold .fontFamily "OyunQaganTig"))))

              (m/SizedBox .width 32.0)

              ;; Navigation Link
              (m/Padding
               .padding (m/EdgeInsets.only .top 16.0)
               .child
               (m/InkWell
                .onTap (fn [] (m/Navigator.pushNamed ctx "/register") nil)
                .borderRadius (m/BorderRadius.circular 8.0)
                .child
                (m/Padding
                 .padding (m/EdgeInsets.all 12.0)
                 .child
                 (mgl/MongolText "Бүртгэлгүй юу? Бүртгүүлэх" 
                                 .style (m/TextStyle .color tokens/primary-color .fontFamily "OyunQaganTig")))))])))))))))))

;; =============================================================================
;; 2. Register Screen
;; =============================================================================

(defn register-screen []
  (let [!loading? (atom false)]
    (f/widget
     :context ctx
     :managed [handle-ctrl (m/TextEditingController.)
               nickname-ctrl (m/TextEditingController.)
               email-ctrl (m/TextEditingController.)
               password-ctrl (m/TextEditingController.)]
     :watch [loading? !loading?]

     :let [do-register!
           (fn []
             (let [handle (.-text handle-ctrl)
                   nickname (.-text nickname-ctrl)
                   email (.-text email-ctrl)
                   password (.-text password-ctrl)]
               (if (or (empty? handle) (empty? nickname) (empty? email) (empty? password))
                 (toast/error ctx "Мэдээллээ бүрэн оруулна уу")
                 (do
                   (reset! !loading? true)
                   (-> (api/register {"username" handle
                                      "nickname" nickname
                                      "email" email
                                      "password" password})
                       (.then (fn [user-data]
                                (state/login! user-data)
                                (reset! !loading? false)
                                (toast/success ctx "Амжилттай бүртгүүллээ")
                                (m/Navigator.pushReplacementNamed ctx "/")))
                       (.catchError (fn [err]
                                      (reset! !loading? false)
                                      (let [clean-err (str/replace (str err) #"^Exception: " "")]
                                        (dc/print (str "=== Register Error ===\n" clean-err))
                                        (toast/error ctx clean-err)))))))))]

     (m/Scaffold
      .backgroundColor tokens/bg-color
      .resizeToAvoidBottomInset false
      .appBar (m/AppBar .backgroundColor m.Colors/transparent .elevation 0.0
                        .iconTheme (m/IconThemeData .color tokens/primary-color))
      .body
      (m/SafeArea
       .child
       (kw/with-virtual-keyboard
        (m/Center
         .child
         (m/SingleChildScrollView
          .scrollDirection m.Axis/horizontal
          .physics (m/BouncingScrollPhysics.)
          .padding (m/EdgeInsets.all 24.0)
          .child
          (m/Container
           .decoration (m/BoxDecoration
                        .color tokens/surface-color
                        .borderRadius (m/BorderRadius.circular 24.0)
                        .boxShadow tokens/tenger-shadow
                        .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
           .child
           (m/Padding
            .padding (m/EdgeInsets.all 40.0)
            .child
            (m/Row
             .crossAxisAlignment m.CrossAxisAlignment/start
             .children
             [;; Branding Header
              (m/Column
               .mainAxisSize m.MainAxisSize/min
               .children
               [(mgl/MongolText "ᠪᠦᠷᠢᠳᠬᠡᠭᠦᠯᠬᠦ"
                                .style (m/TextStyle .fontSize 32.0 .fontWeight m.FontWeight/bold .color tokens/text-primary .fontFamily "OyunQaganTig"))])
              
              (m/SizedBox .width 48.0)

              ;; Form Fields
              (form-field "Нэвтрэх нэр" handle-ctrl false m.TextInputType/text)
              (form-field "Харагдах нэр" nickname-ctrl false m.TextInputType/text)
              (form-field "И-мэйл" email-ctrl false m.TextInputType/emailAddress)
              (form-field "Нууц үг" password-ctrl true m.TextInputType/text)
              
              (m/SizedBox .width 16.0)

              ;; Register Button (🌟 FIX: 彻底去除了外部 SizedBox，靠内部 padding 自动撑开)
              (mgl/MongolElevatedButton
               .style (m/ElevatedButton.styleFrom
                       .backgroundColor tokens/primary-color
                       .foregroundColor m.Colors/white
                       .elevation 0.0
                       .padding (m/EdgeInsets.symmetric .vertical 48.0 .horizontal 20.0)
                       .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.circular 16.0)))
               .onPressed (if loading? nil do-register!)
               .child (if loading?
                        (m/SizedBox .width 24.0 .height 24.0 .child (m/CircularProgressIndicator .color m.Colors/white .strokeWidth 2.0))
                        (mgl/MongolText "Бүртгүүлэх" .style (m/TextStyle .fontSize 16.0 .fontWeight m.FontWeight/bold .fontFamily "OyunQaganTig"))))])))))))))))