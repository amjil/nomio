(ns nomio.screens.feed
  "Home feed updated with Tenger Blue aesthetics.
   Horizontal scrolling cards optimized for vertical script.
   Integrates auth interception, pagination, and direct Highlights access.
   Uses content-driven sizing for natural card widths."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   [cljd.flutter :as f]
   [nomio.core.api :as api]
   [nomio.core.state :as state]
   [nomio.utils.responsive :as responsive]
   [nomio.utils.tokens :as tokens]
   [nomio.widgets.review-banner :as review-banner]
   [nomio.widgets.post-card :as post-card]))

;; =============================================================================
;; Main Feed Screen
;; =============================================================================

(defn feed-screen []
  (let [!posts (atom [])
        !page (atom 1)
        !has-more? (atom true)
        !loading? (atom false)
        page-limit 10

        load-posts!
        (fn [is-refresh?]
          (when is-refresh? 
            (reset! !page 1) 
            (reset! !has-more? true))
          
          (when (and (not @!loading?) @!has-more?)
            (reset! !loading? true)
            (-> (api/fetch-posts :page @!page :limit page-limit)
                (.then (fn [res]
                         (let [items (cond
                                       (dart/is? res dc/Iterable) (vec res)
                                       (and (map? res) (dart/is? (:data res) dc/Iterable)) (vec (:data res))
                                       (and (map? res) (dart/is? (get res "data") dc/Iterable)) (vec (get res "data"))
                                       :else [])]
                           (if is-refresh? (reset! !posts items) (swap! !posts concat items))
                           (if (< (count items) page-limit) (reset! !has-more? false) (swap! !page inc))
                           (reset! !loading? false))))
                (.catchError (fn [e] 
                               (reset! !loading? false) 
                               (reset! !has-more? false)
                               (dc/print (str "Feed error: " e)))))))]

    (load-posts! true)

    (f/widget
     :context ctx
     :managed [scroll-ctrl (let [ctrl (m/ScrollController.)]
                             (.addListener ctrl #(when (and (.-hasClients ctrl) (not @!loading?) @!has-more?)
                                                   (when (>= (.-pixels (.-position ctrl)) (- (.-maxScrollExtent (.-position ctrl)) 200))
                                                     (load-posts! false))))
                             ctrl)]
     :watch [app-state state/!app-state 
             posts !posts 
             loading? !loading? 
             has-more? !has-more?]
     
     :let [logged-in? (some? (:current-user app-state))
           posts-count (count posts)
           
           handle-auth-action!
           (fn [target-route success-callback]
             (if-not logged-in?
               (m/Navigator.pushNamed ctx "/login")
               (if success-callback
                 (success-callback)
                 (m/Navigator.pushNamed ctx target-route)))
             nil)

           feed-list-view
           (cond
             (and (zero? posts-count) loading?) 
             (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color))
             
             (zero? posts-count) 
             (m/Center .child (mgl/MongolText "Одоогоор нийтлэл алга байна" .style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-secondary)))
             
             :else
             (m/ListView.builder
              .controller scroll-ctrl
              .scrollDirection m.Axis/horizontal
              .physics (m/BouncingScrollPhysics.)
              .padding (m/EdgeInsets.only .left 16.0 .top 16.0 .bottom 16.0)
              .itemCount (+ posts-count (if has-more? 1 0) 1)
              .itemBuilder
              (fn [_ i]
                (cond
                  (zero? i) 
                  (review-banner/review-banner)
                  
                  (<= i posts-count) 
                  (let [post (nth posts (dec i))
                        post-id (or (get post "id") (get post :id))]
                    (m/Padding
                     .padding (m/EdgeInsets.only .top 24.0 .right 20.0)
                     .child
                     ;; 🌟 FIX: 去掉了 m/SizedBox 和 .width 180.0，让卡片宽度由内容自然撑开！
                     (post-card/post-card 
                      {:post post
                       :on-tap #(m/Navigator.pushNamed ctx "/post" .arguments {:id post-id})})))
                  
                  :else 
                  (m/Container .width 100.0 .child (m/Center .child (m/CircularProgressIndicator .strokeWidth 2.0 .color tokens/primary-color)))))))]

     (responsive/layout
      {:mobile
       (m/Scaffold
        .backgroundColor tokens/bg-color
        .appBar (m/AppBar
                 .elevation 0.0
                 .backgroundColor m.Colors/transparent
                 .title (m/Text "Nomio" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold .color tokens/text-primary))
                 .centerTitle false
                 .actions [(m/IconButton .icon (m/Icon m.Icons/search .color tokens/primary-color) .tooltip "Хайх" .onPressed (fn [] (m/Navigator.pushNamed ctx "/explore") nil))
                           (m/IconButton .icon (m/Icon m.Icons/format_quote .color tokens/primary-color) .tooltip "Миний эшлэл" .onPressed #(handle-auth-action! "/profile" (fn [] (m/Navigator.pushNamed ctx "/profile" .arguments {:tab 2}))))
                           (m/IconButton .icon (m/Icon m.Icons/refresh .color tokens/primary-color) .onPressed #(load-posts! true))
                           (m/IconButton .icon (m/Icon (if logged-in? m.Icons/account_circle m.Icons/login) .color tokens/primary-color) .onPressed #(handle-auth-action! "/profile" nil))])
        
        .floatingActionButton (m/FloatingActionButton
                               .backgroundColor tokens/primary-color
                               .foregroundColor m.Colors/white
                               .elevation 4.0
                               .onPressed #(handle-auth-action! "/create" (fn [] (-> (m/Navigator.pushNamed ctx "/create") (.then (fn [_] (load-posts! true))))))
                               .child (m/Icon m.Icons/add .color m.Colors/white))
        .body (m/SafeArea .child feed-list-view))

       :desktop
       (m/Scaffold
        .backgroundColor tokens/bg-color
        .appBar (m/AppBar
                 .elevation 0.0
                 .backgroundColor m.Colors/transparent
                 .title (m/Text "Nomio" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m.FontWeight/bold .color tokens/text-primary))
                 .actions [(m/IconButton .icon (m/Icon m.Icons/search .color tokens/primary-color) .tooltip "Хайх" .onPressed (fn [] (m/Navigator.pushNamed ctx "/explore") nil))
                           (m/IconButton .icon (m/Icon m.Icons/format_quote .color tokens/primary-color) .tooltip "Миний эшлэл" .onPressed #(handle-auth-action! "/profile" (fn [] (m/Navigator.pushNamed ctx "/profile" .arguments {:tab 2}))))
                           (m/IconButton .icon (m/Icon m.Icons/refresh .color tokens/primary-color) .onPressed #(load-posts! true))
                           (m/IconButton .icon (m/Icon m.Icons/edit .color tokens/primary-color) .onPressed #(handle-auth-action! "/create" (fn [] (-> (m/Navigator.pushNamed ctx "/create") (.then (fn [_] (load-posts! true)))))))
                           (m/IconButton .icon (m/Icon (if logged-in? m.Icons/account_circle m.Icons/login) .color tokens/primary-color) .onPressed #(handle-auth-action! "/profile" nil))
                           (m/SizedBox .width 16.0)])
        .body (m/SafeArea .child feed-list-view))}))))