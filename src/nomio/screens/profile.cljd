(ns nomio.screens.profile
  "User profile hub for posts, bookmarks, and PKM highlights.
   Completely redesigned for Native Traditional Mongolian script: Left-to-Right horizontal flow."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   [cljd.flutter :as f]
   [nomio.core.api :as api]
   [nomio.core.state :as state]
   [nomio.utils.tokens :as tokens]
   [nomio.widgets.post-card :as post-card]
   [components.toast :as toast]))

;; =============================================================================
;; Highlight Detail Modal
;; =============================================================================

(defn- show-highlight-detail! 
  "A dedicated horizontal reading canvas to view full-length truncated highlights and notes."
  [ctx item]
  (let [content (get item "content" "")
        note (get item "note" "")
        source-ref (get item "source_ref")
        created-at (get item "inserted_at" "Саяхан")
        display-date (if (>= (count created-at) 10) (subs created-at 0 10) created-at)]
    (m/showModalBottomSheet
     .context ctx
     .isScrollControlled true
     .backgroundColor m.Colors/transparent
     .builder
     (fn [b-ctx]
       (m/Container
        .padding (m/EdgeInsets.only .left 24.0 .right 24.0 .top 24.0 .bottom (+ 24.0 (.-bottom (m/MediaQuery.paddingOf b-ctx))))
        .decoration (m/BoxDecoration 
                     .color tokens/bg-color
                     .borderRadius (m/BorderRadius.vertical .top (m/Radius.circular 24.0)))
        .child
        (m/SizedBox
         .height 400.0
         .child
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/start
          .children
          [;; =========================================================
           ;; 1. Header & Actions (Far Left)
           ;; =========================================================
           (m/Column
            .mainAxisAlignment m.MainAxisAlignment/spaceBetween
            .crossAxisAlignment m.CrossAxisAlignment/center
            .children
            [(m/IconButton 
              .icon (m/Icon m.Icons/close .color tokens/text-secondary)
              .onPressed #(m/Navigator.pop b-ctx))
             
             ;; Optional action: explicitly jump to the original post
             (if source-ref
               (m/Column
                .mainAxisSize m.MainAxisSize/min
                .children
                [(m/IconButton
                  .icon (m/Icon m.Icons/open_in_new .color tokens/primary-color)
                  .tooltip "Эх сурвалж руу очих"
                  .onPressed (fn []
                               (m/Navigator.pop b-ctx)
                               (m/Navigator.pushNamed ctx "/post" .arguments {:id source-ref})
                               nil))
                 (m/SizedBox .height 8.0)
                 (mgl/MongolText "Эх сурвалж" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 12.0 .color tokens/primary-color .fontWeight m.FontWeight/bold))])
               (m/SizedBox.shrink))
             
             (m/Expanded
              .child
              (m/Padding
               .padding (m/EdgeInsets.symmetric .vertical 16.0)
               .child
               (mgl/MongolText "Эшлэлийн дэлгэрэнгүй"
                               .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0 .fontWeight m.FontWeight/bold .color tokens/text-primary))))])
           
           (m/SizedBox .width 24.0)
           (m/VerticalDivider .color (.withOpacity tokens/text-secondary 0.2))
           (m/SizedBox .width 24.0)

           ;; =========================================================
           ;; 2. Content (Middle) - Allows infinite horizontal scroll
           ;; =========================================================
           (m/Expanded
            .flex 3
            .child
            (m/SingleChildScrollView
             .scrollDirection m.Axis/horizontal
             .physics (m/BouncingScrollPhysics.)
             .child
             (mgl/MongolText content
                             .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0 .color tokens/text-primary .height 1.6))))
           
           ;; =========================================================
           ;; 3. Note (Right, if present)
           ;; =========================================================
           (if (not (empty? note))
             (m/Expanded
              .flex 2
              .child
              (m/Container
               .margin (m/EdgeInsets.only .left 24.0)
               .padding (m/EdgeInsets.all 24.0)
               .decoration (m/BoxDecoration 
                            .color tokens/primary-container 
                            .borderRadius (m/BorderRadius.circular 16.0))
               .child
               (m/SingleChildScrollView
                .scrollDirection m.Axis/horizontal
                .physics (m/BouncingScrollPhysics.)
                .child
                (m/Row
                 .crossAxisAlignment m.CrossAxisAlignment/start
                 .children
                 [(m/Icon m.Icons/lightbulb_outline .color tokens/primary-color .size 20.0)
                  (m/SizedBox .width 16.0)
                  (mgl/MongolText note
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color tokens/primary-color .height 1.6))]))))
             (m/SizedBox.shrink))])))))))

;; =============================================================================
;; Highlight Card Component (Exclusive to Profile)
;; =============================================================================

(defn- highlight-card 
  "Read-only highlight card for the profile screen.
   Uses a Left-to-Right Row layout: Icon/Date -> Content -> Note.
   Dynamically sizes to content without fixed widths."
  [ctx item]
  (let [content (get item "content" "")
        note (get item "note" "")
        source-ref (get item "source_ref")
        created-at (get item "inserted_at" "Саяхан")
        display-date (if (>= (count created-at) 10) (subs created-at 0 10) created-at)
        has-note? (not (empty? note))]
    (m/Container
     .margin (m/EdgeInsets.only .right 20.0 .bottom 24.0 .top 12.0)
     .decoration (m/BoxDecoration
                  .color tokens/surface-color
                  .borderRadius (m/BorderRadius.circular 20.0)
                  .boxShadow tokens/tenger-shadow
                  .border (m/Border.all .color (.withOpacity tokens/primary-color 0.1) .width 1.0))
     .child
     (m/Material
      .color m.Colors/transparent
      .child
      (m/InkWell
       .borderRadius (m/BorderRadius.circular 20.0)
       .onTap (fn []
                (show-highlight-detail! ctx item)
                nil)
       .child
       (m/Padding
        .padding (m/EdgeInsets.all 24.0)
        .child
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/start
         .mainAxisSize m.MainAxisSize/min
         .children
         [;; 1. Metadata (Far Left)
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(m/Container
             .padding (m/EdgeInsets.all 8.0)
             .decoration (m/BoxDecoration .color tokens/primary-container .shape m.BoxShape/circle)
             .child (m/Icon m.Icons/format_quote .color tokens/primary-color .size 16.0))
            (m/SizedBox .height 16.0)
            (mgl/MongolText display-date
                            .style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-secondary .fontSize 12.0))])

          (m/SizedBox .width 24.0)

          ;; 2. Highlight Content (Middle)
          (mgl/MongolText content
                          .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color tokens/text-primary .fontWeight m.FontWeight/bold .height 1.4)
                          .maxLines 10
                          .overflow m.TextOverflow/ellipsis)

          ;; 3. Note Area (Right, if present)
          (if has-note?
            (m/Container
             .margin (m/EdgeInsets.only .left 24.0)
             .padding (m/EdgeInsets.all 16.0)
             .decoration (m/BoxDecoration
                          .color tokens/bg-color
                          .borderRadius (m/BorderRadius.circular 12.0)
                          .border (m/Border.all .color (.withOpacity tokens/text-secondary 0.1)))
             .child
             (m/Row
              .crossAxisAlignment m.CrossAxisAlignment/start
              .mainAxisSize m.MainAxisSize/min
              .children
              [(m/Icon m.Icons/edit_note .size 16.0 .color tokens/text-secondary)
               (m/SizedBox .width 12.0)
               (mgl/MongolText note
                               .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .color tokens/text-secondary)
                               .maxLines 8
                               .overflow m.TextOverflow/ellipsis)]))
            (m/SizedBox.shrink))])))))))

;; =============================================================================
;; Profile Screen
;; =============================================================================

(defn profile-screen 
  [& [args]]
  (let [target-user-id (or (:id args) (state/current-user-id))
        current-uid (state/current-user-id)
        should-redirect? (and (nil? (:id args)) (nil? current-uid))
        is-me? (and current-uid (= target-user-id current-uid))]
    
    (if should-redirect?
      (f/widget
       :context ctx
       (do
         (-> m/WidgetsBinding .-instance
             (.addPostFrameCallback (fn [_] (m/Navigator.pushNamed ctx "/login") nil)))
         (m/SizedBox.shrink)))

      (let [!user-info (atom nil)
            !items (atom [])
            !loading? (atom true)
            !active-tab (atom (or (:tab args) 0))
            
            load-data! 
            (fn [tab-idx & [current-ctx]]
              (reset! !loading? true)
              (reset! !items [])
              (let [fetch-promise (case tab-idx
                                    0 (api/fetch-user-posts target-user-id)
                                    1 (api/fetch-user-bookmarks target-user-id)
                                    2 (api/fetch-highlights :limit 50)
                                    (api/fetch-user-posts target-user-id))]
                (-> fetch-promise
                    (.then (fn [res]
                             (let [data-list (cond
                                               (dart/is? res dc/Iterable) (vec res)
                                               (and (map? res) (dart/is? (:data res) dc/Iterable)) (vec (:data res))
                                               (and (map? res) (dart/is? (get res "data") dc/Iterable)) (vec (get res "data"))
                                               :else [])]
                               (reset! !items data-list)
                               (reset! !loading? false))))
                    (.catchError (fn [e]
                                   (reset! !loading? false)
                                   (if current-ctx
                                     (toast/error current-ctx "Мэдээлэл татахад алдаа гарлаа")
                                     (dc/print (str "Profile load error: " e))))))))]
        
        (when target-user-id
          (-> (api/fetch-user-posts target-user-id)
              (.then (fn [_] 
                       (if is-me?
                         (-> (api/fetch-me) (.then #(reset! !user-info %)))
                         (reset! !user-info {"id" target-user-id "username" "user" "nickname" "Nomio Хэрэглэгч"}))))
              (.catchError #(dc/print "Profile fetch error"))))
        
        (load-data! @!active-tab nil)

        (f/widget
         :context ctx
         :watch [user-info !user-info
                 items !items
                 loading? !loading?
                 active-tab !active-tab]
         
         (m/Scaffold
          .backgroundColor tokens/bg-color
          .appBar (m/AppBar
                   .elevation 0.0
                   .backgroundColor m.Colors/transparent
                   .leading (m/IconButton .icon (m/Icon m.Icons/arrow_back .color tokens/primary-color) .onPressed #(m/Navigator.pop ctx))
                   .actions (if is-me?
                              [(m/IconButton 
                                .icon (m/Icon m.Icons/logout .color tokens/srs-again) 
                                .tooltip "Гарах"
                                .onPressed (fn [] 
                                             (state/logout!)
                                             (m/Navigator.pushNamedAndRemoveUntil ctx "/" (fn [_] false))
                                             nil))
                               (m/SizedBox .width 16.0)]
                              []))
          
          .body
          (m/SafeArea
           .child
           (m/Row
            .crossAxisAlignment m.CrossAxisAlignment/start
            .children
            [;; =========================================================
             ;; Profile Header Block (Left Side)
             ;; =========================================================
             (m/Container
              .padding (m/EdgeInsets.only .left 32.0 .right 32.0 .top 32.0 .bottom 32.0)
              .decoration (m/BoxDecoration 
                           .color tokens/surface-color
                           .border (m/Border .right (m/BorderSide .color (.withOpacity tokens/primary-color 0.1) .width 1.0)))
              .child
              (m/Row
               .mainAxisSize m.MainAxisSize/min
               .crossAxisAlignment m.CrossAxisAlignment/start
               .children
               [;; Column 1: Identity (Avatar, Name, Username)
                (m/Column
                 .mainAxisSize m.MainAxisSize/min
                 .crossAxisAlignment m.CrossAxisAlignment/center
                 .children
                 [(m/Container
                   .width 80.0 .height 80.0
                   .decoration (m/BoxDecoration .color tokens/primary-container .shape m.BoxShape/circle)
                   .child (m/Icon m.Icons/person .size 40.0 .color tokens/primary-color))
                  
                  (m/SizedBox .height 24.0)
                  
                  (mgl/MongolText (or (get user-info "nickname") (get user-info "name") "Уншигч") 
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 24.0 .fontWeight m.FontWeight/bold .color tokens/text-primary))
                  (m/SizedBox .height 12.0)
                  (mgl/MongolText (str "@" (or (get user-info "username") "user"))
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .color tokens/text-secondary))])
                
                (m/SizedBox .width 32.0)
                (m/VerticalDivider .color (.withOpacity tokens/text-secondary 0.2) .width 1.0)
                (m/SizedBox .width 32.0)
                
                ;; Column 2 (Actually a Row): Tab Buttons
                (m/Column
                 .crossAxisAlignment m.CrossAxisAlignment/start
                 .children
                 [;; Tab 1: Posts
                  (m/InkWell
                   .onTap (fn [] (reset! !active-tab 0) (load-data! 0 ctx) nil)
                   .borderRadius (m/BorderRadius.circular 16.0)
                   .child
                   (m/Container
                    .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 16.0)
                    .decoration (m/BoxDecoration .color (if (= active-tab 0) tokens/primary-container m.Colors/transparent) .borderRadius (m/BorderRadius.circular 16.0))
                    .child (mgl/MongolText "Нийтлэл" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color (if (= active-tab 0) tokens/primary-color tokens/text-secondary) .fontWeight (if (= active-tab 0) m.FontWeight/bold m.FontWeight/normal)))))
                  
                  (m/SizedBox .height 16.0)
                  
                  ;; Tab 2: Saved
                  (m/InkWell
                   .onTap (fn [] (reset! !active-tab 1) (load-data! 1 ctx) nil)
                   .borderRadius (m/BorderRadius.circular 16.0)
                   .child
                   (m/Container
                    .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 16.0)
                    .decoration (m/BoxDecoration .color (if (= active-tab 1) tokens/primary-container m.Colors/transparent) .borderRadius (m/BorderRadius.circular 16.0))
                    .child (mgl/MongolText "Хадгалсан" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color (if (= active-tab 1) tokens/primary-color tokens/text-secondary) .fontWeight (if (= active-tab 1) m.FontWeight/bold m.FontWeight/normal)))))
                  
                  ;; Tab 3: Highlights (Only if viewing own profile)
                  (if is-me?
                    (m/Column
                     .children
                     [(m/SizedBox .height 16.0)
                      (m/InkWell
                       .onTap (fn [] (reset! !active-tab 2) (load-data! 2 ctx) nil)
                       .borderRadius (m/BorderRadius.circular 16.0)
                       .child
                       (m/Container
                        .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 16.0)
                        .decoration (m/BoxDecoration .color (if (= active-tab 2) tokens/primary-container m.Colors/transparent) .borderRadius (m/BorderRadius.circular 16.0))
                        .child (mgl/MongolText "Эшлэл" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color (if (= active-tab 2) tokens/primary-color tokens/text-secondary) .fontWeight (if (= active-tab 2) m.FontWeight/bold m.FontWeight/normal)))))])
                    (m/SizedBox.shrink))])]))
             
             ;; =========================================================
             ;; Content Feed (Right Side)
             ;; =========================================================
             (m/Expanded
              .child
              (if loading?
                (m/Center .child (m/CircularProgressIndicator .color tokens/primary-color))
                (if (empty? items)
                  (m/Center .child (mgl/MongolText "Одоогоор мэдээлэл алга байна" .style (m/TextStyle .fontFamily "OyunQaganTig" .color tokens/text-secondary)))
                  (m/ListView.builder
                   .scrollDirection m.Axis/horizontal
                   .physics (m/BouncingScrollPhysics.)
                   .padding (m/EdgeInsets.only .left 32.0 .top 24.0 .bottom 24.0 .right 32.0)
                   .itemCount (count items)
                   .itemBuilder
                   (fn [_ i]
                     (let [item (nth items i)]
                       (if (= active-tab 2)
                         (highlight-card ctx item)
                         (let [post-id (or (get item "id") (get item :id))]
                           ;; 🌟 FIX: Removed m/SizedBox .width 180.0, added Padding for gap!
                           (m/Padding
                            .padding (m/EdgeInsets.only .right 24.0)
                            .child 
                            (post-card/post-card 
                             {:post item
                              :on-tap #(m/Navigator.pushNamed ctx "/post" .arguments {:id post-id})}))))))))))]))))))))